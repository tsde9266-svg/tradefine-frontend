{
  "expo": {
    "name": "TradeFind",
    "slug": "tradefind",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/app_icon_app_icon_for_tradefi.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "tradefind",
    "splash": {
      "image": "./assets/icons/app_icon_app_icon_for_tradefi.png",
      "resizeMode": "contain",
      "backgroundColor": "#F97316"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tradefind.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "TradeFind uses your location to show nearby tradespeople.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "TradeFind uses your background location to share your availability with customers."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/app_icon_app_icon_for_tradefi.png",
        "backgroundColor": "#F97316"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.tradefind.app",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCwN9QR6XSw98Ko0uYmds0WVA0TrA5UW00"
        }
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/icons/app_icon_app_icon_for_tradefi.png"
    },
    "plugins": [
      "expo-router",
      "expo-image-picker",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/icons/app_icon_app_icon_for_tradefi.png",
          "color": "#F97316",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "TradeFind uses your location to show nearby tradespeople.",
          "locationWhenInUsePermission": "TradeFind uses your location to show nearby tradespeople.",
          "locationAlwaysPermission": "TradeFind uses your background location to share your availability with customers."
        }
      ],
      "expo-secure-store",
      "expo-web-browser"
    ],
    "extra": {
      "apiUrl": "http://178.104.119.210:3001",
      "socketUrl": "ws://178.104.119.210:4000",
      "r2PublicUrl": "",
      "router": {},
      "eas": {
        "projectId": "0f5a69b9-2f0e-4172-a389-07dbf805a008"
      }
    },
    "owner": "taqi-vorvex"
  }
}
