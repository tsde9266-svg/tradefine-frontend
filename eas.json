{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_ENV": "development",
        "EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID": "1041618545321-8t6a4gvvhtke96bjkc8pu6gs7nt4mgj8.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "1041618545321-8549s0ur0sbp1mc1r19avabjho11q00j.apps.googleusercontent.com"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_ENV": "preview",
        "EXPO_PUBLIC_API_URL": "http://178.104.119.210:3001",
        "EXPO_PUBLIC_SOCKET_URL": "ws://178.104.119.210:4000",
        "EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID": "1041618545321-8t6a4gvvhtke96bjkc8pu6gs7nt4mgj8.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "1041618545321-8549s0ur0sbp1mc1r19avabjho11q00j.apps.googleusercontent.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "APP_ENV": "production",
        "EXPO_PUBLIC_API_URL": "http://178.104.119.210:3001",
        "EXPO_PUBLIC_SOCKET_URL": "ws://178.104.119.210:4000",
        "EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID": "1041618545321-8t6a4gvvhtke96bjkc8pu6gs7nt4mgj8.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "1041618545321-8549s0ur0sbp1mc1r19avabjho11q00j.apps.googleusercontent.com"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "YOUR_APPLE_ID",
        "ascAppId": "YOUR_APP_STORE_CONNECT_APP_ID",
        "appleTeamId": "YOUR_APPLE_TEAM_ID"
