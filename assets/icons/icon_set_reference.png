<!DOCTYPE html>

<html lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>TradeFind Icon Set Reference</title>
<!-- Tailwind CSS v3 with plugins -->
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<style data-purpose="typography">
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap');
    body {
      font-family: 'Inter', sans-serif;
    }
  </style>
<style data-purpose="layout">
    .icon-grid-container {
      max-width: 1200px;
      margin: 0 auto;
    }
    /* Fixed sizing for icon display to ensure consistency */
    .icon-preview-box {
      width: 48px;
      height: 48px;
    }
  </style>
</head>
<body class="bg-white text-slate-800 p-8">
<!-- BEGIN: MainHeader -->
<header class="text-center mb-12" data-purpose="page-header">
<h1 class="text-4xl font-bold text-slate-900 mb-2">TradeFind Icon Set</h1>
<p class="text-lg text-slate-500">Official UI Reference Sheet • 24x24px Grid System</p>
<div class="mt-4 flex justify-center gap-6">
<div class="flex items-center gap-2">
<div class="w-4 h-4 bg-[#F97316] rounded"></div>
<span class="text-sm font-medium">Primary: #F97316</span>
</div>
<div class="flex items-center gap-2">
<div class="w-4 h-4 bg-[#6B7280] rounded"></div>
<span class="text-sm font-medium">Secondary: #6B7280</span>
</div>
</div>
</header>
<!-- END: MainHeader -->
<!-- BEGIN: IconReferenceGrid -->
<main class="icon-grid-container" data-purpose="main-content">
