<!DOCTYPE html>

<html lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>TradeFind Status Badges Reference</title>
<!-- BEGIN: Tailwind CSS CDN -->
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<!-- END: Tailwind CSS CDN -->
<style data-purpose="custom-styling">
    /* Specific colors requested that might fall outside default Tailwind shades or require exact hex precision */
    .bg-status-available { background-color: #22C55E; }
    .bg-status-unavailable { background-color: #9CA3AF; }
    .bg-status-pending { background-color: #FBBF24; }
    .bg-status-verified { background-color: #F97316; }
    
    /* Ensure maximum rounding for the pill shape */
    .pill-rounded { border-radius: 999px; }
  </style>
</head>
<body class="bg-white min-h-screen flex items-center justify-center p-4">
<!-- BEGIN: Badge Reference Container -->
<main class="w-full max-w-md space-y-8" data-purpose="status-badge-reference-sheet">
<header class="text-center mb-10">
<h1 class="text-2xl font-bold text-slate-800">TradeFind Status Badges</h1>
<p class="text-slate-500 text-sm mt-2">UI Reference Sheet for Mobile iOS</p>
</header>
<div class="flex flex-col gap-6 items-center">
<!-- BEGIN: Available Now Badge -->
<section class="flex flex-col items-center gap-2" data-purpose="badge-container">
<span class="pill-rounded bg-status-available text-white px-6 py-2 text-sm font-semibold shadow-sm">
          Available Now
        </span>
<span class="text-[10px] uppercase tracking-wider text-slate-400 font-bold">Available Now</span>
</section>
<!-- END: Available Now Badge -->
<!-- BEGIN: Not Available Badge -->
<section class="flex flex-col items-center gap-2" data-purpose="badge-container">
<span class="pill-rounded bg-status-unavailable text-white px-6 py-2 text-sm font-semibold shadow-sm">
          Not Available
        </span>
<span class="text-[10px] uppercase tracking-wider text-slate-400 font-bold">Not Available</span>
</section>
<!-- END: Not Available Badge -->
<!-- BEGIN: Pending Approval Badge -->
<section class="flex flex-col items-center gap-2" data-purpose="badge-container">
<span class="pill-rounded bg-status-pending text-black px-6 py-2 text-sm font-semibold shadow-sm">
          Pending Approval
        </span>
<span class="text-[10px] uppercase tracking-wider text-slate-400 font-bold">Pending Approval</span>
</section>
<!-- END: Pending Approval Badge -->
<!-- BEGIN: Verified Badge -->
<section class="flex flex-col items-center gap-2" data-purpose="badge-container">
<div class="pill-rounded bg-status-verified text-white px-6 py-2 text-sm font-semibold shadow-sm flex items-center gap-2">
<!-- Verification Tick Icon -->
<svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="3" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
<path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>
          Verified
        </div>
<span class="text-[10px] uppercase tracking-wider text-slate-400 font-bold">Verified</span>
</section>
<!-- END: Verified Badge -->
<!-- BEGIN: Top Rated Badge -->
<section class="flex flex-col items-center gap-2" data-purpose="badge-container">
<div class="pill-rounded bg-white border border-yellow-400 text-slate-800 px-6 py-2 text-sm font-bold shadow-sm flex items-center gap-2">
<!-- Gold Star Icon -->
<svg class="h-4 w-4 text-yellow-500 fill-current" viewbox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
<path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
</svg>
          Top Rated
        </div>
<span class="text-[10px] uppercase tracking-wider text-slate-400 font-bold">Top Rated</span>
</section>
<!-- END: Top Rated Badge -->
</div>
<!-- BEGIN: Reference Icon Set (From Context) -->
<section class="mt-16 pt-8 border-t border-slate-100 flex flex-col items-center" data-purpose="icon-context-preview">
<p class="text-xs text-slate-400 mb-4 font-medium italic">Icon Style Context Reference</p>
<img alt="TradeFind Icon Style Reference" class="w-32 h-32 object-contain opacity-50 grayscale hover:grayscale-0 transition-all duration-300" src="https://lh3.googleusercontent.com/aida/ADBb0uhoUgKOtCLODDfNfsooY41ySurKHGDagiiU_jcR87OKYOFQIvcLb0sUa6g36cyekCz1phqn3BWdout38HPAtrZbnER_lQPvwrVPpkhpmU_ZVnF64onuchmicwDlZDD4MUg1K94-VW077hH4Bn5OwvKVWIWDdgWvpbc-GsCEmVY_8cACjOsnmX-Pmh2nNPPbPNMywoTbBqhKFwCBcdOlEiGK8EySugti4N0-FwOwccoCKBvgJU0xm0t9nqw"/>
</section>
<!-- END: Reference Icon Set -->
</main>
<!-- END: Badge Reference Container -->
</body></html>