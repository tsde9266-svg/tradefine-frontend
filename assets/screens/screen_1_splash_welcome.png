<!DOCTYPE html>

<html lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>TradeFind - Welcome</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "surface-bright": "#f9f9ff",
                        "surface": "#f9f9ff",
                        "on-secondary": "#ffffff",
                        "on-tertiary-fixed-variant": "#5c4300",
                        "on-secondary-container": "#5d1900",
                        "on-background": "#141b2b",
                        "on-primary-fixed-variant": "#783200",
                        "tertiary-container": "#c49200",
                        "on-error": "#ffffff",
                        "background": "#f9f9ff",
                        "surface-container": "#e9edff",
                        "on-tertiary-fixed": "#261a00",
                        "on-surface-variant": "#584237",
                        "primary-fixed-dim": "#ffb690",
                        "secondary": "#ac3400",
                        "secondary-fixed-dim": "#ffb59d",
                        "surface-container-highest": "#dce2f7",
                        "on-error-container": "#93000a",
                        "on-tertiary-container": "#422f00",
                        "surface-tint": "#9d4300",
                        "on-primary-container": "#582200",
                        "outline-variant": "#e0c0b1",
                        "secondary-fixed": "#ffdbd0",
                        "primary-container": "#f97316",
                        "surface-container-low": "#f1f3ff",
                        "primary-fixed": "#ffdbca",
                        "on-secondary-fixed": "#390c00",
                        "tertiary-fixed": "#ffdf9f",
                        "inverse-on-surface": "#edf0ff",
                        "on-surface": "#141b2b",
                        "outline": "#8c7164",
                        "on-secondary-fixed-variant": "#832600",
                        "surface-container-lowest": "#ffffff",
                        "surface-variant": "#dce2f7",
                        "primary": "#9d4300",
                        "surface-container-high": "#e1e8fd",
                        "on-tertiary": "#ffffff",
                        "secondary-container": "#fd6b36",
                        "tertiary": "#795900",
                        "error-container": "#ffdad6",
                        "on-primary-fixed": "#341100",
                        "tertiary-fixed-dim": "#f9bd22",
                        "error": "#ba1a1a",
                        "inverse-primary": "#ffb690",
                        "on-primary": "#ffffff",
                        "surface-dim": "#d3daef",
                        "inverse-surface": "#293040"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    "spacing": {
                        "sm": "12px",
                        "gutter": "12px",
                        "lg": "24px",
                        "xs": "8px",
                        "md": "16px",
                        "base": "4px",
                        "xl": "32px",
                        "margin": "16px"
                    },
                    "fontFamily": {
                        "h2": ["Inter"],
                        "label-md": ["Inter"],
                        "body-md": ["Inter"],
                        "h1": ["Inter"],
                        "h3": ["Inter"],
                        "body-lg": ["Inter"]
                    },
                    "fontSize": {
                        "h2": ["24px", {"lineHeight": "30px", "letterSpacing": "-0.01em", "fontWeight": "700"}],
                        "label-md": ["12px", {"lineHeight": "16px", "letterSpacing": "0.02em", "fontWeight": "500"}],
                        "body-md": ["14px", {"lineHeight": "20px", "fontWeight": "400"}],
                        "h1": ["28px", {"lineHeight": "34px", "letterSpacing": "-0.02em", "fontWeight": "700"}],
                        "h3": ["20px", {"lineHeight": "26px", "letterSpacing": "0em", "fontWeight": "700"}],
                        "body-lg": ["16px", {"lineHeight": "24px", "fontWeight": "400"}]
                    }
                },
            },
        }
    </script>
<style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        .bg-splash-overlay {
            background: linear-gradient(to bottom, rgba(249, 250, 251, 0.7) 0%, rgba(249, 250, 251, 0.95) 100%);
        }
    </style>
<style>
    body {
      min-height: max(884px, 100dvh);
    }
  </style>
  </head>
<body class="bg-surface-bright font-body-md text-on-surface antialiased overflow-hidden">
<!-- Suppression of Nav Shell as per Task Intent (Splash/Onboarding) -->
<main class="relative h-screen w-full flex flex-col justify-between overflow-hidden">
<!-- Background Illustration / Image -->
<div class="absolute inset-0 z-0">
<img alt="Professional construction site" class="w-full h-full object-cover" data-alt="Cinematic wide shot of a modern construction site at dawn with soft golden light hitting structural steel and architectural blueprints" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCTpTg_ppVatM-YHdxnmeoxndE8mzGXSd_zhkHX4gRmWjJ0D8tkHEYxkh1e9F7VHqKUhuSZghK6w9SWgtzqnJ5zBwso4-P9spQJZU71c_Q6UkFM68qV4WiI5ybohrY06J6ns9uDxE3aTwthG-flfl5DKeoUm0v4JdsxmzQX3LHJ5VCrjyM05bseR81rIMpvRUkyoZ4wGhtXleiiQyNaK_JnAp6wkBKEhHdacTtSF-Dd5oj8vrVY3k3ekvFaxcV2iyDDUhLv5ZJoCPc"/>
<div class="absolute inset-0 bg-splash-overlay"></div>
</div>
<!-- Content Canvas -->
<div class="relative z-10 flex flex-col items-center justify-center h-full px-margin text-center">
<!-- Branding Section -->
<div class="flex flex-col items-center gap-md mb-xl">
<!-- App Logo -->
<div class="w-24 h-24 bg-surface-container-lowest rounded-xl shadow-[0_4px_12px_rgba(0,0,0,0.1)] flex items-center justify-center p-4">
<img alt="TradeFind Logo" class="w-full h-full object-contain" data-alt="Abstract minimalist logo with stylized orange tools forming a chevron shape, professional corporate aesthetic" src="https://lh3.googleusercontent.com/aida-public/AB6AXuD_xBWizYSugndFs65zpi_e6cPowx9CbcNU-ZwKAotF2g-lJ-2s3JtE6sjIgjdlRa630p4mFNQwRgfkjIfLjOxMTrX_iT6S-txAennW14_R9Vye6GeXS00mpEzfOZsGkFvlvHEMCphRLrvKXaiSuDCiaSgnWnSBlirDEiBU-q7beX5bxv7XfteEBJs0Cz84rXJlqMbJ6NTeplIQhN6N1ebVoo5L3yjUV1ZGvw3az5uU3ryTGfhaWmAI4AfqFZTOMdBLp1lnupjJFQk"/>
</div>
<!-- Wordmark - Applying JSON style_brand_logo hierarchy -->
<h1 class="text-2xl font-black text-orange-600 tracking-tight font-h1">
                    TradeFind
                </h1>
</div>
<!-- Value Proposition -->
<div class="max-w-xs space-y-md">
<h2 class="font-h1 text-h1 text-on-background leading-tight">
                    Find trusted tradespeople near you — instantly
                </h2>
<p class="font-body-lg text-body-lg text-on-surface-variant">
                    Your direct link to local professionals for every job, big or small.
                </p>
</div>
</div>
<!-- Call to Action Section -->
<div class="relative z-10 p-margin pb-xl space-y-gutter bg-surface-bright/80 backdrop-blur-md rounded-t-[24px]">
<div class="flex flex-col gap-sm max-w-md mx-auto">
<!-- Primary Action -->
<button class="h-[56px] w-full bg-primary-container text-on-primary font-bold text-body-lg rounded-xl flex items-center justify-center gap-xs shadow-lg active:scale-95 transition-transform">
<span class="material-symbols-outlined" data-icon="search">search</span>
                    I need a tradesperson
                </button>
<!-- Secondary Action -->
<button class="h-[56px] w-full bg-surface-container-lowest text-primary border-2 border-primary-container/20 font-bold text-body-lg rounded-xl flex items-center justify-center gap-xs shadow-sm active:scale-95 transition-transform">
<span class="material-symbols-outlined" data-icon="engineering">engineering</span>
                    I'm a tradesperson
                </button>
</div>
<!-- Footnote -->
<p class="text-center text-label-md font-label-md text-on-surface-variant pt-base">
                Join 50k+ professionals and homeowners today
            </p>
</div>
<!-- Abstract Decorative Element (Asymmetric) -->
<div class="absolute top-0 right-0 w-1/2 h-1/3 bg-gradient-to-bl from-orange-100/30 to-transparent rounded-bl-full pointer-events-none"></div>
</main>
<!-- Material Symbols Loader -->
<script>
        document.addEventListener('DOMContentLoaded', () => {
            const icons = document.querySelectorAll('[data-icon]');
            icons.forEach(icon => {
                const span = document.createElement('span');
                span.className = 'material-symbols-outlined';
                span.textContent = icon.getAttribute('data-icon');
                if (icon.getAttribute('data-weight') === 'fill') {
                    span.style.fontVariationSettings = "'FILL' 1";
                }
                icon.innerHTML = '';
                icon.appendChild(span);
            });
        });
    </script>
</body></html>