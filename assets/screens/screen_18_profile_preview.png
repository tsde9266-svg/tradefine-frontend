<!DOCTYPE html>

<html class="light" lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script id="tailwind-config">
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            "colors": {
                    "tertiary-fixed": "#ffdf9f",
                    "surface-tint": "#9d4300",
                    "surface-container-low": "#f1f3ff",
                    "tertiary-container": "#c49200",
                    "surface-container-high": "#e1e8fd",
                    "on-secondary-fixed-variant": "#832600",
                    "on-primary": "#ffffff",
                    "secondary-fixed": "#ffdbd0",
                    "on-secondary": "#ffffff",
                    "on-primary-container": "#582200",
                    "secondary": "#ac3400",
                    "on-secondary-container": "#5d1900",
                    "on-background": "#141b2b",
                    "surface-dim": "#d3daef",
                    "outline": "#8c7164",
                    "on-error": "#ffffff",
                    "surface-variant": "#dce2f7",
                    "error": "#ba1a1a",
                    "surface-container-lowest": "#ffffff",
                    "primary-fixed": "#ffdbca",
                    "primary": "#9d4300",
                    "on-tertiary-fixed-variant": "#5c4300",
                    "tertiary": "#795900",
                    "surface-container": "#e9edff",
                    "primary-fixed-dim": "#ffb690",
                    "on-tertiary-fixed": "#261a00",
                    "on-error-container": "#93000a",
                    "background": "#f9f9ff",
                    "surface": "#f9f9ff",
                    "secondary-container": "#fd6b36",
                    "on-surface-variant": "#584237",
                    "outline-variant": "#e0c0b1",
                    "on-surface": "#141b2b",
                    "inverse-on-surface": "#edf0ff",
                    "on-secondary-fixed": "#390c00",
                    "error-container": "#ffdad6",
                    "inverse-surface": "#293040",
                    "secondary-fixed-dim": "#ffb59d",
                    "on-primary-fixed-variant": "#783200",
                    "tertiary-fixed-dim": "#f9bd22",
                    "primary-container": "#f97316",
                    "on-tertiary-container": "#422f00",
                    "on-primary-fixed": "#341100",
                    "inverse-primary": "#ffb690",
                    "on-tertiary": "#ffffff",
                    "surface-container-highest": "#dce2f7",
                    "surface-bright": "#f9f9ff"
            },
            "borderRadius": {
                    "DEFAULT": "0.25rem",
                    "lg": "0.5rem",
                    "xl": "0.75rem",
                    "full": "9999px"
            },
            "spacing": {
                    "margin": "16px",
                    "xs": "8px",
                    "lg": "24px",
                    "gutter": "12px",
                    "xl": "32px",
                    "sm": "12px",
                    "base": "4px",
                    "md": "16px"
            },
            "fontFamily": {
                    "label-md": ["Inter"],
                    "h2": ["Inter"],
                    "body-lg": ["Inter"],
                    "h3": ["Inter"],
                    "h1": ["Inter"],
                    "body-md": ["Inter"]
            },
            "fontSize": {
                    "label-md": ["12px", {"lineHeight": "16px", "letterSpacing": "0.02em", "fontWeight": "500"}],
                    "h2": ["24px", {"lineHeight": "30px", "letterSpacing": "-0.01em", "fontWeight": "700"}],
                    "body-lg": ["16px", {"lineHeight": "24px", "fontWeight": "400"}],
                    "h3": ["20px", {"lineHeight": "26px", "letterSpacing": "0em", "fontWeight": "700"}],
                    "h1": ["28px", {"lineHeight": "34px", "letterSpacing": "-0.02em", "fontWeight": "700"}],
                    "body-md": ["14px", {"lineHeight": "20px", "fontWeight": "400"}]
            }
          },
        },
      }
    </script>
<style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        .pb-safe { padding-bottom: env(safe-area-inset-bottom); }
        .tap-highlight-transparent { -webkit-tap-highlight-color: transparent; }
    </style>
<style>
    body {
      min-height: max(884px, 100dvh);
    }
  </style>
  </head>
<body class="bg-background text-on-surface font-body-md selection:bg-primary-fixed">
<!-- Preview Mode Banner -->
<div class="fixed top-0 left-0 w-full z-[60] bg-primary-container text-on-primary py-3 px-4 flex items-center justify-center shadow-lg">
<span class="material-symbols-outlined mr-2" style="font-variation-settings: 'FILL' 1;">visibility</span>
<span class="font-h3 text-label-md uppercase tracking-widest">PREVIEW MODE — This is what customers see</span>
</div>
<!-- Top App Bar -->
<header class="fixed top-12 left-0 w-full z-50 flex justify-between items-center px-4 h-16 bg-white dark:bg-gray-900 border-b border-gray-100 dark:border-gray-800 shadow-sm">
<div class="flex items-center gap-3">
<button class="active:scale-95 transition-all duration-200 p-2 hover:bg-gray-50 dark:hover:bg-gray-800 rounded-full">
<span class="material-symbols-outlined text-on-surface">arrow_back</span>
</button>
<h1 class="text-xl font-black tracking-tight text-orange-600 dark:text-orange-500 font-h1">TradeFind</h1>
</div>
<div class="flex items-center gap-2">
<button class="active:scale-95 transition-all duration-200 p-2 hover:bg-gray-50 dark:hover:bg-gray-800 rounded-full">
<span class="material-symbols-outlined text-gray-500">share</span>
</button>
<img alt="Worker profile photo" class="w-8 h-8 rounded-full object-cover border border-gray-200" data-alt="professional headshot of a skilled carpenter in work attire smiling confidently" src="https://lh3.googleusercontent.com/aida-public/AB6AXuC8JlDj56ypedJYK8bYr57tYntHJb36Oqhb8DiYkl6LpS3htrRFWKuK4rIPWBwwB0skxJdMvzsRChlRVZ0TA6wptZkI3RlSZI27bdZaR78Vc9ZIR5EYKRzb1MxN46Qw_6KQ61vh3Djh1uSDSZHmvlD2_JyMg6iRzon3LR82neLk0nLuFNANEQPILvOCAKHQAGldmHweas6xHzT2VEsIdfWu9cLbqGTy86H_0dEYh-LbXNNE05Y_cJSi7kxw429lMcAxGHuPRAhPWTs"/>
</div>
</header>
<main class="pt-32 pb-24 px-4 max-w-2xl mx-auto space-y-6">
<!-- Hero Section / Identity -->
<section class="bg-white rounded-xl p-6 shadow-[0_2px_8px_rgba(0,0,0,0.08)] flex flex-col items-center text-center">
<div class="relative mb-4">
<img alt="Marco Rossi" class="w-24 h-24 rounded-full object-cover border-4 border-white shadow-md" data-alt="detailed close-up portrait of a professional male tradesperson with a warm and trustworthy expression" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCMCGCiq5RfxCJNIHmGpwM849t0SiX2Ew9H-lfyFg9_DV32g3LB3DV2GRkmMgwdieBoeYcIJ88E3pvn5QKSaZBPR9SnLZPUbj22tQ-LdEEt7g-RtQCQ1k1z15OALSjASTho7ZZpQriHwaZa5bugevyCZZZtjwW9p5FtFfN8RNXoNYcuaC2OHeczX5ph-3lVdo50-dzOy-i9APVpIC_AK7as055_w1g60ZTTfLyen7-lFSLwN51tin4sKmNKg5Hdno6MVR3PxyXO4p8"/>
<span class="absolute bottom-1 right-1 w-6 h-6 bg-green-500 border-2 border-white rounded-full"></span>
</div>
<h2 class="font-h2 text-h2 text-on-surface mb-1">Marco Rossi</h2>
<p class="font-body-md text-secondary font-semibold mb-3">Master Electrician • 12+ Years Exp.</p>
<div class="flex items-center gap-2 mb-6">
<div class="flex text-[#FBBF24]">
<span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">star</span>
<span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">star</span>
<span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">star</span>
<span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">star</span>
<span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">star_half</span>
</div>
<span class="font-label-md text-gray-500">4.8 (142 reviews)</span>
</div>
<div class="grid grid-cols-2 gap-3 w-full">
<button class="h-12 bg-primary-container text-on-primary rounded-lg font-bold flex items-center justify-center gap-2 active:scale-95 transition-all">
<span class="material-symbols-outlined">edit</span>
                    Edit Profile
                </button>
<button class="h-12 border border-outline-variant text-on-surface rounded-lg font-bold flex items-center justify-center gap-2 active:scale-95 transition-all">
<span class="material-symbols-outlined text-secondary">chat_bubble</span>
                    Message
                </button>
</div>
</section>
<!-- Stats Bento Grid -->
<section class="grid grid-cols-2 md:grid-cols-4 gap-3">
<div class="bg-white p-4 rounded-xl shadow-[0_2px_8px_rgba(0,0,0,0.08)] flex flex-col items-center">
<span class="font-h3 text-primary">$85</span>
<span class="font-label-md text-gray-500">Hourly Rate</span>
</div>
<div class="bg-white p-4 rounded-xl shadow-[0_2px_8px_rgba(0,0,0,0.08)] flex flex-col items-center">
<span class="font-h3 text-primary">15mi</span>
<span class="font-label-md text-gray-500">Radius</span>
</div>
<div class="bg-white p-4 rounded-xl shadow-[0_2px_8px_rgba(0,0,0,0.08)] flex flex-col items-center">
<span class="font-h3 text-primary">24h</span>
<span class="font-label-md text-gray-500">Response</span>
</div>
<div class="bg-white p-4 rounded-xl shadow-[0_2px_8px_rgba(0,0,0,0.08)] flex flex-col items-center">
<span class="font-h3 text-primary">98%</span>
<span class="font-label-md text-gray-500">Completion</span>
</div>
</section>
<!-- Gallery / Work Samples -->
<section class="space-y-3">
<div class="flex justify-between items-center">
<h3 class="font-h3 text-h3">Work Portfolio</h3>
<button class="text-primary font-label-md">View All</button>
</div>
<div class="grid grid-cols-3 gap-2">
<img alt="Panel work" class="aspect-square object-cover rounded-lg" data-alt="close-up of a neatly wired modern electrical breaker panel with colorful copper wires" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBIfILb2YMtHeBjcQ-Bl7rwO12BT1KdGdapQLJVeZnaxYPXcRb__EhYUaUcv3h7zzh_3nWiWYYfetQ6lHNU7aiHAtsDpgJpR2Wi_x92yHR5Cb7jheE5meD5rQMWvpgHhEqa5LDKP06U8jbwrqBsN1WU3EZM4DcipQbUvLERZz0SLmthn-lSgVfpeb1WOThl3kyGXtU7e4grlbfPIFF6Rp6e3Ck9VnC-Uqv45Opon6VgdMn5qyi3FdhIkIjFt_f7lhSdFnEuX62Cd0g"/>
<img alt="Lighting installation" class="aspect-square object-cover rounded-lg" data-alt="industrial pendant lights being installed in a modern loft with brick walls" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDhEAJYQJ8wEU5gDA0tw9zDNWsUEHDnpOH8TiDn8R_DZU_E6elyJE8lVFXvoOa3CEVha8I-cw1EXGZxMy3mJwREbNjLvyvJUOFQ4bIo7he99Sa7BjZLp1EjvF9AsABzd5ZgogoGqmmHY9C9wROkoFB2qUrfSqkJ3NsY93r3UWi7kUapjwmUEFuQx1zhEpx68Gs15B4ldo3JL3MDISFkAGBdquiPWZ653fXrlKQT1CAtf4kN2tKi9VYPpqhh-sE1Zo8c0RjzHkCiuhA"/>
<div class="relative aspect-square">
<img alt="Testing" class="w-full h-full object-cover rounded-lg blur-[2px]" data-alt="technician testing a wall socket with a digital multimeter in a residential kitchen" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCQaWQm0aI7zeahzfk1-rhS9xHfnlQr_HpPdmvvVn65UNqA1x3jSX9rIXr26N_E_Sbc6oYQxaFlhwtCu4mZopLH07s5CkkieEqEFpmRgev6JbF3UipHPQE6CyKkn4oTgyyCM_RKQNe1Qjm4NIJUQx2uA3G80nbwkJugs3t6c225PTPIlvUQHcox6I5Q9e4kZnrgwrv1OGgqQMEe-gp-nZpCOld9Je4XItmTP87jhV80S9vnM1oGskwE-kP7aW82F1-EW3RFm28EI74"/>
<div class="absolute inset-0 bg-black/40 flex items-center justify-center rounded-lg">
<span class="text-white font-bold text-lg">+12</span>
</div>
</div>
</div>
</section>
<!-- About & Specialties -->
<section class="bg-white rounded-xl p-6 shadow-[0_2px_8px_rgba(0,0,0,0.08)] space-y-4">
<div>
<h3 class="font-h3 text-h3 mb-2">About</h3>
<p class="font-body-md text-on-surface-variant leading-relaxed">
                    Specializing in residential rewiring, smart home automation, and emergency repairs. I take pride in delivering clean, code-compliant work that ensures your family's safety. Licensed and insured since 2012.
                </p>
</div>
<div>
<h3 class="font-h3 text-h3 mb-3">Specialties</h3>
<div class="flex flex-wrap gap-2">
<span class="bg-surface-container-low text-on-surface-variant px-3 py-1.5 rounded-full font-label-md">EV Charger Install</span>
<span class="bg-surface-container-low text-on-surface-variant px-3 py-1.5 rounded-full font-label-md">Smart Lighting</span>
<span class="bg-surface-container-low text-on-surface-variant px-3 py-1.5 rounded-full font-label-md">Panel Upgrades</span>
<span class="bg-surface-container-low text-on-surface-variant px-3 py-1.5 rounded-full font-label-md">Fault Finding</span>
</div>
</div>
</section>
<!-- Verified Badges -->
<section class="flex gap-4 p-4 bg-orange-50 dark:bg-orange-900/10 rounded-xl border border-orange-100 dark:border-orange-800">
<div class="flex items-center gap-2">
<span class="material-symbols-outlined text-green-600" style="font-variation-settings: 'FILL' 1;">verified</span>
<span class="font-label-md text-on-surface">ID Verified</span>
</div>
<div class="flex items-center gap-2">
<span class="material-symbols-outlined text-green-600" style="font-variation-settings: 'FILL' 1;">policy</span>
<span class="font-label-md text-on-surface">Insured</span>
</div>
<div class="flex items-center gap-2">
<span class="material-symbols-outlined text-green-600" style="font-variation-settings: 'FILL' 1;">workspace_premium</span>
<span class="font-label-md text-on-surface">Licensed</span>
</div>
</section>
<!-- Reviews Preview -->
<section class="space-y-4">
<div class="flex justify-between items-center">
<h3 class="font-h3 text-h3">Client Reviews</h3>
<button class="text-primary font-label-md">See All</button>
</div>
<div class="bg-white p-4 rounded-xl shadow-[0_2px_8px_rgba(0,0,0,0.08)] space-y-3">
<div class="flex justify-between items-start">
<div class="flex items-center gap-2">
<img alt="Sarah J." class="w-10 h-10 rounded-full object-cover" data-alt="portrait of a satisfied female customer in a bright interior setting" src="https://lh3.googleusercontent.com/aida-public/AB6AXuC8Mn9kLHzQhEmo23Tgc3hj0f3C3DFsBuZh0IyxTLeLuNgF8gkOc99XX6DDDWeWwtRyzpx74ysaeOfhBRmhozKc_jad8gut3l9haV4-A7Gt06C5eEWYTKxeDzNDX1i7HmSb4omAey-yB1F2TEyw2N4T0-_FfIuOTpgIG1ir6i4LLiyRROSq3wLkRn4YF9FAiDY3y0m_SnUWcgJjVmCNuneh7W5dwe8zESAkTQh_D1b8RLta1-SdFex9j5T9HjNo8DTgQkuQHbBBRcM"/>
<div>
<p class="font-bold text-on-surface">Sarah Jenkins</p>
<p class="text-xs text-gray-500">2 days ago</p>
</div>
</div>
<div class="flex text-[#FBBF24]">
<span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 1;">star</span>
<span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 1;">star</span>
<span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 1;">star</span>
<span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 1;">star</span>
<span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 1;">star</span>
</div>
</div>
<p class="font-body-md text-on-surface-variant italic">"Marco was incredibly professional. He fixed my short circuit issue in less than an hour and even explained how to prevent it in the future. Highly recommend!"</p>
</div>
</section>
</main>
<!-- Bottom Navigation Bar -->
<nav class="fixed bottom-0 left-0 w-full z-50 flex justify-around items-center h-16 pb-safe px-6 bg-white dark:bg-gray-900 border-t border-gray-100 dark:border-gray-800 shadow-[0_-2px_10px_rgba(0,0,0,0.05)] rounded-t-xl">
<a class="flex flex-col items-center justify-center text-gray-400 dark:text-gray-500 hover:text-orange-400 transition-transform active:opacity-70 tap-highlight-transparent" href="#">
<span class="material-symbols-outlined">work</span>
<span class="font-['Inter'] text-[10px] font-medium">Jobs</span>
</a>
<a class="flex flex-col items-center justify-center text-gray-400 dark:text-gray-500 hover:text-orange-400 transition-transform active:opacity-70 tap-highlight-transparent" href="#">
<span class="material-symbols-outlined">chat_bubble</span>
<span class="font-['Inter'] text-[10px] font-medium">Messages</span>
</a>
<a class="flex flex-col items-center justify-center text-gray-400 dark:text-gray-500 hover:text-orange-400 transition-transform active:opacity-70 tap-highlight-transparent" href="#">
<span class="material-symbols-outlined">calendar_today</span>
<span class="font-['Inter'] text-[10px] font-medium">Schedule</span>
</a>
<a class="flex flex-col items-center justify-center text-orange-600 dark:text-orange-500 scale-110 transition-transform active:opacity-70 tap-highlight-transparent" href="#">
<span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">person</span>
<span class="font-['Inter'] text-[10px] font-medium">Profile</span>
</a>
</nav>
</body></html>