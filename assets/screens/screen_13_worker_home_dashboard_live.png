<!DOCTYPE html>

<html class="light" lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0, viewport-fit=cover" name="viewport"/>
<title>TradeFind - Active Status</title>
<link href="https://fonts.googleapis.com" rel="preconnect"/>
<link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;800;900&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "surface-bright": "#f9f9ff",
                        "surface": "#f9f9ff",
                        "on-secondary": "#ffffff",
                        "on-tertiary-fixed-variant": "#5c4300",
                        "on-secondary-container": "#5d1900",
                        "on-background": "#141b2b",
                        "on-primary-fixed-variant": "#783200",
                        "tertiary-container": "#c49200",
                        "on-error": "#ffffff",
                        "background": "#f9f9ff",
                        "surface-container": "#e9edff",
                        "on-tertiary-fixed": "#261a00",
                        "on-surface-variant": "#584237",
                        "primary-fixed-dim": "#ffb690",
                        "secondary": "#ac3400",
                        "secondary-fixed-dim": "#ffb59d",
                        "surface-container-highest": "#dce2f7",
                        "on-error-container": "#93000a",
                        "on-tertiary-container": "#422f00",
                        "surface-tint": "#9d4300",
                        "on-primary-container": "#582200",
                        "outline-variant": "#e0c0b1",
                        "secondary-fixed": "#ffdbd0",
                        "primary-container": "#f97316",
                        "surface-container-low": "#f1f3ff",
                        "primary-fixed": "#ffdbca",
                        "on-secondary-fixed": "#390c00",
                        "tertiary-fixed": "#ffdf9f",
                        "inverse-on-surface": "#edf0ff",
                        "on-surface": "#141b2b",
                        "outline": "#8c7164",
                        "on-secondary-fixed-variant": "#832600",
                        "surface-container-lowest": "#ffffff",
                        "surface-variant": "#dce2f7",
                        "primary": "#9d4300",
                        "surface-container-high": "#e1e8fd",
                        "on-tertiary": "#ffffff",
                        "secondary-container": "#fd6b36",
                        "tertiary": "#795900",
                        "error-container": "#ffdad6",
                        "on-primary-fixed": "#341100",
                        "tertiary-fixed-dim": "#f9bd22",
                        "error": "#ba1a1a",
                        "inverse-primary": "#ffb690",
                        "on-primary": "#ffffff",
                        "surface-dim": "#d3daef",
                        "inverse-surface": "#293040"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    "spacing": {
                        "sm": "12px",
                        "gutter": "12px",
                        "lg": "24px",
                        "xs": "8px",
                        "md": "16px",
                        "base": "4px",
                        "xl": "32px",
                        "margin": "16px"
                    },
                    "fontFamily": {
                        "h2": ["Inter"],
                        "label-md": ["Inter"],
                        "body-md": ["Inter"],
                        "h1": ["Inter"],
                        "h3": ["Inter"],
                        "body-lg": ["Inter"]
                    },
                    "fontSize": {
                        "h2": ["24px", {"lineHeight": "30px", "letterSpacing": "-0.01em", "fontWeight": "700"}],
                        "label-md": ["12px", {"lineHeight": "16px", "letterSpacing": "0.02em", "fontWeight": "500"}],
                        "body-md": ["14px", {"lineHeight": "20px", "fontWeight": "400"}],
                        "h1": ["28px", {"lineHeight": "34px", "letterSpacing": "-0.02em", "fontWeight": "700"}],
                        "h3": ["20px", {"lineHeight": "26px", "letterSpacing": "0em", "fontWeight": "700"}],
                        "body-lg": ["16px", {"lineHeight": "24px", "fontWeight": "400"}]
                    }
                },
            },
        }
    </script>
<style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        @keyframes pulse-green {
            0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.7); }
            70% { transform: scale(1); box-shadow: 0 0 0 10px rgba(34, 197, 94, 0); }
            100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(34, 197, 94, 0); }
        }
        .pulse-indicator {
            animation: pulse-green 2s infinite;
        }
    </style>
<style>
    body {
      min-height: max(884px, 100dvh);
    }
  </style>
  </head>
<body class="bg-surface-bright text-on-surface font-body-md min-h-screen pb-20">
<!-- TopAppBar -->
<header class="sticky top-0 z-50 flex justify-between items-center w-full px-4 h-16 bg-[#F9FAFB] border-b border-slate-200 font-['Inter'] antialiased tracking-tight">
<div class="flex items-center gap-4">
<button class="p-2 rounded-full hover:bg-slate-100 transition-colors active:scale-95 duration-150">
<span class="material-symbols-outlined text-slate-500">menu</span>
</button>
<h1 class="text-2xl font-black text-orange-600">TradeFind</h1>
</div>
<div class="flex items-center gap-2">
<div class="w-10 h-10 rounded-full overflow-hidden border-2 border-orange-100">
<img alt="User Profile" class="w-full h-full object-cover" data-alt="professional portrait of a confident tradesperson in a clean work uniform against a blurred industrial workshop background" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAXH6FyYrAlvsXcrT7QvNNujFrThwjfa3u26umalra4H-3ztG-FO-3tUwHcJszXueQUqhZbte3jdad_Lhv7GUAosy4rSGhN6iPVnnVwjjEU69iQgN_BfPW9c63jq-oyCqZsPutIK7SNF-ON9h2PyWrqunNojqpUj19uZgxqJVcHZYYiSgePRHqBI4C7CgpkIhgl7woTv84OVoc2BkEWN4-cMy8L8i4gO2dOBxTcbd3YNGc7Vdm7WOc5L1Z0DzdYRhOsoOou0TpFhrg"/>
</div>
</div>
</header>
<main class="max-w-md mx-auto px-4 py-6 space-y-6">
<!-- Active Status Card -->
<section class="bg-green-600 rounded-xl p-6 shadow-[0_4px_20px_rgba(22,163,74,0.25)] text-white relative overflow-hidden">
<!-- Decorative Grain Texture -->
<div class="absolute inset-0 opacity-10 pointer-events-none bg-[url('https://www.transparenttextures.com/patterns/carbon-fibre.png')]"></div>
<div class="relative z-10 flex flex-col items-center text-center space-y-4">
<div class="relative">
<div class="w-4 h-4 bg-green-300 rounded-full pulse-indicator absolute -top-1 -right-1 border-2 border-green-600"></div>
<div class="w-16 h-16 bg-white/20 rounded-full flex items-center justify-center backdrop-blur-sm">
<span class="material-symbols-outlined text-4xl" data-weight="fill" style="font-variation-settings: 'FILL' 1;">sensors</span>
</div>
</div>
<div>
<h2 class="font-h2 text-white mb-1">You're LIVE</h2>
<p class="font-body-md text-green-50 opacity-90">Customers can find and book you in real-time.</p>
</div>
<div class="w-full pt-2">
<button class="w-full bg-white text-green-700 font-bold py-3.5 px-6 rounded-lg transition-transform active:scale-95 hover:bg-green-50 flex items-center justify-center gap-2">
<span class="material-symbols-outlined">power_settings_new</span>
                        Go Offline
                    </button>
</div>
</div>
</section>
<!-- Stats Counter -->
<section class="bg-white border border-slate-100 rounded-xl p-4 flex items-center gap-4 shadow-[0_2px_8px_rgba(0,0,0,0.08)]">
<div class="w-12 h-12 bg-orange-50 rounded-lg flex items-center justify-center">
<span class="material-symbols-outlined text-orange-600">visibility</span>
</div>
<div>
<p class="font-body-md font-bold text-on-surface">
<span class="text-orange-600">3 customers</span> have viewed your profile
                </p>
<p class="text-label-md text-slate-500">in the last hour</p>
</div>
</section>
<!-- Map Preview -->
<section class="space-y-3">
<div class="flex items-center justify-between">
<h3 class="font-h3 text-on-surface flex items-center gap-2">
<span class="material-symbols-outlined text-orange-600">location_on</span>
                    Live Broadcast Area
                </h3>
<span class="text-label-md font-bold text-green-600 bg-green-50 px-2 py-1 rounded">3.5 miles radius</span>
</div>
<div class="relative w-full h-64 rounded-xl overflow-hidden border border-slate-200 shadow-sm">
<img alt="Map location" class="w-full h-full object-cover" data-alt="clean minimal topographic map of an urban city neighborhood with subtle orange and green highlight overlays indicating service coverage" data-location="Austin, Texas" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBUAkGuEzWthEmMzjTPlb-JXlQBcoI5N5Tigmyjy7-zZ2b8Xtr-0qn6mrcYOv7wPC0h3ZQCNX_y002O8lhix8WLh8dAu9OIrle6rWqlulWluus_F8cfWwLMiSmYlj5oO7Xc6rirwJNkgTfINaxpdWMH_8MUY_0G2gUEEQ6SnLxmu_0iSzQ1NrjvOEaGfGRvAcY9C3FD3xt8RvTbQoBAWWVOZt65BLE1cwYOgVUOMXRMmw2fEPv-kiSupwpeEPkkGgoqVSgkzg_6TYE"/>
<!-- Map Overlay UI -->
<div class="absolute inset-0 flex items-center justify-center">
<div class="relative">
<!-- Pulsing Radius -->
<div class="absolute inset-0 w-32 h-32 -translate-x-1/2 -translate-y-1/2 bg-green-500/20 border-2 border-green-500 rounded-full animate-pulse"></div>
<!-- Marker -->
<div class="relative z-20 bg-orange-600 text-white p-2 rounded-full shadow-lg border-2 border-white">
<span class="material-symbols-outlined text-2xl">home_repair_service</span>
</div>
</div>
</div>
<!-- Location Label -->
<div class="absolute bottom-4 left-4 right-4 bg-white/90 backdrop-blur-md p-3 rounded-lg border border-slate-200 flex justify-between items-center">
<div class="flex items-center gap-2">
<span class="material-symbols-outlined text-slate-400 text-sm">my_location</span>
<p class="text-label-md font-bold text-slate-700">742 Evergreen Terrace, Springfield</p>
</div>
<button class="text-orange-600 font-bold text-label-md">Edit</button>
</div>
</div>
</section>
<!-- Activity Feed (Bento Style) -->
<section class="grid grid-cols-2 gap-3 pb-8">
<div class="col-span-1 bg-surface-container-low p-4 rounded-xl flex flex-col justify-between h-32">
<span class="material-symbols-outlined text-orange-600">bolt</span>
<div>
<p class="text-h3 font-bold">12</p>
<p class="text-label-md text-slate-500">New Leads</p>
</div>
</div>
<div class="col-span-1 bg-surface-container-low p-4 rounded-xl flex flex-col justify-between h-32">
<span class="material-symbols-outlined text-tertiary">star</span>
<div>
<p class="text-h3 font-bold">4.9</p>
<p class="text-label-md text-slate-500">Rating</p>
</div>
</div>
<div class="col-span-2 bg-slate-900 text-white p-4 rounded-xl flex items-center justify-between">
<div class="flex items-center gap-3">
<div class="p-2 bg-white/10 rounded-lg">
<span class="material-symbols-outlined text-white">schedule</span>
</div>
<div>
<p class="font-bold text-body-md">Schedule for tomorrow</p>
<p class="text-label-md text-slate-400">4 jobs confirmed</p>
</div>
</div>
<span class="material-symbols-outlined">chevron_right</span>
</div>
</section>
</main>
<!-- BottomNavBar -->
<nav class="fixed bottom-0 left-0 w-full z-50 flex justify-around items-center h-16 bg-white border-t border-slate-100 px-2 pb-safe shadow-[0_-2px_8px_rgba(0,0,0,0.08)]">
<a class="flex flex-col items-center justify-center text-orange-600 bg-orange-50/50 rounded-xl px-3 py-1 font-['Inter'] text-[12px] font-medium transition-transform active:scale-90 tap-highlight-transparent" href="#">
<span class="material-symbols-outlined" data-weight="fill" style="font-variation-settings: 'FILL' 1;">home</span>
<span>Home</span>
</a>
<a class="flex flex-col items-center justify-center text-slate-400 hover:text-orange-500 font-['Inter'] text-[12px] font-medium transition-transform active:scale-90 tap-highlight-transparent" href="#">
<span class="material-symbols-outlined">map</span>
<span>Map</span>
</a>
<a class="flex flex-col items-center justify-center text-slate-400 hover:text-orange-500 font-['Inter'] text-[12px] font-medium transition-transform active:scale-90 tap-highlight-transparent" href="#">
<span class="material-symbols-outlined">bookmark</span>
<span>Bookmarks</span>
</a>
<a class="flex flex-col items-center justify-center text-slate-400 hover:text-orange-500 font-['Inter'] text-[12px] font-medium transition-transform active:scale-90 tap-highlight-transparent" href="#">
<span class="material-symbols-outlined">person</span>
<span>Profile</span>
</a>
</nav>
</body></html>