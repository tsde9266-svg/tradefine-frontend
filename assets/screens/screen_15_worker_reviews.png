<!DOCTYPE html>

<html class="light" lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;800;900&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<script id="tailwind-config">
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            "colors": {
                    "surface-bright": "#f9f9ff",
                    "surface": "#f9f9ff",
                    "on-secondary": "#ffffff",
                    "on-tertiary-fixed-variant": "#5c4300",
                    "on-secondary-container": "#5d1900",
                    "on-background": "#141b2b",
                    "on-primary-fixed-variant": "#783200",
                    "tertiary-container": "#c49200",
                    "on-error": "#ffffff",
                    "background": "#f9f9ff",
                    "surface-container": "#e9edff",
                    "on-tertiary-fixed": "#261a00",
                    "on-surface-variant": "#584237",
                    "primary-fixed-dim": "#ffb690",
                    "secondary": "#ac3400",
                    "secondary-fixed-dim": "#ffb59d",
                    "surface-container-highest": "#dce2f7",
                    "on-error-container": "#93000a",
                    "on-tertiary-container": "#422f00",
                    "surface-tint": "#9d4300",
                    "on-primary-container": "#582200",
                    "outline-variant": "#e0c0b1",
                    "secondary-fixed": "#ffdbd0",
                    "primary-container": "#f97316",
                    "surface-container-low": "#f1f3ff",
                    "primary-fixed": "#ffdbca",
                    "on-secondary-fixed": "#390c00",
                    "tertiary-fixed": "#ffdf9f",
                    "inverse-on-surface": "#edf0ff",
                    "on-surface": "#141b2b",
                    "outline": "#8c7164",
                    "on-secondary-fixed-variant": "#832600",
                    "surface-container-lowest": "#ffffff",
                    "surface-variant": "#dce2f7",
                    "primary": "#9d4300",
                    "surface-container-high": "#e1e8fd",
                    "on-tertiary": "#ffffff",
                    "secondary-container": "#fd6b36",
                    "tertiary": "#795900",
                    "error-container": "#ffdad6",
                    "on-primary-fixed": "#341100",
                    "tertiary-fixed-dim": "#f9bd22",
                    "error": "#ba1a1a",
                    "inverse-primary": "#ffb690",
                    "on-primary": "#ffffff",
                    "surface-dim": "#d3daef",
                    "inverse-surface": "#293040"
            },
            "borderRadius": {
                    "DEFAULT": "0.25rem",
                    "lg": "0.5rem",
                    "xl": "0.75rem",
                    "full": "9999px"
            },
            "spacing": {
                    "sm": "12px",
                    "gutter": "12px",
                    "lg": "24px",
                    "xs": "8px",
                    "md": "16px",
                    "base": "4px",
                    "xl": "32px",
                    "margin": "16px"
            },
            "fontFamily": {
                    "h2": ["Inter"],
                    "label-md": ["Inter"],
                    "body-md": ["Inter"],
                    "h1": ["Inter"],
                    "h3": ["Inter"],
                    "body-lg": ["Inter"]
            },
            "fontSize": {
                    "h2": ["24px", {"lineHeight": "30px", "letterSpacing": "-0.01em", "fontWeight": "700"}],
                    "label-md": ["12px", {"lineHeight": "16px", "letterSpacing": "0.02em", "fontWeight": "500"}],
                    "body-md": ["14px", {"lineHeight": "20px", "fontWeight": "400"}],
                    "h1": ["28px", {"lineHeight": "34px", "letterSpacing": "-0.02em", "fontWeight": "700"}],
                    "h3": ["20px", {"lineHeight": "26px", "letterSpacing": "0em", "fontWeight": "700"}],
                    "body-lg": ["16px", {"lineHeight": "24px", "fontWeight": "400"}]
            }
          },
        },
      }
    </script>
<style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        body {
            background-color: #F9FAFB;
        }
    </style>
<style>
    body {
      min-height: max(884px, 100dvh);
    }
  </style>
  </head>
<body class="antialiased text-on-surface">
<!-- TopAppBar -->
<header class="sticky top-0 z-50 flex justify-between items-center w-full px-4 h-16 bg-[#F9FAFB] border-b border-slate-200 font-['Inter'] antialiased tracking-tight">
<div class="flex items-center gap-4">
<button class="p-2 hover:bg-slate-100 transition-colors rounded-full active:scale-95 duration-150">
<span class="material-symbols-outlined text-slate-500">menu</span>
</button>
<h1 class="text-2xl font-black text-orange-600">TradeFind</h1>
</div>
<div class="flex items-center gap-2">
<div class="w-10 h-10 rounded-full overflow-hidden border-2 border-primary-container">
<img class="w-full h-full object-cover" data-alt="professional portrait of a confident tradesperson wearing a branded work shirt, clean studio lighting, neutral background" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDvLsRzGazHS3YCRk46rlpJvyyYLJw6whUBXaXjj44-FdbfW5aqaUj4g4ggoBV7a2XUpx_1haz9sgjSqmo0j8z4bdQHglbVPCP6sD-paizF1hY9GcfxRUNJBBIscsmX8xLVhVOtscIjN9dyUgAq0z0KkGIvNSeiVWgkQx5hHZKfzi_myEv8b0i4j2gx9L-trPrDu6dlZuVfZnqzyRJ-tpgaL_pcKezVluG1rVjg5C2epKGUiPgwmI2CvccslhJnzlRa-4z1j9FyiWs"/>
</div>
</div>
</header>
<main class="max-w-md mx-auto pb-32 pt-6 px-4">
<!-- Header Section -->
<div class="mb-8">
<h2 class="font-h1 text-h1 text-on-surface mb-2">My Reviews</h2>
<div class="flex items-center gap-3">
<div class="flex items-center">
<span class="material-symbols-outlined text-[#FBBF24]" style="font-variation-settings: 'FILL' 1;">star</span>
<span class="font-h2 text-h2 ml-1">4.9</span>
</div>
<span class="font-body-md text-on-surface-variant">(47 reviews)</span>
</div>
</div>
<!-- Rating Breakdown Bento -->
<section class="bg-surface-container-lowest rounded-xl p-md shadow-[0_2px_8px_rgba(0,0,0,0.08)] mb-lg border border-outline-variant/30">
<div class="space-y-3">
<!-- 5 Star -->
<div class="flex items-center gap-3">
<span class="font-label-md text-label-md w-12 text-on-surface-variant">5 Star</span>
<div class="flex-1 h-3 bg-surface-container rounded-full overflow-hidden">
<div class="h-full bg-primary-container w-[90%]"></div>
</div>
<span class="font-label-md text-label-md w-8 text-right">42</span>
</div>
<!-- 4 Star -->
<div class="flex items-center gap-3">
<span class="font-label-md text-label-md w-12 text-on-surface-variant">4 Star</span>
<div class="flex-1 h-3 bg-surface-container rounded-full overflow-hidden">
<div class="h-full bg-primary-container w-[8%]"></div>
</div>
<span class="font-label-md text-label-md w-8 text-right">4</span>
</div>
<!-- 3 Star -->
<div class="flex items-center gap-3">
<span class="font-label-md text-label-md w-12 text-on-surface-variant">3 Star</span>
<div class="flex-1 h-3 bg-surface-container rounded-full overflow-hidden">
<div class="h-full bg-primary-container w-[2%]"></div>
</div>
<span class="font-label-md text-label-md w-8 text-right">1</span>
</div>
<!-- 2 Star -->
<div class="flex items-center gap-3">
<span class="font-label-md text-label-md w-12 text-on-surface-variant">2 Star</span>
<div class="flex-1 h-3 bg-surface-container rounded-full overflow-hidden">
<div class="h-full bg-primary-container w-[0%]"></div>
</div>
<span class="font-label-md text-label-md w-8 text-right">0</span>
</div>
<!-- 1 Star -->
<div class="flex items-center gap-3">
<span class="font-label-md text-label-md w-12 text-on-surface-variant">1 Star</span>
<div class="flex-1 h-3 bg-surface-container rounded-full overflow-hidden">
<div class="h-full bg-primary-container w-[0%]"></div>
</div>
<span class="font-label-md text-label-md w-8 text-right">0</span>
</div>
</div>
</section>
<!-- Filter Chips -->
<div class="flex gap-2 mb-lg overflow-x-auto pb-2 no-scrollbar">
<button class="px-md py-xs rounded-full bg-primary-container text-white font-label-md text-label-md whitespace-nowrap active:scale-95 transition-transform">All</button>
<button class="px-md py-xs rounded-full bg-surface-container-high text-on-surface-variant font-label-md text-label-md whitespace-nowrap active:scale-95 transition-transform">5 Star</button>
<button class="px-md py-xs rounded-full bg-surface-container-high text-on-surface-variant font-label-md text-label-md whitespace-nowrap active:scale-95 transition-transform">Recent</button>
</div>
<!-- Review List -->
<div class="space-y-4">
<!-- Review Card 1 -->
<article class="bg-surface-container-lowest rounded-xl p-md shadow-[0_2px_8px_rgba(0,0,0,0.08)] border border-outline-variant/20">
<div class="flex justify-between items-start mb-3">
<div class="flex items-center gap-3">
<img class="w-10 h-10 rounded-full object-cover" data-alt="close-up portrait of a middle-aged woman smiling warmly, soft natural outdoor lighting, high quality photography" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBMGG3-QdB5wR9_3s83jjcOxGoGmb0974oFqASo6wysOaK_L1y4FWGUDWQB94AeVY_xMU00ZViWWto4jBNR53zp4TsUK8w4NAglxLQZBzqAZ_KvsKS5hJ8ZB4yjeWIUoMJw6NMPzI-RKRyMCDKkggU8bgydM1s5lYDZmnZuuBgqqZBzJxVid3buEqg_4ZJH1TPXFc5mEk93vJZbhpqKJrBa9hOpbNXA8x6Kee6GpmRhpJl2HPIS-i4OgYnurKX64G-Pd8N0ObVwTLY"/>
<div>
<h4 class="font-h3 text-body-lg font-bold">Jane Doe</h4>
<p class="font-label-md text-label-md text-on-surface-variant">Oct 12, 2023</p>
</div>
</div>
<div class="flex">
<span class="material-symbols-outlined text-[#FBBF24] text-[18px]" style="font-variation-settings: 'FILL' 1;">star</span>
<span class="material-symbols-outlined text-[#FBBF24] text-[18px]" style="font-variation-settings: 'FILL' 1;">star</span>
<span class="material-symbols-outlined text-[#FBBF24] text-[18px]" style="font-variation-settings: 'FILL' 1;">star</span>
<span class="material-symbols-outlined text-[#FBBF24] text-[18px]" style="font-variation-settings: 'FILL' 1;">star</span>
<span class="material-symbols-outlined text-[#FBBF24] text-[18px]" style="font-variation-settings: 'FILL' 1;">star</span>
</div>
</div>
<p class="font-body-md text-on-surface mb-4 leading-relaxed">
                    Exceptional service! Arrived exactly on time and fixed our plumbing issue in no time. Very professional and clean work. Highly recommend to anyone looking for quality trade work.
                </p>
<button class="flex items-center gap-2 text-primary-container font-label-md text-label-md font-bold uppercase tracking-wider hover:opacity-80 transition-opacity">
<span class="material-symbols-outlined text-[16px]">reply</span>
                    Reply
                </button>
</article>
<!-- Review Card 2 -->
<article class="bg-surface-container-lowest rounded-xl p-md shadow-[0_2px_8px_rgba(0,0,0,0.08)] border border-outline-variant/20">
<div class="flex justify-between items-start mb-3">
<div class="flex items-center gap-3">
<img class="w-10 h-10 rounded-full object-cover" data-alt="professional man in a business casual outfit, confident expression, soft focus office background" src="https://lh3.googleusercontent.com/aida-public/AB6AXuA6LB2toxkKHeuFPhNqCQ5iFSoQ7ROL5iA7K9ipXKEXzIwUQ-pg0dUXEczh6qkR3u7fDQa-W-VUTQkf3KfWGiS2n0DLfRdslA49Itjf8-LYrxdiz381PDyldNFzgD_CACmOK5FMuQJ_GkZyCaiyL_PgiBcA1e6gx1BZuNAacC8wJwB7QpXBvVGDzG909zkaoxDophbxTfPtl5nJez0qYsS1KLe88bldVWm5-YyQqwRjfXfPwqG---PH4EHdJiWvTlOXqyp5NNqS8M4"/>
<div>
<h4 class="font-h3 text-body-lg font-bold">Mark Smith</h4>
<p class="font-label-md text-label-md text-on-surface-variant">Oct 05, 2023</p>
</div>
</div>
<div class="flex">
<span class="material-symbols-outlined text-[#FBBF24] text-[18px]" style="font-variation-settings: 'FILL' 1;">star</span>
<span class="material-symbols-outlined text-[#FBBF24] text-[18px]" style="font-variation-settings: 'FILL' 1;">star</span>
<span class="material-symbols-outlined text-[#FBBF24] text-[18px]" style="font-variation-settings: 'FILL' 1;">star</span>
<span class="material-symbols-outlined text-[#FBBF24] text-[18px]" style="font-variation-settings: 'FILL' 1;">star</span>
<span class="material-symbols-outlined text-[#FBBF24] text-[18px]" style="font-variation-settings: 'FILL' 0;">star</span>
</div>
</div>
<p class="font-body-md text-on-surface mb-4 leading-relaxed">
                    Great overall experience. The finish on the tiling was perfect. Took a little longer than estimated but the quality justifies the wait.
                </p>
<div class="bg-surface-container-low rounded-lg p-3 mb-4 border-l-4 border-primary-container">
<p class="font-label-md text-label-md font-bold text-primary-container mb-1">Your Reply</p>
<p class="font-body-md text-on-surface-variant text-[13px]">Thanks Mark! Glad you're happy with the tiling. Quality always takes priority for me.</p>
</div>
<button class="flex items-center gap-2 text-on-surface-variant font-label-md text-label-md font-bold uppercase tracking-wider opacity-50 cursor-not-allowed">
<span class="material-symbols-outlined text-[16px]">reply</span>
                    Replied
                </button>
</article>
<!-- Review Card 3 -->
<article class="bg-surface-container-lowest rounded-xl p-md shadow-[0_2px_8px_rgba(0,0,0,0.08)] border border-outline-variant/20">
<div class="flex justify-between items-start mb-3">
<div class="flex items-center gap-3">
<img class="w-10 h-10 rounded-full object-cover" data-alt="young professional woman in a creative studio, bright airy lighting, modern aesthetic" src="https://lh3.googleusercontent.com/aida-public/AB6AXuA8kStf26DQ7AjV0cRhstrW97Yt3uQSNNhgX5foD79Fhjzrt_nrxwDs1WJ0sxDvkUbeMS_YaJDFG6lIJoLjfLg-3ieUmvDUpt-9mScH87pO7c0Rg07a0-DZVaxbTmH9CB-IunvdQLB_Rwg93JAx1L-RUAB9-cT3BBaN8nGgjTFhHv6ftnC_ZUDxuZAF3j-OPE9r5AMif5QqPOIpqOUwU7POtSCARhHOqjifWQzGuVTiKK4h3X4a5ZzasMVIgFDlT0ajU4DdgfF6jd8"/>
<div>
<h4 class="font-h3 text-body-lg font-bold">Alice Wong</h4>
<p class="font-label-md text-label-md text-on-surface-variant">Sep 28, 2023</p>
</div>
</div>
<div class="flex">
<span class="material-symbols-outlined text-[#FBBF24] text-[18px]" style="font-variation-settings: 'FILL' 1;">star</span>
<span class="material-symbols-outlined text-[#FBBF24] text-[18px]" style="font-variation-settings: 'FILL' 1;">star</span>
<span class="material-symbols-outlined text-[#FBBF24] text-[18px]" style="font-variation-settings: 'FILL' 1;">star</span>
<span class="material-symbols-outlined text-[#FBBF24] text-[18px]" style="font-variation-settings: 'FILL' 1;">star</span>
<span class="material-symbols-outlined text-[#FBBF24] text-[18px]" style="font-variation-settings: 'FILL' 1;">star</span>
</div>
</div>
<p class="font-body-md text-on-surface mb-4 leading-relaxed">
                    Found them through TradeFind and couldn't be happier. Super transparent pricing and very respectful of my home.
                </p>
<button class="flex items-center gap-2 text-primary-container font-label-md text-label-md font-bold uppercase tracking-wider hover:opacity-80 transition-opacity">
<span class="material-symbols-outlined text-[16px]">reply</span>
                    Reply
                </button>
</article>
</div>
</main>
<!-- BottomNavBar -->
<nav class="fixed bottom-0 left-0 w-full z-50 flex justify-around items-center h-16 bg-white border-t border-slate-100 px-2 pb-safe shadow-[0_-2px_8px_rgba(0,0,0,0.08)]">
<button class="flex flex-col items-center justify-center text-slate-400 font-['Inter'] text-[12px] font-medium tap-highlight-transparent transition-transform active:scale-90">
<span class="material-symbols-outlined">home</span>
<span>Home</span>
</button>
<button class="flex flex-col items-center justify-center text-slate-400 font-['Inter'] text-[12px] font-medium tap-highlight-transparent transition-transform active:scale-90">
<span class="material-symbols-outlined">map</span>
<span>Map</span>
</button>
<button class="flex flex-col items-center justify-center text-slate-400 font-['Inter'] text-[12px] font-medium tap-highlight-transparent transition-transform active:scale-90">
<span class="material-symbols-outlined">bookmark</span>
<span>Bookmarks</span>
</button>
<button class="flex flex-col items-center justify-center text-orange-600 bg-orange-50/50 rounded-xl px-3 py-1 font-['Inter'] text-[12px] font-medium tap-highlight-transparent transition-transform active:scale-90">
<span class="material-symbols-outlined">person</span>
<span>Profile</span>
</button>
</nav>
</body></html>