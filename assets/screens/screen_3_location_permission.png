<!DOCTYPE html>

<html class="light" lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;800;900&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "surface-bright": "#f9f9ff",
                        "surface": "#f9f9ff",
                        "on-secondary": "#ffffff",
                        "on-tertiary-fixed-variant": "#5c4300",
                        "on-secondary-container": "#5d1900",
                        "on-background": "#141b2b",
                        "on-primary-fixed-variant": "#783200",
                        "tertiary-container": "#c49200",
                        "on-error": "#ffffff",
                        "background": "#f9f9ff",
                        "surface-container": "#e9edff",
                        "on-tertiary-fixed": "#261a00",
                        "on-surface-variant": "#584237",
                        "primary-fixed-dim": "#ffb690",
                        "secondary": "#ac3400",
                        "secondary-fixed-dim": "#ffb59d",
                        "surface-container-highest": "#dce2f7",
                        "on-error-container": "#93000a",
                        "on-tertiary-container": "#422f00",
                        "surface-tint": "#9d4300",
                        "on-primary-container": "#582200",
                        "outline-variant": "#e0c0b1",
                        "secondary-fixed": "#ffdbd0",
                        "primary-container": "#f97316",
                        "surface-container-low": "#f1f3ff",
                        "primary-fixed": "#ffdbca",
                        "on-secondary-fixed": "#390c00",
                        "tertiary-fixed": "#ffdf9f",
                        "inverse-on-surface": "#edf0ff",
                        "on-surface": "#141b2b",
                        "outline": "#8c7164",
                        "on-secondary-fixed-variant": "#832600",
                        "surface-container-lowest": "#ffffff",
                        "surface-variant": "#dce2f7",
                        "primary": "#9d4300",
                        "surface-container-high": "#e1e8fd",
                        "on-tertiary": "#ffffff",
                        "secondary-container": "#fd6b36",
                        "tertiary": "#795900",
                        "error-container": "#ffdad6",
                        "on-primary-fixed": "#341100",
                        "tertiary-fixed-dim": "#f9bd22",
                        "error": "#ba1a1a",
                        "inverse-primary": "#ffb690",
                        "on-primary": "#ffffff",
                        "surface-dim": "#d3daef",
                        "inverse-surface": "#293040"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    "spacing": {
                        "sm": "12px",
                        "gutter": "12px",
                        "lg": "24px",
                        "xs": "8px",
                        "md": "16px",
                        "base": "4px",
                        "xl": "32px",
                        "margin": "16px"
                    },
                    "fontFamily": {
                        "h2": ["Inter"],
                        "label-md": ["Inter"],
                        "body-md": ["Inter"],
                        "h1": ["Inter"],
                        "h3": ["Inter"],
                        "body-lg": ["Inter"]
                    },
                    "fontSize": {
                        "h2": ["24px", {"lineHeight": "30px", "letterSpacing": "-0.01em", "fontWeight": "700"}],
                        "label-md": ["12px", {"lineHeight": "16px", "letterSpacing": "0.02em", "fontWeight": "500"}],
                        "body-md": ["14px", {"lineHeight": "20px", "fontWeight": "400"}],
                        "h1": ["28px", {"lineHeight": "34px", "letterSpacing": "-0.02em", "fontWeight": "700"}],
                        "h3": ["20px", {"lineHeight": "26px", "letterSpacing": "0em", "fontWeight": "700"}],
                        "body-lg": ["16px", {"lineHeight": "24px", "fontWeight": "400"}]
                    }
                }
            }
        }
    </script>
<style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        .bg-mesh {
            background-color: #f9f9ff;
            background-image: 
                radial-gradient(at 0% 0%, rgba(249, 115, 22, 0.05) 0px, transparent 50%),
                radial-gradient(at 100% 100%, rgba(249, 115, 22, 0.03) 0px, transparent 50%);
        }
    </style>
<style>
    body {
      min-height: max(884px, 100dvh);
    }
  </style>
  </head>
<body class="bg-surface-bright font-body-md text-on-surface antialiased min-h-screen flex flex-col items-center justify-center bg-mesh">
<!-- Top Navigation Suppression: Not rendered for transactional/permission flow -->
<main class="w-full max-w-md px-margin flex flex-col items-center justify-between min-h-[707px] py-xl">
<!-- Illustration Section -->
<div class="flex-1 flex flex-col items-center justify-center w-full">
<div class="relative w-64 h-64 mb-lg flex items-center justify-center">
<!-- Abstract Map Background -->
<div class="absolute inset-0 bg-surface-container-high rounded-full opacity-40 blur-3xl"></div>
<!-- Stylized Pin Illustration -->
<div class="relative z-10 bg-surface-container-lowest p-8 rounded-[40px] shadow-xl border border-surface-container flex items-center justify-center">
<div class="w-32 h-32 bg-primary-container/10 rounded-full flex items-center justify-center relative">
<!-- Pulsing Rings -->
<div class="absolute inset-0 bg-primary-container/20 rounded-full animate-ping opacity-20"></div>
<div class="absolute inset-4 bg-primary-container/30 rounded-full animate-pulse opacity-20"></div>
<span class="material-symbols-outlined text-primary-container !text-[64px]" style="font-variation-settings: 'FILL' 1;">
                            location_on
                        </span>
</div>
</div>
<!-- Floating Accents -->
<div class="absolute top-4 right-4 bg-white p-3 rounded-2xl shadow-lg border border-surface-container">
<span class="material-symbols-outlined text-secondary !text-2xl">construction</span>
</div>
<div class="absolute bottom-10 left-0 bg-white p-3 rounded-2xl shadow-lg border border-surface-container">
<span class="material-symbols-outlined text-tertiary-container !text-2xl">home_repair_service</span>
</div>
</div>
<!-- Text Content -->
<div class="text-center space-y-md">
<h1 class="font-h1 text-h1 text-on-background">
                    Allow location access
                </h1>
<p class="font-body-lg text-body-lg text-on-surface-variant px-md leading-relaxed">
                    We use your location to show you available tradespeople nearby. Your location is only shared with your consent.
                </p>
</div>
</div>
<!-- Action Buttons Section -->
<div class="w-full space-y-gutter mt-xl">
<button class="w-full h-12 bg-primary-container text-on-secondary rounded-xl font-h3 text-body-lg shadow-lg shadow-primary-container/20 active:scale-[0.98] transition-transform flex items-center justify-center gap-xs">
<span class="material-symbols-outlined !text-xl">my_location</span>
                Allow Location
            </button>
<button class="w-full h-12 bg-transparent text-primary-container border border-primary-container/20 rounded-xl font-label-md text-body-lg hover:bg-primary-container/5 active:scale-[0.98] transition-all">
                Set Manually
            </button>
</div>
<!-- Trust Indicator -->
<div class="mt-lg flex items-center gap-xs opacity-60">
<span class="material-symbols-outlined !text-sm">lock</span>
<span class="font-label-md text-on-surface-variant">Encrypted and private</span>
</div>
</main>
<!-- Bottom Navigation Suppression: Not rendered for focused journey -->
</body></html>