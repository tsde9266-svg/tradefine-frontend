<!DOCTYPE html>

<html class="light" lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>TradeFind - Map View</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script id="tailwind-config">
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            "colors": {
                    "surface-bright": "#f9f9ff",
                    "surface": "#f9f9ff",
                    "on-secondary": "#ffffff",
                    "on-tertiary-fixed-variant": "#5c4300",
                    "on-secondary-container": "#5d1900",
                    "on-background": "#141b2b",
                    "on-primary-fixed-variant": "#783200",
                    "tertiary-container": "#c49200",
                    "on-error": "#ffffff",
                    "background": "#f9f9ff",
                    "surface-container": "#e9edff",
                    "on-tertiary-fixed": "#261a00",
                    "on-surface-variant": "#584237",
                    "primary-fixed-dim": "#ffb690",
                    "secondary": "#ac3400",
                    "secondary-fixed-dim": "#ffb59d",
                    "surface-container-highest": "#dce2f7",
                    "on-error-container": "#93000a",
                    "on-tertiary-container": "#422f00",
                    "surface-tint": "#9d4300",
                    "on-primary-container": "#582200",
                    "outline-variant": "#e0c0b1",
                    "secondary-fixed": "#ffdbd0",
                    "primary-container": "#f97316",
                    "surface-container-low": "#f1f3ff",
                    "primary-fixed": "#ffdbca",
                    "on-secondary-fixed": "#390c00",
                    "tertiary-fixed": "#ffdf9f",
                    "inverse-on-surface": "#edf0ff",
                    "on-surface": "#141b2b",
                    "outline": "#8c7164",
                    "on-secondary-fixed-variant": "#832600",
                    "surface-container-lowest": "#ffffff",
                    "surface-variant": "#dce2f7",
                    "primary": "#9d4300",
                    "surface-container-high": "#e1e8fd",
                    "on-tertiary": "#ffffff",
                    "secondary-container": "#fd6b36",
                    "tertiary": "#795900",
                    "error-container": "#ffdad6",
                    "on-primary-fixed": "#341100",
                    "tertiary-fixed-dim": "#f9bd22",
                    "error": "#ba1a1a",
                    "inverse-primary": "#ffb690",
                    "on-primary": "#ffffff",
                    "surface-dim": "#d3daef",
                    "inverse-surface": "#293040"
            },
            "borderRadius": {
                    "DEFAULT": "0.25rem",
                    "lg": "0.5rem",
                    "xl": "0.75rem",
                    "full": "9999px"
            },
            "spacing": {
                    "sm": "12px",
                    "gutter": "12px",
                    "lg": "24px",
                    "xs": "8px",
                    "md": "16px",
                    "base": "4px",
                    "xl": "32px",
                    "margin": "16px"
            },
            "fontFamily": {
                    "h2": ["Inter"],
                    "label-md": ["Inter"],
                    "body-md": ["Inter"],
                    "h1": ["Inter"],
                    "h3": ["Inter"],
                    "body-lg": ["Inter"]
            },
            "fontSize": {
                    "h2": ["24px", {"lineHeight": "30px", "letterSpacing": "-0.01em", "fontWeight": "700"}],
                    "label-md": ["12px", {"lineHeight": "16px", "letterSpacing": "0.02em", "fontWeight": "500"}],
                    "body-md": ["14px", {"lineHeight": "20px", "fontWeight": "400"}],
                    "h1": ["28px", {"lineHeight": "34px", "letterSpacing": "-0.02em", "fontWeight": "700"}],
                    "h3": ["20px", {"lineHeight": "26px", "letterSpacing": "0em", "fontWeight": "700"}],
                    "body-lg": ["16px", {"lineHeight": "24px", "fontWeight": "400"}]
            }
          },
        },
      }
    </script>
<style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        body { font-family: 'Inter', sans-serif; }
        .map-container { position: relative; height: 100vh; width: 100%; overflow: hidden; background-color: #e5e7eb; }
        .glass-panel { background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(8px); }
        .hide-scrollbar::-webkit-scrollbar { display: none; }
        .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    </style>
<style>
    body {
      min-height: max(884px, 100dvh);
    }
  </style>
  </head>
<body class="bg-surface-bright text-on-surface">
<!-- Top Navigation Shell -->
<header class="sticky top-0 z-50 flex justify-between items-center w-full px-4 h-16 bg-[#F9FAFB] dark:bg-slate-950 border-b border-slate-200 dark:border-slate-800 font-['Inter'] antialiased tracking-tight">
<div class="flex items-center gap-3">
<button class="material-symbols-outlined text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800 p-2 rounded-full transition-colors active:scale-95 duration-150" data-icon="menu">menu</button>
<h1 class="text-2xl font-black text-orange-600 dark:text-orange-500">TradeFind</h1>
</div>
<div class="flex items-center gap-4">
<div class="hidden md:flex items-center space-x-6 mr-6">
<a class="text-slate-500 dark:text-slate-400 font-medium hover:text-orange-600 transition-colors" href="#">Home</a>
<a class="text-orange-600 dark:text-orange-500 font-bold" href="#">Map</a>
<a class="text-slate-500 dark:text-slate-400 font-medium hover:text-orange-600 transition-colors" href="#">Bookmarks</a>
<a class="text-slate-500 dark:text-slate-400 font-medium hover:text-orange-600 transition-colors" href="#">Profile</a>
</div>
<img alt="Profile" class="w-10 h-10 rounded-full border-2 border-orange-100 object-cover" data-alt="professional headshot of a friendly smiling middle-aged male tradesperson against a clean studio background" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBlWqTmZnitLasg1PYct0KtXmF2m2DM8f7IGoe58hCpMwccfnj3zGp-XxANaGFVtllJeN98-Hb8s7TCtU-4qWb6vKYpRaYcvwDfBausjcvy7RieA7yYi59lb__lt-UAtz-0aYoxkzZzjZarLIu2knOQewhkXDPX2oJRrTrNp7XZU7ENdIF3-FfeWJGoEbxF7JmrugYpqNBZ_RwP3UNLJUJxDfTG1c_XgPPQrl6IoODsnDaZ0ocP0wRKTM-R3FFllS-8YtfL3lBu-aI"/>
</div>
</header>
<main class="map-container">
<!-- Full-screen Map Background -->
<div class="absolute inset-0 z-0">
<img class="w-full h-full object-cover grayscale opacity-80" data-alt="clean minimalist map graphic of Birmingham city centre with simplified streets and landmarks in a light gray aesthetic" data-location="Birmingham, UK" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBTHp0gBHO757VDQceJq1iuuC_RHBL0nhfsS8j-u8242MkOAw_VBZ-xVLu0_ekq3srlaqh9phuMz4QihUxgPJKdJDydqn62Uo-trmn-YOcVgJ8CJjcGzZ82dJ4ReSk1p4xz14UkSAXY3sswnje6nz3EvYrKQ7i4EN2d8lPkR1zIhWJbx0rCmUmMWEct_avGw_DXgpKcy5waULtL4HRAVr5gobrDjx9ITWU7YNT4MZfp2r5cgRxxMa3NS_BRISul8fEAik4fRo0atPs"/>
</div>
<!-- Floating Search Bar -->
<div class="absolute top-4 left-0 right-0 z-10 px-4 max-w-lg mx-auto">
<div class="glass-panel flex items-center px-4 py-3 rounded-xl shadow-lg border border-white/50">
<span class="material-symbols-outlined text-orange-600 mr-3" data-icon="search">search</span>
<input class="bg-transparent border-none focus:ring-0 text-body-md font-body-md w-full placeholder-slate-400" placeholder="Search for plumbers, electricians..." type="text"/>
<div class="h-6 w-px bg-slate-200 mx-2"></div>
<span class="material-symbols-outlined text-slate-400" data-icon="tune">tune</span>
</div>
</div>
<!-- Map Pins (Custom UI Elements) -->
<!-- Pin 1: Bullring Area -->
<div class="absolute top-[40%] left-[45%] z-20 group">
<div class="flex flex-col items-center cursor-pointer transition-transform group-hover:scale-110">
<div class="relative w-12 h-12 bg-orange-600 rounded-full p-1 border-2 border-white shadow-xl">
<img class="w-full h-full rounded-full object-cover" data-alt="close-up portrait of a professional electrician in a navy polo shirt with a friendly expression" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAaC98j4Ow5wdd3SBHuzFh9thY6lSIJrlRfIoqF-lda1v11evCvmEQeWPg647e0Obvj4KBO9w9u4VlFgDXLGQzwLtUovsxlQa1EUFmDNqYUylENwC0FMen2EZbXYo5KKiUVS7Vx4YYCQ8J90pfItVUr_yZD9QNWaWMG_FV-9a2H5fiaUspu8GyY0BpQKniJbb5tdMgQ5_htAXO8WJktKa8Os3-gE7ucdIGRJt1eJCEqE-pAiP3wL0XhHz7t_37_TlwaH5drgSG9Udw"/>
<div class="absolute -top-1 -right-1 bg-white w-5 h-5 rounded-full flex items-center justify-center shadow-md">
<span class="material-symbols-outlined text-[12px] text-orange-600 font-bold" data-icon="electric_bolt" style="font-variation-settings: 'FILL' 1;">electric_bolt</span>
</div>
</div>
<div class="w-0 h-0 border-l-[8px] border-l-transparent border-r-[8px] border-r-transparent border-t-[10px] border-t-orange-600 -mt-1 shadow-2xl"></div>
</div>
</div>
<!-- Pin 2: Jewelry Quarter -->
<div class="absolute top-[25%] left-[30%] z-20 group">
<div class="flex flex-col items-center cursor-pointer transition-transform group-hover:scale-110">
<div class="relative w-12 h-12 bg-orange-600 rounded-full p-1 border-2 border-white shadow-xl">
<img class="w-full h-full rounded-full object-cover" data-alt="professional headshot of a plumber wearing a branded grey hoodie outdoors" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAS9BhtkJaGSVqvByh7YEpxKRxFiQ2hiQ-tlO6DUbFJTAFnTB7fSJQ-QGrTbQYCnuQu3qNCzfaQ84pMDR590rBGn14fIrswfM96c-uuRcSbuPHGPc4yWueRO-hB4R_j-tg4bhiOfl8vAxEu8lCxGYcuUH2DSl3A4qTgaNLKI-S_5HMPem-Q8s7-FJ_3dFeou8sbiIz4zyVIlQyQe0IyBkqx0yD8y8n2XxCzjtnb8lnGUH1LJ9FlALsC_ldCj1kDDdhneEzJqrUaqBA"/>
<div class="absolute -top-1 -right-1 bg-white w-5 h-5 rounded-full flex items-center justify-center shadow-md">
<span class="material-symbols-outlined text-[12px] text-orange-600 font-bold" data-icon="plumbing" style="font-variation-settings: 'FILL' 1;">plumbing</span>
</div>
</div>
<div class="w-0 h-0 border-l-[8px] border-l-transparent border-r-[8px] border-r-transparent border-t-[10px] border-t-orange-600 -mt-1 shadow-2xl"></div>
</div>
</div>
<!-- Pin 3: Edgbaston Area -->
<div class="absolute top-[65%] left-[35%] z-20 group">
<div class="flex flex-col items-center cursor-pointer transition-transform group-hover:scale-110">
<div class="relative w-12 h-12 bg-orange-600 rounded-full p-1 border-2 border-white shadow-xl">
<img class="w-full h-full rounded-full object-cover" data-alt="confident professional joiner standing in a well-lit workshop with tools visible in the background" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBRLSDFGPp9421Y8iIe88TnA1wb1RJ3vjBbRJ50QAgRp6IprpYOUuu2BGschd096b24ul3O3RqLvPisSBvmHKGZbR9gs5emwQ37TFgxZF-0shyFtyvj1Prs3nRD3KhHxkkUXpNhJe5GwKxo2nT4bQa-OBZUFMmbsRgFRv3JZVv3D2YJabbDAj3vTeSpOnm9aG4NbxJHDNbsBDOJOcZ-o_hi2hKEGZDjMERRvoxlOb1krY15DpkHX8FnbnFuFAYeAfqr0I1zcMCXkdE"/>
<div class="absolute -top-1 -right-1 bg-white w-5 h-5 rounded-full flex items-center justify-center shadow-md">
<span class="material-symbols-outlined text-[12px] text-orange-600 font-bold" data-icon="handyman" style="font-variation-settings: 'FILL' 1;">handyman</span>
</div>
</div>
<div class="w-0 h-0 border-l-[8px] border-l-transparent border-r-[8px] border-r-transparent border-t-[10px] border-t-orange-600 -mt-1 shadow-2xl"></div>
</div>
</div>
<!-- Filter FAB -->
<button class="absolute bottom-40 right-6 z-30 w-14 h-14 bg-primary-container text-white rounded-full flex items-center justify-center shadow-[0_4px_20px_rgba(249,115,22,0.4)] active:scale-95 transition-transform">
<span class="material-symbols-outlined text-2xl" data-icon="filter_list">filter_list</span>
</button>
<!-- Bottom Sheet (Partial) -->
<div class="absolute bottom-16 left-0 right-0 z-40">
<div class="bg-white rounded-t-3xl shadow-[0_-8px_30px_rgba(0,0,0,0.1)] pt-4 pb-12 overflow-hidden border-t border-slate-100">
<div class="w-12 h-1.5 bg-slate-200 rounded-full mx-auto mb-6"></div>
<div class="px-6 mb-4 flex justify-between items-center">
<h2 class="font-h3 text-h3 text-on-surface">12 tradespeople near you</h2>
<span class="text-orange-600 text-body-md font-bold cursor-pointer">View List</span>
</div>
<div class="flex overflow-x-auto gap-4 px-6 hide-scrollbar snap-x">
<!-- Worker Card 1 -->
<div class="min-w-[280px] bg-white rounded-2xl border border-slate-100 p-4 shadow-sm snap-start">
<div class="flex items-start gap-3">
<img class="w-16 h-16 rounded-xl object-cover" data-alt="professional profile photo of an electrician on a clean white background" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDCxBz1FlvJVxUUR2Z1WzeYblG7fMsGu8QsemQWJg6Db3DJQbLycF36BHm2CyJ-9dmYHJ6wGpbrzd9WZ4AH4bo_KPCEyhCF223qeog6NS9aR-BtOX4mhMhfIUwanFe_2gzggDInluIXRJU8X-AfjytzNtFq8w7xOO97jebCAn5DzfvnpWDct91xpDcQ5jWRAo9mfixgqfK8633kQukEEHpy4W_w8bxJ_VTy-Rdv6Z8N_ULoL_bHtQVW-_xPjDpE63dL8DcDvn_Q5-k"/>
<div class="flex-1">
<div class="flex justify-between">
<span class="bg-green-100 text-green-700 text-[10px] font-bold px-2 py-0.5 rounded-full mb-1 inline-block">AVAILABLE</span>
<span class="material-symbols-outlined text-slate-300 text-lg" data-icon="bookmark">bookmark</span>
</div>
<h3 class="font-bold text-on-surface">David Wilson</h3>
<p class="text-slate-500 text-body-md">Master Electrician</p>
</div>
</div>
<div class="flex items-center justify-between mt-4 pt-3 border-t border-slate-50">
<div class="flex items-center gap-1">
<span class="material-symbols-outlined text-[#FBBF24] text-lg" data-icon="star" style="font-variation-settings: 'FILL' 1;">star</span>
<span class="font-bold text-body-md">4.9</span>
<span class="text-slate-400 text-[12px]">(124)</span>
</div>
<span class="text-on-surface font-bold text-body-md">£45/hr</span>
</div>
</div>
<!-- Worker Card 2 -->
<div class="min-w-[280px] bg-white rounded-2xl border border-slate-100 p-4 shadow-sm snap-start">
<div class="flex items-start gap-3">
<img class="w-16 h-16 rounded-xl object-cover" data-alt="profile portrait of a plumber in working attire" src="https://lh3.googleusercontent.com/aida-public/AB6AXuB0IyL5lCyj8yelotilGHBXXL6bDvRNoRsUdoSujVSSoanJuRyjWmwY5NeShwXx7auCF2pFVevF5cZ7k46cSqm2HURkrGJyFd0UOiwahmzAeIVNS4y3kXCKi8vuqCR44S356FlVye62CFQCetIPVWxTWvk38ix5mNm0ghADjesbgbU-nTlwLkN-YlPdFTIbBnX2F4ilivH7GZvS9vWd88t-aIDKgKdLwYnoFjBfMZ8eKfUgA9vuWZULd0ksQGVc6j12zoa-_6X7nY4"/>
<div class="flex-1">
<div class="flex justify-between">
<span class="bg-green-100 text-green-700 text-[10px] font-bold px-2 py-0.5 rounded-full mb-1 inline-block">AVAILABLE</span>
<span class="material-symbols-outlined text-slate-300 text-lg" data-icon="bookmark">bookmark</span>
</div>
<h3 class="font-bold text-on-surface">Sarah James</h3>
<p class="text-slate-500 text-body-md">Licensed Plumber</p>
</div>
</div>
<div class="flex items-center justify-between mt-4 pt-3 border-t border-slate-50">
<div class="flex items-center gap-1">
<span class="material-symbols-outlined text-[#FBBF24] text-lg" data-icon="star" style="font-variation-settings: 'FILL' 1;">star</span>
<span class="font-bold text-body-md">4.8</span>
<span class="text-slate-400 text-[12px]">(89)</span>
</div>
<span class="text-on-surface font-bold text-body-md">£50/hr</span>
</div>
</div>
<!-- Worker Card 3 -->
<div class="min-w-[280px] bg-white rounded-2xl border border-slate-100 p-4 shadow-sm snap-start">
<div class="flex items-start gap-3">
<img class="w-16 h-16 rounded-xl object-cover" data-alt="professional portrait of a carpenter in a workshop" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDLpr7YDqkRoDl0plmQtua06JAfT2cHh0p-xcRqmXaAz01Oz7IqtBFR_kBi44oeYnVtZK8M7VDiYZNRo2pDamlSuEBttFnmapR5g1QN9duT-TtAuh3PRiEcGEuNfyb0OEgtJcXhi9tGI0m5Va495iVCw7_dl7focHDEJmmc1OtCR1VlaLHYuWq2OFFwBN1Xv79IxRgkbM4PiFwt5bxf851c6OQrAQhivM_LvI4DPZr50dn7Wqm7-y1Py1h9BkyUlHfPHT2H0FMEHT8"/>
<div class="flex-1">
<div class="flex justify-between">
<span class="bg-green-100 text-green-700 text-[10px] font-bold px-2 py-0.5 rounded-full mb-1 inline-block">AVAILABLE</span>
<span class="material-symbols-outlined text-slate-300 text-lg" data-icon="bookmark">bookmark</span>
</div>
<h3 class="font-bold text-on-surface">Mark Thompson</h3>
<p class="text-slate-500 text-body-md">Expert Carpenter</p>
</div>
</div>
<div class="flex items-center justify-between mt-4 pt-3 border-t border-slate-50">
<div class="flex items-center gap-1">
<span class="material-symbols-outlined text-[#FBBF24] text-lg" data-icon="star" style="font-variation-settings: 'FILL' 1;">star</span>
<span class="font-bold text-body-md">5.0</span>
<span class="text-slate-400 text-[12px]">(56)</span>
</div>
<span class="text-on-surface font-bold text-body-md">£55/hr</span>
</div>
</div>
</div>
</div>
</div>
</main>
<!-- Bottom Navigation Bar -->
<nav class="fixed bottom-0 left-0 w-full z-50 flex justify-around items-center h-16 bg-white dark:bg-slate-900 px-2 pb-safe border-t border-slate-100 dark:border-slate-800 shadow-[0_-2px_8px_rgba(0,0,0,0.08)]">
<button class="flex flex-col items-center justify-center text-slate-400 dark:text-slate-500 hover:text-orange-500 dark:hover:text-orange-400 transition-transform active:scale-90 tap-highlight-transparent">
<span class="material-symbols-outlined" data-icon="home">home</span>
<span class="font-['Inter'] text-[12px] font-medium">Home</span>
</button>
<button class="flex flex-col items-center justify-center text-orange-600 dark:text-orange-500 bg-orange-50/50 dark:bg-orange-900/20 rounded-xl px-3 py-1 transition-transform active:scale-90 tap-highlight-transparent">
<span class="material-symbols-outlined" data-icon="map" style="font-variation-settings: 'FILL' 1;">map</span>
<span class="font-['Inter'] text-[12px] font-medium">Map</span>
</button>
<button class="flex flex-col items-center justify-center text-slate-400 dark:text-slate-500 hover:text-orange-500 dark:hover:text-orange-400 transition-transform active:scale-90 tap-highlight-transparent">
<span class="material-symbols-outlined" data-icon="bookmark">bookmark</span>
<span class="font-['Inter'] text-[12px] font-medium">Bookmarks</span>
</button>
<button class="flex flex-col items-center justify-center text-slate-400 dark:text-slate-500 hover:text-orange-500 dark:hover:text-orange-400 transition-transform active:scale-90 tap-highlight-transparent">
<span class="material-symbols-outlined" data-icon="person">person</span>
<span class="font-['Inter'] text-[12px] font-medium">Profile</span>
</button>
</nav>
</body></html>