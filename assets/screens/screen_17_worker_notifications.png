<!DOCTYPE html>

<html class="light" lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>Worker Notifications - TradeFind</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "tertiary-fixed": "#ffdf9f",
                        "surface-tint": "#9d4300",
                        "surface-container-low": "#f1f3ff",
                        "tertiary-container": "#c49200",
                        "surface-container-high": "#e1e8fd",
                        "on-secondary-fixed-variant": "#832600",
                        "on-primary": "#ffffff",
                        "secondary-fixed": "#ffdbd0",
                        "on-secondary": "#ffffff",
                        "on-primary-container": "#582200",
                        "secondary": "#ac3400",
                        "on-secondary-container": "#5d1900",
                        "on-background": "#141b2b",
                        "surface-dim": "#d3daef",
                        "outline": "#8c7164",
                        "on-error": "#ffffff",
                        "surface-variant": "#dce2f7",
                        "error": "#ba1a1a",
                        "surface-container-lowest": "#ffffff",
                        "primary-fixed": "#ffdbca",
                        "primary": "#9d4300",
                        "on-tertiary-fixed-variant": "#5c4300",
                        "tertiary": "#795900",
                        "surface-container": "#e9edff",
                        "primary-fixed-dim": "#ffb690",
                        "on-tertiary-fixed": "#261a00",
                        "on-error-container": "#93000a",
                        "background": "#f9f9ff",
                        "surface": "#f9f9ff",
                        "secondary-container": "#fd6b36",
                        "on-surface-variant": "#584237",
                        "outline-variant": "#e0c0b1",
                        "on-surface": "#141b2b",
                        "inverse-on-surface": "#edf0ff",
                        "on-secondary-fixed": "#390c00",
                        "error-container": "#ffdad6",
                        "inverse-surface": "#293040",
                        "secondary-fixed-dim": "#ffb59d",
                        "on-primary-fixed-variant": "#783200",
                        "tertiary-fixed-dim": "#f9bd22",
                        "primary-container": "#f97316",
                        "on-tertiary-container": "#422f00",
                        "on-primary-fixed": "#341100",
                        "inverse-primary": "#ffb690",
                        "on-tertiary": "#ffffff",
                        "surface-container-highest": "#dce2f7",
                        "surface-bright": "#f9f9ff"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    "spacing": {
                        "margin": "16px",
                        "xs": "8px",
                        "lg": "24px",
                        "gutter": "12px",
                        "xl": "32px",
                        "sm": "12px",
                        "base": "4px",
                        "md": "16px"
                    },
                    "fontFamily": {
                        "label-md": ["Inter"],
                        "h2": ["Inter"],
                        "body-lg": ["Inter"],
                        "h3": ["Inter"],
                        "h1": ["Inter"],
                        "body-md": ["Inter"]
                    },
                    "fontSize": {
                        "label-md": ["12px", {"lineHeight": "16px", "letterSpacing": "0.02em", "fontWeight": "500"}],
                        "h2": ["24px", {"lineHeight": "30px", "letterSpacing": "-0.01em", "fontWeight": "700"}],
                        "body-lg": ["16px", {"lineHeight": "24px", "fontWeight": "400"}],
                        "h3": ["20px", {"lineHeight": "26px", "letterSpacing": "0em", "fontWeight": "700"}],
                        "h1": ["28px", {"lineHeight": "34px", "letterSpacing": "-0.02em", "fontWeight": "700"}],
                        "body-md": ["14px", {"lineHeight": "20px", "fontWeight": "400"}]
                    }
                },
            },
        }
    </script>
<style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        body {
            background-color: #f9f9ff;
            color: #141b2b;
            font-family: 'Inter', sans-serif;
        }
    </style>
<style>
    body {
      min-height: max(884px, 100dvh);
    }
  </style>
  </head>
<body class="bg-surface text-on-surface">
<!-- TopAppBar -->
<header class="fixed top-0 left-0 w-full z-50 flex justify-between items-center px-4 h-16 bg-white dark:bg-gray-900 border-b border-gray-100 dark:border-gray-800 shadow-sm">
<div class="flex items-center gap-3">
<div class="w-10 h-10 rounded-full overflow-hidden border-2 border-primary-container">
<img alt="Worker profile photo" class="w-full h-full object-cover" data-alt="Close-up portrait of a professional electrician in his 30s wearing a blue work shirt, smiling confidently, soft indoor lighting" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBhus5G-ThRc47pgwxVil797Y3_sReu7ZDmY9RDXHpFHvqmm23J3oLv0dp2TdNiKim2jwMA8Xw-1BMhWcT0scvFErbQZW2GriDSFTRTh5Em1oh35OSV1C9s-yOgJ5OAiW6aMxqoHTEhSkebuQRXXiGWqcCOuXKska6VLfmxb15UOKzgcLtofMG9OyVdtNW0i63hdu3OKgTCcHRz2hinyN_ZxY7HIZAudxKP5R-NXj1n0wk-aITtG8toDMTuaJZ7oar-ChKN8kki61k"/>
</div>
<span class="text-xl font-black tracking-tight text-orange-600 dark:text-orange-500">TradeFind</span>
</div>
<div class="flex items-center gap-4">
<button class="text-orange-600 font-bold text-label-md font-label-md active:scale-95 transition-all duration-200">Mark all as read</button>
<div class="relative active:scale-95 transition-all duration-200">
<span class="material-symbols-outlined text-orange-600 dark:text-orange-500" data-icon="notifications">notifications</span>
<span class="absolute top-0 right-0 w-2 h-2 bg-error rounded-full border border-white"></span>
</div>
</div>
</header>
<!-- Main Content -->
<main class="pt-24 pb-24 px-4 max-w-2xl mx-auto min-h-screen">
<div class="mb-6">
<h1 class="font-h1 text-h1 text-on-surface">Notifications</h1>
<p class="font-body-md text-body-md text-on-surface-variant">Stay updated with your latest job activity</p>
</div>
<div class="space-y-gutter">
<!-- Notification 1: Unread -->
<div class="bg-surface-container-lowest p-md rounded-xl shadow-[0_2px_8px_rgba(0,0,0,0.08)] border-l-4 border-primary-container flex gap-4 active:scale-[0.98] transition-all">
<div class="w-12 h-12 rounded-full bg-primary-fixed flex items-center justify-center flex-shrink-0">
<span class="material-symbols-outlined text-primary" data-icon="phone_callback">phone_callback</span>
</div>
<div class="flex-grow">
<div class="flex justify-between items-start">
<h3 class="font-h3 text-body-lg font-bold text-on-surface">Sarah Mitchell called you</h3>
<span class="font-label-md text-label-md text-on-surface-variant">2h ago</span>
</div>
<p class="font-body-md text-body-md text-on-surface-variant mt-1">Missed call regarding the kitchen renovation project in Brooklyn.</p>
<div class="mt-3 flex gap-2">
<button class="px-4 py-2 bg-primary-container text-on-primary rounded-lg font-label-md text-label-md active:opacity-70 transition-all">Call Back</button>
<button class="px-4 py-2 border border-outline-variant text-on-surface rounded-lg font-label-md text-label-md active:bg-surface-container-high transition-all">Message</button>
</div>
</div>
</div>
<!-- Notification 2: Read -->
<div class="bg-surface-container-lowest p-md rounded-xl shadow-[0_2px_8px_rgba(0,0,0,0.08)] flex gap-4 active:scale-[0.98] transition-all">
<div class="w-12 h-12 rounded-full bg-tertiary-fixed flex items-center justify-center flex-shrink-0">
<span class="material-symbols-outlined text-tertiary" data-icon="star" data-weight="fill" style="font-variation-settings: 'FILL' 1;">star</span>
</div>
<div class="flex-grow">
<div class="flex justify-between items-start">
<h3 class="font-h3 text-body-lg font-bold text-on-surface opacity-80">New review: 5 stars from Tom Harris</h3>
<span class="font-label-md text-label-md text-on-surface-variant">1d ago</span>
</div>
<p class="font-body-md text-body-md text-on-surface-variant mt-1">"Excellent work on the electrical panel. Very professional and tidy."</p>
<div class="mt-3 flex items-center gap-1">
<span class="material-symbols-outlined text-[#FBBF24] text-sm" data-icon="star" data-weight="fill" style="font-variation-settings: 'FILL' 1;">star</span>
<span class="material-symbols-outlined text-[#FBBF24] text-sm" data-icon="star" data-weight="fill" style="font-variation-settings: 'FILL' 1;">star</span>
<span class="material-symbols-outlined text-[#FBBF24] text-sm" data-icon="star" data-weight="fill" style="font-variation-settings: 'FILL' 1;">star</span>
<span class="material-symbols-outlined text-[#FBBF24] text-sm" data-icon="star" data-weight="fill" style="font-variation-settings: 'FILL' 1;">star</span>
<span class="material-symbols-outlined text-[#FBBF24] text-sm" data-icon="star" data-weight="fill" style="font-variation-settings: 'FILL' 1;">star</span>
</div>
</div>
</div>
<!-- Notification 3: Read -->
<div class="bg-surface-container-lowest p-md rounded-xl shadow-[0_2px_8px_rgba(0,0,0,0.08)] flex gap-4 active:scale-[0.98] transition-all">
<div class="w-12 h-12 rounded-full bg-surface-container-high flex items-center justify-center flex-shrink-0">
<span class="material-symbols-outlined text-primary" data-icon="verified" data-weight="fill" style="font-variation-settings: 'FILL' 1;">verified</span>
</div>
<div class="flex-grow">
<div class="flex justify-between items-start">
<h3 class="font-h3 text-body-lg font-bold text-on-surface opacity-80">Account Approved</h3>
<span class="font-label-md text-label-md text-on-surface-variant">3d ago</span>
</div>
<p class="font-body-md text-body-md text-on-surface-variant mt-1">Your professional credentials have been verified. You can now accept high-value contracts.</p>
</div>
</div>
<!-- Empty State Suggestion for more depth -->
<div class="py-xl flex flex-col items-center justify-center opacity-40">
<div class="w-24 h-1 bg-surface-container-high rounded-full"></div>
<p class="font-label-md text-label-md mt-4 uppercase tracking-widest">End of Recent Activity</p>
</div>
</div>
</main>
<!-- BottomNavBar -->
<nav class="fixed bottom-0 left-0 w-full z-50 flex justify-around items-center h-16 pb-safe px-6 bg-white dark:bg-gray-900 rounded-t-xl border-t border-gray-100 dark:border-gray-800 shadow-[0_-2px_10px_rgba(0,0,0,0.05)]">
<button class="flex flex-col items-center justify-center text-gray-400 dark:text-gray-500 hover:text-orange-400 tap-highlight-transparent active:opacity-70 transition-transform">
<span class="material-symbols-outlined" data-icon="work">work</span>
<span class="font-['Inter'] text-[10px] font-medium">Jobs</span>
</button>
<button class="flex flex-col items-center justify-center text-orange-600 dark:text-orange-500 scale-110 hover:text-orange-400 tap-highlight-transparent active:opacity-70 transition-transform">
<div class="relative">
<span class="material-symbols-outlined" data-icon="chat_bubble">chat_bubble</span>
<span class="absolute -top-1 -right-1 w-2 h-2 bg-error rounded-full"></span>
</div>
<span class="font-['Inter'] text-[10px] font-medium">Messages</span>
</button>
<button class="flex flex-col items-center justify-center text-gray-400 dark:text-gray-500 hover:text-orange-400 tap-highlight-transparent active:opacity-70 transition-transform">
<span class="material-symbols-outlined" data-icon="calendar_today">calendar_today</span>
<span class="font-['Inter'] text-[10px] font-medium">Schedule</span>
</button>
<button class="flex flex-col items-center justify-center text-gray-400 dark:text-gray-500 hover:text-orange-400 tap-highlight-transparent active:opacity-70 transition-transform">
<span class="material-symbols-outlined" data-icon="person">person</span>
<span class="font-['Inter'] text-[10px] font-medium">Profile</span>
</button>
</nav>
</body></html>