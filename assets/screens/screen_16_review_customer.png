<!DOCTYPE html>

<html class="light" lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0, viewport-fit=cover" name="viewport"/>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          "colors": {
            "tertiary-fixed": "#ffdf9f",
            "surface-tint": "#9d4300",
            "surface-container-low": "#f1f3ff",
            "tertiary-container": "#c49200",
            "surface-container-high": "#e1e8fd",
            "on-secondary-fixed-variant": "#832600",
            "on-primary": "#ffffff",
            "secondary-fixed": "#ffdbd0",
            "on-secondary": "#ffffff",
            "on-primary-container": "#582200",
            "secondary": "#ac3400",
            "on-secondary-container": "#5d1900",
            "on-background": "#141b2b",
            "surface-dim": "#d3daef",
            "outline": "#8c7164",
            "on-error": "#ffffff",
            "surface-variant": "#dce2f7",
            "error": "#ba1a1a",
            "surface-container-lowest": "#ffffff",
            "primary-fixed": "#ffdbca",
            "primary": "#9d4300",
            "on-tertiary-fixed-variant": "#5c4300",
            "tertiary": "#795900",
            "surface-container": "#e9edff",
            "primary-fixed-dim": "#ffb690",
            "on-tertiary-fixed": "#261a00",
            "on-error-container": "#93000a",
            "background": "#f9f9ff",
            "surface": "#f9f9ff",
            "secondary-container": "#fd6b36",
            "on-surface-variant": "#584237",
            "outline-variant": "#e0c0b1",
            "on-surface": "#141b2b",
            "inverse-on-surface": "#edf0ff",
            "on-secondary-fixed": "#390c00",
            "error-container": "#ffdad6",
            "inverse-surface": "#293040",
            "secondary-fixed-dim": "#ffb59d",
            "on-primary-fixed-variant": "#783200",
            "tertiary-fixed-dim": "#f9bd22",
            "primary-container": "#f97316",
            "on-tertiary-container": "#422f00",
            "on-primary-fixed": "#341100",
            "inverse-primary": "#ffb690",
            "on-tertiary": "#ffffff",
            "surface-container-highest": "#dce2f7",
            "surface-bright": "#f9f9ff"
          },
          "borderRadius": {
            "DEFAULT": "0.25rem",
            "lg": "0.5rem",
            "xl": "0.75rem",
            "full": "9999px"
          },
          "spacing": {
            "margin": "16px",
            "xs": "8px",
            "lg": "24px",
            "gutter": "12px",
            "xl": "32px",
            "sm": "12px",
            "base": "4px",
            "md": "16px"
          },
          "fontFamily": {
            "label-md": ["Inter"],
            "h2": ["Inter"],
            "body-lg": ["Inter"],
            "h3": ["Inter"],
            "h1": ["Inter"],
            "body-md": ["Inter"]
          },
          "fontSize": {
            "label-md": ["12px", {"lineHeight": "16px", "letterSpacing": "0.02em", "fontWeight": "500"}],
            "h2": ["24px", {"lineHeight": "30px", "letterSpacing": "-0.01em", "fontWeight": "700"}],
            "body-lg": ["16px", {"lineHeight": "24px", "fontWeight": "400"}],
            "h3": ["20px", {"lineHeight": "26px", "letterSpacing": "0em", "fontWeight": "700"}],
            "h1": ["28px", {"lineHeight": "34px", "letterSpacing": "-0.02em", "fontWeight": "700"}],
            "body-md": ["14px", {"lineHeight": "20px", "fontWeight": "400"}]
          }
        },
      },
    }
  </script>
<style>
    .material-symbols-outlined {
      font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    }
    .star-active {
      font-variation-settings: 'FILL' 1;
      color: #FBBF24;
    }
    .tap-highlight-transparent {
      -webkit-tap-highlight-color: transparent;
    }
  </style>
<style>
    body {
      min-height: max(884px, 100dvh);
    }
  </style>
  </head>
<body class="bg-surface text-on-surface font-body-md antialiased min-h-screen">
<!-- TopAppBar Component (from JSON) -->
<header class="fixed top-0 left-0 w-full z-50 flex justify-between items-center px-4 h-16 bg-white dark:bg-gray-900 border-b border-gray-100 dark:border-gray-800 shadow-sm">
<div class="flex items-center gap-3">
<div class="w-8 h-8 rounded-full overflow-hidden bg-surface-container-high">
<img alt="Worker profile photo" class="w-full h-full object-cover" data-alt="Professional tradesperson headshot with a friendly smile, wearing a clean work polo shirt in a bright studio setting" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCMOPGI8ddz9s1jVBFZq874_cjm2Ui2ly49SKIeo6IvxMZtN0P4bARnaVJjhLbTVxKsPFRedQPmD2u1b0S5kPMTucp4OHbbOTSQikoU0b0Z0nk8wXm_MF3Z809JNlgqorEvLJQ6u_elUiQgrlNEMAo7ohjsDzyDtnXBK9MzT_ZlJ0l_TVwAyb5p6n5IKwXQsPnpjFHWxniDhA-WlN2gPuvLHUQkgLCHDr-7I8SZ0aQGXBsknZQy6Ceq7l4wYGfQTlC1oWD50EWnTnI"/>
</div>
<span class="text-xl font-black tracking-tight text-orange-600 dark:text-orange-500">TradeFind</span>
</div>
<div class="flex items-center gap-4">
<button class="material-symbols-outlined text-gray-500 hover:bg-gray-50 p-2 rounded-full transition-all active:scale-95" data-icon="notifications">notifications</button>
</div>
</header>
<main class="pt-20 pb-24 px-margin max-w-lg mx-auto">
<!-- Back Button / Context -->
<div class="mb-lg">
<button class="flex items-center text-primary font-label-md text-label-md gap-1 active:scale-95 transition-transform">
<span class="material-symbols-outlined text-[18px]" data-icon="arrow_back">arrow_back</span>
        Back to Dashboard
      </button>
</div>
<!-- Review Form Container -->
<section class="bg-surface-container-lowest rounded-xl shadow-[0_2px_8px_rgba(0,0,0,0.08)] overflow-hidden">
<!-- Customer Identity -->
<div class="p-md bg-surface-container-low flex flex-col items-center text-center border-b border-outline-variant">
<div class="w-20 h-20 rounded-full border-4 border-white shadow-sm overflow-hidden mb-sm">
<img alt="Customer Sarah Mitchell" class="w-full h-full object-cover" data-alt="Close-up portrait of a cheerful woman with brown hair in her 30s, natural daylight, soft blurred home background" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAbFS9PPp09fqjUoY5iOzyTTfo0muSlgZkqM4nUuvPNM-xFP0l-xASVT9D034SchIK9huCexBIKHaH_dQLn1BrKnlSbLjEJSsYgCY02ItTOxrvo8SmfPShkk0PG6qv4VPqvcrMjyXI6h82GB86-xdw5GD1yoEE4m_ryb3ljhr-4mIt168T_alxqfGaEK_2fsqs6KJg1pkbNAnetZGBFH_IXEtiRd8zJ5UBCiSLEPBIipmYtj3BFDt5VbIx4esfuSRsa3ZN9pdoq6_g"/>
</div>
<h1 class="font-h2 text-h2 text-on-surface mb-xs">How was Sarah Mitchell as a customer?</h1>
<p class="font-body-md text-body-md text-on-surface-variant max-w-[280px]">Your feedback helps the community grow and improves trust for other tradespeople.</p>
</div>
<div class="p-md space-y-xl">
<!-- Star Rating Selector -->
<div class="flex flex-col items-center gap-md">
<label class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wider">Rating Selection</label>
<div class="flex gap-xs">
<button class="tap-highlight-transparent active:scale-90 transition-transform">
<span class="material-symbols-outlined text-[48px] star-active" data-icon="star" style="font-variation-settings: 'FILL' 1;">star</span>
</button>
<button class="tap-highlight-transparent active:scale-90 transition-transform">
<span class="material-symbols-outlined text-[48px] star-active" data-icon="star" style="font-variation-settings: 'FILL' 1;">star</span>
</button>
<button class="tap-highlight-transparent active:scale-90 transition-transform">
<span class="material-symbols-outlined text-[48px] star-active" data-icon="star" style="font-variation-settings: 'FILL' 1;">star</span>
</button>
<button class="tap-highlight-transparent active:scale-90 transition-transform">
<span class="material-symbols-outlined text-[48px] star-active" data-icon="star" style="font-variation-settings: 'FILL' 1;">star</span>
</button>
<button class="tap-highlight-transparent active:scale-90 transition-transform">
<span class="material-symbols-outlined text-[48px] text-surface-container-high" data-icon="star">star</span>
</button>
</div>
<span class="font-body-md text-body-md text-primary font-semibold">4.0 / 5.0</span>
</div>
<!-- Experience Text Area -->
<div class="space-y-xs">
<label class="font-label-md text-label-md text-on-surface-variant" for="experience">Your detailed experience</label>
<textarea class="w-full rounded-lg border border-outline-variant bg-surface-bright p-md focus:border-primary-container focus:ring-1 focus:ring-primary-container font-body-md text-body-md outline-none transition-all resize-none" id="experience" placeholder="Share your experience with this customer..." rows="5"></textarea>
<p class="text-right font-label-md text-label-md text-on-surface-variant">0 / 500</p>
</div>
<!-- Quick Tags -->
<div class="space-y-xs">
<label class="font-label-md text-label-md text-on-surface-variant">Quick Feedback Tags</label>
<div class="flex flex-wrap gap-xs">
<span class="px-md py-xs rounded-full border border-outline-variant text-label-md font-label-md bg-surface hover:border-primary transition-colors cursor-pointer">Clear communication</span>
<span class="px-md py-xs rounded-full border border-outline-variant text-label-md font-label-md bg-surface hover:border-primary transition-colors cursor-pointer">On-time payment</span>
<span class="px-md py-xs rounded-full border border-outline-variant text-label-md font-label-md bg-surface hover:border-primary transition-colors cursor-pointer">Accurate project scope</span>
<span class="px-md py-xs rounded-full border border-outline-variant text-label-md font-label-md bg-surface hover:border-primary transition-colors cursor-pointer">Friendly environment</span>
</div>
</div>
<!-- Submit Button -->
<button class="w-full bg-primary-container text-on-primary py-md rounded-lg font-h3 text-body-lg shadow-sm active:scale-[0.98] transition-all hover:brightness-110 h-[48px] flex items-center justify-center">
          Submit Review
        </button>
</div>
</section>
<!-- Professional Context Tip -->
<div class="mt-xl flex gap-md p-md bg-surface-container-high rounded-lg">
<span class="material-symbols-outlined text-primary" data-icon="info">info</span>
<p class="font-body-md text-body-md text-on-surface">Your review will be visible on Sarah's profile to other verified TradeFind professionals.</p>
</div>
</main>
<!-- BottomNavBar Component (from JSON) -->
<nav class="fixed bottom-0 left-0 w-full z-50 flex justify-around items-center h-16 pb-safe px-6 bg-white dark:bg-gray-900 border-t border-gray-100 dark:border-gray-800 shadow-[0_-2px_10px_rgba(0,0,0,0.05)] rounded-t-xl">
<a class="flex flex-col items-center justify-center text-gray-400 dark:text-gray-500 hover:text-orange-400 transition-transform active:opacity-70" href="#">
<span class="material-symbols-outlined" data-icon="work">work</span>
<span class="font-['Inter'] text-[10px] font-medium">Jobs</span>
</a>
<a class="flex flex-col items-center justify-center text-gray-400 dark:text-gray-500 hover:text-orange-400 transition-transform active:opacity-70" href="#">
<span class="material-symbols-outlined" data-icon="chat_bubble">chat_bubble</span>
<span class="font-['Inter'] text-[10px] font-medium">Messages</span>
</a>
<a class="flex flex-col items-center justify-center text-gray-400 dark:text-gray-500 hover:text-orange-400 transition-transform active:opacity-70" href="#">
<span class="material-symbols-outlined" data-icon="calendar_today">calendar_today</span>
<span class="font-['Inter'] text-[10px] font-medium">Schedule</span>
</a>
<a class="flex flex-col items-center justify-center text-orange-600 dark:text-orange-500 scale-110 transition-transform active:opacity-70" href="#">
<span class="material-symbols-outlined" data-icon="person" style="font-variation-settings: 'FILL' 1;">person</span>
<span class="font-['Inter'] text-[10px] font-medium">Profile</span>
</a>
</nav>
</body></html>