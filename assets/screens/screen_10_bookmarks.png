<!DOCTYPE html>

<html class="light" lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>Saved Tradespeople - TradeFind</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "surface-bright": "#f9f9ff",
                        "surface": "#f9f9ff",
                        "on-secondary": "#ffffff",
                        "on-tertiary-fixed-variant": "#5c4300",
                        "on-secondary-container": "#5d1900",
                        "on-background": "#141b2b",
                        "on-primary-fixed-variant": "#783200",
                        "tertiary-container": "#c49200",
                        "on-error": "#ffffff",
                        "background": "#f9f9ff",
                        "surface-container": "#e9edff",
                        "on-tertiary-fixed": "#261a00",
                        "on-surface-variant": "#584237",
                        "primary-fixed-dim": "#ffb690",
                        "secondary": "#ac3400",
                        "secondary-fixed-dim": "#ffb59d",
                        "surface-container-highest": "#dce2f7",
                        "on-error-container": "#93000a",
                        "on-tertiary-container": "#422f00",
                        "surface-tint": "#9d4300",
                        "on-primary-container": "#582200",
                        "outline-variant": "#e0c0b1",
                        "secondary-fixed": "#ffdbd0",
                        "primary-container": "#f97316",
                        "surface-container-low": "#f1f3ff",
                        "primary-fixed": "#ffdbca",
                        "on-secondary-fixed": "#390c00",
                        "tertiary-fixed": "#ffdf9f",
                        "inverse-on-surface": "#edf0ff",
                        "on-surface": "#141b2b",
                        "outline": "#8c7164",
                        "on-secondary-fixed-variant": "#832600",
                        "surface-container-lowest": "#ffffff",
                        "surface-variant": "#dce2f7",
                        "primary": "#9d4300",
                        "surface-container-high": "#e1e8fd",
                        "on-tertiary": "#ffffff",
                        "secondary-container": "#fd6b36",
                        "tertiary": "#795900",
                        "error-container": "#ffdad6",
                        "on-primary-fixed": "#341100",
                        "tertiary-fixed-dim": "#f9bd22",
                        "error": "#ba1a1a",
                        "inverse-primary": "#ffb690",
                        "on-primary": "#ffffff",
                        "surface-dim": "#d3daef",
                        "inverse-surface": "#293040"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    "spacing": {
                        "sm": "12px",
                        "gutter": "12px",
                        "lg": "24px",
                        "xs": "8px",
                        "md": "16px",
                        "base": "4px",
                        "xl": "32px",
                        "margin": "16px"
                    },
                    "fontFamily": {
                        "h2": ["Inter"],
                        "label-md": ["Inter"],
                        "body-md": ["Inter"],
                        "h1": ["Inter"],
                        "h3": ["Inter"],
                        "body-lg": ["Inter"]
                    },
                    "fontSize": {
                        "h2": ["24px", {"lineHeight": "30px", "letterSpacing": "-0.01em", "fontWeight": "700"}],
                        "label-md": ["12px", {"lineHeight": "16px", "letterSpacing": "0.02em", "fontWeight": "500"}],
                        "body-md": ["14px", {"lineHeight": "20px", "fontWeight": "400"}],
                        "h1": ["28px", {"lineHeight": "34px", "letterSpacing": "-0.02em", "fontWeight": "700"}],
                        "h3": ["20px", {"lineHeight": "26px", "letterSpacing": "0em", "fontWeight": "700"}],
                        "body-lg": ["16px", {"lineHeight": "24px", "fontWeight": "400"}]
                    }
                }
            }
        }
    </script>
<style>
        body {
            background-color: #f9f9ff;
            color: #141b2b;
            font-family: 'Inter', sans-serif;
            -webkit-font-smoothing: antialiased;
        }
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        .card-shadow {
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        }
    </style>
<style>
    body {
      min-height: max(884px, 100dvh);
    }
  </style>
  </head>
<body class="flex flex-col min-h-screen">
<!-- TopAppBar -->
<header class="sticky top-0 z-50 flex justify-between items-center w-full px-4 h-16 bg-[#F9FAFB] dark:bg-slate-950 border-b border-slate-200 dark:border-slate-800 font-['Inter'] antialiased tracking-tight">
<div class="flex items-center gap-4">
<button class="material-symbols-outlined text-slate-500 hover:bg-slate-100 p-2 rounded-full transition-colors active:scale-95 duration-150">menu</button>
<span class="text-2xl font-black text-orange-600 dark:text-orange-500">TradeFind</span>
</div>
<div class="flex items-center">
<div class="w-10 h-10 rounded-full overflow-hidden border-2 border-orange-100">
<img alt="User Profile" class="w-full h-full object-cover" data-alt="professional headshot of a smiling man with neat hair and a friendly expression in a bright modern studio setting" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAKjIQkGqH8Tom4AtQeqUiZBpO3FhJmKMTq12Lh2KVllBTp9h8ni_v0KIvTdEDMKwKhxIIzYrJZSvV28_vrTprAUP2YC4AQm657Pa-290XTaf8G5rL_d_MB90qFvblZh5LViSNPrXm0vGkdE_6jvjHQlYgc0A99KH4lShaXP9uoa3wsz4Xj7MKaJ_i6qVBDw1brImv4hJBlNNNOjKNi05pwtOvUYVazEVlHK8rBY5lYTM4CCoFBYTne4qSd8q1zSNXFy3AmrVe-yYQ"/>
</div>
</div>
</header>
<main class="flex-grow px-margin pt-lg pb-xl">
<div class="max-w-md mx-auto">
<!-- Header Section -->
<div class="mb-lg">
<h1 class="font-h1 text-h1 text-on-surface">Saved Tradespeople</h1>
<p class="font-body-md text-body-md text-on-surface-variant mt-1">Review and manage your favorite professionals.</p>
</div>
<!-- List of Saved Workers -->
<div class="space-y-gutter">
<!-- Worker Card 1 -->
<div class="bg-white rounded-xl card-shadow overflow-hidden p-md relative border border-surface-container">
<div class="absolute top-md right-md">
<button class="material-symbols-outlined text-primary" style="font-variation-settings: 'FILL' 1;">bookmark</button>
</div>
<div class="flex gap-md">
<div class="w-20 h-20 rounded-lg overflow-hidden flex-shrink-0">
<img alt="Marcus Chen" class="w-full h-full object-cover" data-alt="experienced electrician wearing professional work shirt examining a circuit board with focus and expertise in a well-lit workshop" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDnKwxU2ISi4V938pD4mQV2BTaOm6xCbDaZrDCHppROYryseiTkFCNTRdF2NkK-ITdaHytQuWW5ZwpF-f2iPyV2-75niR70xolYTNcoiUYSMK2VwalZQWQ6GptC-9H8EOYC3iKXU3T2WSwTO25dJzrWovqMwE9vWE9hCXCFJBh_f9_uWmlsrYWQNuY_VinixLbNZ0teU_ErXSa0lQ_-EfUJR-aBLqZc7dlN10rvJy7MaOedGWWJZFXG-hjKtIbbb8Wpax0GHJy51fU"/>
</div>
<div class="flex flex-col justify-between flex-grow">
<div>
<div class="flex items-center gap-2">
<h3 class="font-h3 text-h3 text-on-surface">Marcus Chen</h3>
<span class="bg-green-100 text-green-700 text-[10px] px-2 py-0.5 rounded-full font-bold uppercase tracking-wider">Available</span>
</div>
<p class="font-label-md text-label-md text-on-surface-variant">Master Electrician</p>
</div>
<div class="flex items-center gap-1 mt-1">
<span class="material-symbols-outlined text-[18px] text-[#FBBF24]" style="font-variation-settings: 'FILL' 1;">star</span>
<span class="font-label-md text-label-md text-on-surface font-bold">4.9</span>
<span class="font-label-md text-label-md text-on-surface-variant">(124 reviews)</span>
</div>
</div>
</div>
<div class="mt-md pt-md border-t border-surface-container flex gap-xs">
<button class="flex-grow h-12 bg-primary-container text-white font-bold rounded-lg flex items-center justify-center gap-2 active:scale-95 transition-transform">
<span class="material-symbols-outlined">call</span>
                            Call
                        </button>
<button class="px-4 h-12 border border-outline-variant text-on-surface-variant rounded-lg flex items-center justify-center active:scale-95 transition-transform">
<span class="material-symbols-outlined">calendar_today</span>
</button>
</div>
</div>
<!-- Worker Card 2 -->
<div class="bg-white rounded-xl card-shadow overflow-hidden p-md relative border border-surface-container">
<div class="absolute top-md right-md">
<button class="material-symbols-outlined text-primary" style="font-variation-settings: 'FILL' 1;">bookmark</button>
</div>
<div class="flex gap-md">
<div class="w-20 h-20 rounded-lg overflow-hidden flex-shrink-0">
<img alt="Elena Rodriguez" class="w-full h-full object-cover" data-alt="female plumber in a grey utility uniform adjusting pipes under a sink with tools, showing professional craftsmanship and reliability" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCkWVo8UmWoqb8300zNz5N0yTwx7Oyhi3FYjqUncaiwyzWGju-lr2a4gLM4AzePv3iSX3ffsd8nP-6VTM6ZWtXAX5n_DDv1DLLP_kaxAZnKFfSbi-r-7sf0Gix_SYRtz0sBuxMDB8Jt2-FzphtjOBXeNDHtvHwuNaJ9bDKGHR5J-Ig-eWVlO1r2zdaPWSC8tiG-X1z-JEOJJAxX1nCsXhagtqKWatVJf3la0IBQqkkXiiSaqvZcpfvtNusS3svOlnKw5Rat-crWbhM"/>
</div>
<div class="flex flex-col justify-between flex-grow">
<div>
<div class="flex items-center gap-2">
<h3 class="font-h3 text-h3 text-on-surface">Elena Rodriguez</h3>
<span class="bg-slate-100 text-slate-500 text-[10px] px-2 py-0.5 rounded-full font-bold uppercase tracking-wider">Busy</span>
</div>
<p class="font-label-md text-label-md text-on-surface-variant">Expert Plumber</p>
</div>
<div class="flex items-center gap-1 mt-1">
<span class="material-symbols-outlined text-[18px] text-[#FBBF24]" style="font-variation-settings: 'FILL' 1;">star</span>
<span class="font-label-md text-label-md text-on-surface font-bold">4.8</span>
<span class="font-label-md text-label-md text-on-surface-variant">(89 reviews)</span>
</div>
</div>
</div>
<div class="mt-md pt-md border-t border-surface-container flex gap-xs">
<button class="flex-grow h-12 bg-primary-container text-white font-bold rounded-lg flex items-center justify-center gap-2 active:scale-95 transition-transform">
<span class="material-symbols-outlined">call</span>
                            Call
                        </button>
<button class="px-4 h-12 border border-outline-variant text-on-surface-variant rounded-lg flex items-center justify-center active:scale-95 transition-transform">
<span class="material-symbols-outlined">calendar_today</span>
</button>
</div>
</div>
<!-- Worker Card 3 -->
<div class="bg-white rounded-xl card-shadow overflow-hidden p-md relative border border-surface-container">
<div class="absolute top-md right-md">
<button class="material-symbols-outlined text-primary" style="font-variation-settings: 'FILL' 1;">bookmark</button>
</div>
<div class="flex gap-md">
<div class="w-20 h-20 rounded-lg overflow-hidden flex-shrink-0">
<img alt="James Wilson" class="w-full h-full object-cover" data-alt="skilled carpenter in denim overalls working with wood in a rustic sunlit workshop, dust particles visible in the warm light" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCya6dIYvQeKp5mxr-cK_9D9R-_aaR6Ywhul14RNOG6M6Vyqzba9wgTlWj7ZH8kqNKregiHB0wjpnD_RNtmdiEFIn1eSluzF7kZ3FwbTlLkv3LqEhFcD09xdyf5o_afGu-aQHDR1fHBSzcLke_E7209Ss47exDm1Iz4z6uttT74iW-OZ5hgND3VxKXrKNlwaNiUV7bnybcFJU0lELCIvDx6I8vfdNyrJZ9luq_ZH1Q_wqPMtX2FDls86a9mVObKHEJL2GoBtJQG7OQ"/>
</div>
<div class="flex flex-col justify-between flex-grow">
<div>
<div class="flex items-center gap-2">
<h3 class="font-h3 text-h3 text-on-surface">James Wilson</h3>
<span class="bg-green-100 text-green-700 text-[10px] px-2 py-0.5 rounded-full font-bold uppercase tracking-wider">Available</span>
</div>
<p class="font-label-md text-label-md text-on-surface-variant">Custom Carpentry</p>
</div>
<div class="flex items-center gap-1 mt-1">
<span class="material-symbols-outlined text-[18px] text-[#FBBF24]" style="font-variation-settings: 'FILL' 1;">star</span>
<span class="font-label-md text-label-md text-on-surface font-bold">5.0</span>
<span class="font-label-md text-label-md text-on-surface-variant">(56 reviews)</span>
</div>
</div>
</div>
<div class="mt-md pt-md border-t border-surface-container flex gap-xs">
<button class="flex-grow h-12 bg-primary-container text-white font-bold rounded-lg flex items-center justify-center gap-2 active:scale-95 transition-transform">
<span class="material-symbols-outlined">call</span>
                            Call
                        </button>
<button class="px-4 h-12 border border-outline-variant text-on-surface-variant rounded-lg flex items-center justify-center active:scale-95 transition-transform">
<span class="material-symbols-outlined">calendar_today</span>
</button>
</div>
</div>
</div>
<!-- Empty State Illustration Placeholder (Subtle) -->
<div class="mt-xl flex flex-col items-center justify-center opacity-40">
<span class="material-symbols-outlined text-4xl mb-2">inventory_2</span>
<p class="font-label-md text-label-md">End of your saved list</p>
</div>
</div>
</main>
<div class="h-20"></div> <!-- Spacer for fixed bottom nav -->
<!-- BottomNavBar -->
<nav class="fixed bottom-0 left-0 w-full z-50 flex justify-around items-center h-16 bg-white dark:bg-slate-900 px-2 pb-safe border-t border-slate-100 dark:border-slate-800 shadow-[0_-2px_8px_rgba(0,0,0,0.08)]">
<div class="flex flex-col items-center justify-center text-slate-400 dark:text-slate-500 hover:text-orange-500 transition-transform active:scale-90 tap-highlight-transparent cursor-pointer">
<span class="material-symbols-outlined">home</span>
<span class="font-['Inter'] text-[12px] font-medium mt-1">Home</span>
</div>
<div class="flex flex-col items-center justify-center text-slate-400 dark:text-slate-500 hover:text-orange-500 transition-transform active:scale-90 tap-highlight-transparent cursor-pointer">
<span class="material-symbols-outlined">map</span>
<span class="font-['Inter'] text-[12px] font-medium mt-1">Map</span>
</div>
<div class="flex flex-col items-center justify-center text-orange-600 dark:text-orange-500 bg-orange-50/50 dark:bg-orange-900/20 rounded-xl px-3 py-1 transition-transform active:scale-90 tap-highlight-transparent cursor-pointer">
<span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">bookmark</span>
<span class="font-['Inter'] text-[12px] font-medium mt-1">Bookmarks</span>
</div>
<div class="flex flex-col items-center justify-center text-slate-400 dark:text-slate-500 hover:text-orange-500 transition-transform active:scale-90 tap-highlight-transparent cursor-pointer">
<span class="material-symbols-outlined">person</span>
<span class="font-['Inter'] text-[12px] font-medium mt-1">Profile</span>
</div>
</nav>
</body></html>