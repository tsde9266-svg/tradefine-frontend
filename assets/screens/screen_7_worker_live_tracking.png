<!DOCTYPE html>

<html class="light" lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" name="viewport"/>
<title>TradeFind - Live Tracking</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;800;900&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "surface-bright": "#f9f9ff",
                        "surface": "#f9f9ff",
                        "on-secondary": "#ffffff",
                        "on-tertiary-fixed-variant": "#5c4300",
                        "on-secondary-container": "#5d1900",
                        "on-background": "#141b2b",
                        "on-primary-fixed-variant": "#783200",
                        "tertiary-container": "#c49200",
                        "on-error": "#ffffff",
                        "background": "#f9f9ff",
                        "surface-container": "#e9edff",
                        "on-tertiary-fixed": "#261a00",
                        "on-surface-variant": "#584237",
                        "primary-fixed-dim": "#ffb690",
                        "secondary": "#ac3400",
                        "secondary-fixed-dim": "#ffb59d",
                        "surface-container-highest": "#dce2f7",
                        "on-error-container": "#93000a",
                        "on-tertiary-container": "#422f00",
                        "surface-tint": "#9d4300",
                        "on-primary-container": "#582200",
                        "outline-variant": "#e0c0b1",
                        "secondary-fixed": "#ffdbd0",
                        "primary-container": "#f97316",
                        "surface-container-low": "#f1f3ff",
                        "primary-fixed": "#ffdbca",
                        "on-secondary-fixed": "#390c00",
                        "tertiary-fixed": "#ffdf9f",
                        "inverse-on-surface": "#edf0ff",
                        "on-surface": "#141b2b",
                        "outline": "#8c7164",
                        "on-secondary-fixed-variant": "#832600",
                        "surface-container-lowest": "#ffffff",
                        "surface-variant": "#dce2f7",
                        "primary": "#9d4300",
                        "surface-container-high": "#e1e8fd",
                        "on-tertiary": "#ffffff",
                        "secondary-container": "#fd6b36",
                        "tertiary": "#795900",
                        "error-container": "#ffdad6",
                        "on-primary-fixed": "#341100",
                        "tertiary-fixed-dim": "#f9bd22",
                        "error": "#ba1a1a",
                        "inverse-primary": "#ffb690",
                        "on-primary": "#ffffff",
                        "surface-dim": "#d3daef",
                        "inverse-surface": "#293040"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    "spacing": {
                        "sm": "12px",
                        "gutter": "12px",
                        "lg": "24px",
                        "xs": "8px",
                        "md": "16px",
                        "base": "4px",
                        "xl": "32px",
                        "margin": "16px"
                    },
                    "fontFamily": {
                        "h2": ["Inter"],
                        "label-md": ["Inter"],
                        "body-md": ["Inter"],
                        "h1": ["Inter"],
                        "h3": ["Inter"],
                        "body-lg": ["Inter"]
                    },
                    "fontSize": {
                        "h2": ["24px", {"lineHeight": "30px", "letterSpacing": "-0.01em", "fontWeight": "700"}],
                        "label-md": ["12px", {"lineHeight": "16px", "letterSpacing": "0.02em", "fontWeight": "500"}],
                        "body-md": ["14px", {"lineHeight": "20px", "fontWeight": "400"}],
                        "h1": ["28px", {"lineHeight": "34px", "letterSpacing": "-0.02em", "fontWeight": "700"}],
                        "h3": ["20px", {"lineHeight": "26px", "letterSpacing": "0em", "fontWeight": "700"}],
                        "body-lg": ["16px", {"lineHeight": "24px", "fontWeight": "400"}]
                    }
                },
            },
        }
    </script>
<style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
            display: inline-block;
            line-height: 1;
            text-transform: none;
            letter-spacing: normal;
            word-wrap: normal;
            white-space: nowrap;
            direction: ltr;
        }
        .map-pulse {
            position: relative;
        }
        .map-pulse::after {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 100%;
            height: 100%;
            background: #f97316;
            border-radius: 50%;
            z-index: -1;
            opacity: 0.4;
            animation: pulse-ring 2s cubic-bezier(0.215, 0.61, 0.355, 1) infinite;
        }
        @keyframes pulse-ring {
            0% { transform: translate(-50%, -50%) scale(0.33); }
            80%, 100% { transform: translate(-50%, -50%) scale(1.5); opacity: 0; }
        }
    </style>
<style>
    body {
      min-height: max(884px, 100dvh);
    }
  </style>
  </head>
<body class="bg-surface font-body-md text-on-surface min-h-screen overflow-hidden flex flex-col">
<!-- Top Navigation Anchor -->
<header class="sticky top-0 z-50 flex justify-between items-center w-full px-4 h-16 bg-[#F9FAFB] border-b border-slate-200 font-['Inter'] antialiased tracking-tight">
<div class="flex items-center gap-4">
<button class="w-10 h-10 flex items-center justify-center rounded-full hover:bg-slate-100 transition-colors active:scale-95 duration-150">
<span class="material-symbols-outlined text-slate-500">arrow_back</span>
</button>
<span class="text-2xl font-black text-orange-600">TradeFind</span>
</div>
<div class="flex items-center gap-2">
<div class="bg-orange-50 text-orange-600 px-3 py-1 rounded-full text-label-md font-bold flex items-center gap-1">
<span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 1;">emergency</span>
                LIVE
            </div>
<img alt="user" class="w-8 h-8 rounded-full border-2 border-white shadow-sm" data-alt="professional headshot of a middle-aged male user with short hair in a bright office environment" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCH5pkicioCI_ERlnX5_h3Gga1DWoHcl0YsOioocF6HRUKJEXcpiXDbeQLtzFrmlhfnHFvt93fg_0euzo39hQ2C_PTvyeSBF_eRCU47it5M7jddzLy4AKrcLvrktQnwqLkmI4dtW1UIaAdzTsKgDJm3TXujfb7O77PEwWzpG7lbMLcOL4B88DOJ7cM16xeXnedS_y1-aRKHiDsc0BliK2CgrnTkehRNLFHp3KO7YqTMVAF64n3uyUaW6taqYgTkeDo9YXSuqEcCA7I"/>
</div>
</header>
<!-- Main Map Canvas -->
<main class="flex-grow relative w-full h-full">
<!-- Mock Map Interface -->
<div class="absolute inset-0 z-0 bg-[#e5e7eb]">
<img class="w-full h-full object-cover opacity-60 mix-blend-multiply" data-alt="clean minimalist city map with light grey roads and soft blue water features, showing a modern urban layout" data-location="London" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBh0P5gD5ehWQB0jmGxW7oH9P66YmgJGl8AkCva1okc33_eqPodwhEkRHxZgOtcHTDbkUKtKACvsjM6sWfOyYuU4w-_2pmpqExwWnkagdpMFdH7uffZSPeu-HwPuVH_E6RorFBWUTGpPWTFpaguUbqOAQM7xU-wdV02DCqfsJ1iZxo1VTVQxANyfS_XwjWo0_3Ofdb_dAhmQ8VG1hkwrCLfvd_CPX6XVsPETFXC5etx8EFzXLSSCRZu3cs264fIVU4DEQn48o0Alh8"/>
<!-- Route Path (SVG Overlay) -->
<svg class="absolute inset-0 w-full h-full pointer-events-none" xmlns="http://www.w3.org/2000/svg">
<path class="opacity-50" d="M 120 450 Q 180 380 280 400 T 420 280" fill="none" stroke="#f97316" stroke-dasharray="8 6" stroke-linecap="round" stroke-width="4"></path>
</svg>
<!-- Worker Marker (The Orange Pulse) -->
<div class="absolute top-1/2 left-1/3 -translate-x-1/2 -translate-y-1/2 z-10">
<div class="map-pulse w-12 h-12 flex items-center justify-center bg-white rounded-full shadow-lg border-2 border-orange-600">
<img class="w-8 h-8 rounded-full" data-alt="close-up photo of a professional electrician tools background with subtle focus" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBslpy4lZveQaMgRwhPh3b2-d1sO1K6EsohX4oNYw4WxAuYqgwZKunvKUT7r90BtsnGpdg6m7fegOFMdugJmBTTHYhHUcACEPJ5xePMQSpgINrJmR2IMm3oQPyrsz-6e0TlfXYyoMxNoYV4gzewS_geACFuth_D_NVA22BDorkeh6YWUOc-Y0C0qgexy_w_DycQKMdZVkdWZKz8zz3SXhX6s8mdDmxbNlfzStxXx8ae_IVn_PgjH4_x6bfBIb3VbSHTxeib3UMigZs"/>
<div class="absolute -top-1 -right-1 bg-orange-600 text-white w-5 h-5 rounded-full flex items-center justify-center text-[10px] font-bold border-2 border-white">
<span class="material-symbols-outlined text-[12px]" style="font-variation-settings: 'FILL' 1;">electric_bolt</span>
</div>
</div>
<div class="mt-2 bg-orange-600 text-white text-[10px] px-2 py-0.5 rounded shadow-md font-bold text-center whitespace-nowrap">
                    James (En route)
                </div>
</div>
<!-- User Destination (The Blue Dot) -->
<div class="absolute top-[40%] right-[20%] z-10">
<div class="w-6 h-6 bg-blue-500 rounded-full border-4 border-white shadow-lg relative">
<div class="absolute -top-10 left-1/2 -translate-x-1/2 bg-white px-3 py-1 rounded-lg shadow-sm border border-slate-200 text-label-md font-bold text-slate-800 whitespace-nowrap">
                        Your Location
                    </div>
</div>
</div>
</div>
<!-- Float Map Controls -->
<div class="absolute right-4 top-4 flex flex-col gap-2 z-20">
<button class="w-10 h-10 bg-white rounded-xl shadow-md flex items-center justify-center text-slate-600 hover:bg-slate-50 active:scale-95">
<span class="material-symbols-outlined">add</span>
</button>
<button class="w-10 h-10 bg-white rounded-xl shadow-md flex items-center justify-center text-slate-600 hover:bg-slate-50 active:scale-95">
<span class="material-symbols-outlined">remove</span>
</button>
<button class="w-10 h-10 bg-white rounded-xl shadow-md flex items-center justify-center text-orange-600 hover:bg-slate-50 active:scale-95">
<span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">my_location</span>
</button>
</div>
<!-- Tracking Card (The Focus Area) -->
<div class="absolute bottom-4 inset-x-4 z-30">
<div class="bg-white rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.12)] p-4 border border-slate-100">
<!-- Status Header -->
<div class="flex items-center justify-between mb-4">
<div class="flex items-center gap-3">
<div class="relative">
<img alt="James OBrien" class="w-14 h-14 rounded-xl object-cover shadow-sm" data-alt="professional portrait of James, a friendly tradesperson wearing a branded orange work polo shirt with a smiling expression" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAKt4BjPc5rGnQUS6bpPYVuTNHHucZH72L7RY9zSGA8ERJJKBw4Zl5zP3G3wKroG9dK-VZXg2lrzrqDHPHPplthyjyfDoQfrGdBLyqkmOmacZB6oAYcGDksXpcBlTiQTf-3GJIcGsAnzUL_VvdVqGWQyvQOQAzQ9omxTwaKQOOFn4T3_D235W41vId0KdQ0jOOOs0UvxKsETwmLlCgB1wHS6LcFaJlrfZqRyWDxy457J9uY9a9PDlKpDIDqb2acxYEh5pFUQ2Tm6II"/>
<div class="absolute -bottom-1 -right-1 bg-green-500 w-4 h-4 rounded-full border-2 border-white"></div>
</div>
<div>
<h3 class="font-h3 text-on-surface leading-tight">James O'Brien is on his way</h3>
<p class="text-body-md text-slate-500 flex items-center gap-1">
<span class="material-symbols-outlined text-[16px]">verified</span> Master Electrician
                            </p>
</div>
</div>
<div class="text-right">
<div class="text-h2 text-orange-600">8 <span class="text-body-md font-medium text-slate-400">min</span></div>
<div class="text-label-md text-slate-500 uppercase tracking-wider">ETA</div>
</div>
</div>
<!-- Progress Indicator -->
<div class="mb-4">
<div class="flex justify-between items-end mb-1">
<span class="text-label-md font-bold text-orange-600">En route to you</span>
<span class="text-label-md text-slate-400">0.8 mi away</span>
</div>
<div class="w-full bg-slate-100 h-2 rounded-full overflow-hidden">
<div class="bg-orange-500 h-full w-[65%] rounded-full relative">
<div class="absolute right-0 top-0 w-2 h-2 bg-white rounded-full scale-150 shadow-sm"></div>
</div>
</div>
</div>
<!-- Action Grid -->
<div class="grid grid-cols-2 gap-3">
<button class="h-12 bg-primary-container text-white rounded-xl font-bold flex items-center justify-center gap-2 hover:bg-orange-700 transition-colors active:scale-95">
<span class="material-symbols-outlined">call</span>
                        Call James
                    </button>
<button class="h-12 bg-slate-50 border border-slate-200 text-slate-700 rounded-xl font-bold flex items-center justify-center gap-2 hover:bg-slate-100 transition-colors active:scale-95">
<span class="material-symbols-outlined">chat_bubble</span>
                        Message
                    </button>
</div>
</div>
</div>
</main>
<!-- Bottom Navigation Shell (Filter Applied: Hidden as this is a focused task screen) -->
<!-- We skip the BottomNavBar to prioritize the map/tracking canvas as per "The UX Goal" in instructions -->
</body></html>