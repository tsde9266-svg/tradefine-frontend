<!DOCTYPE html>

<html class="light" lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "tertiary-fixed": "#ffdf9f",
                        "surface-tint": "#9d4300",
                        "surface-container-low": "#f1f3ff",
                        "tertiary-container": "#c49200",
                        "surface-container-high": "#e1e8fd",
                        "on-secondary-fixed-variant": "#832600",
                        "on-primary": "#ffffff",
                        "secondary-fixed": "#ffdbd0",
                        "on-secondary": "#ffffff",
                        "on-primary-container": "#582200",
                        "secondary": "#ac3400",
                        "on-secondary-container": "#5d1900",
                        "on-background": "#141b2b",
                        "surface-dim": "#d3daef",
                        "outline": "#8c7164",
                        "on-error": "#ffffff",
                        "surface-variant": "#dce2f7",
                        "error": "#ba1a1a",
                        "surface-container-lowest": "#ffffff",
                        "primary-fixed": "#ffdbca",
                        "primary": "#9d4300",
                        "on-tertiary-fixed-variant": "#5c4300",
                        "tertiary": "#795900",
                        "surface-container": "#e9edff",
                        "primary-fixed-dim": "#ffb690",
                        "on-tertiary-fixed": "#261a00",
                        "on-error-container": "#93000a",
                        "background": "#f9f9ff",
                        "surface": "#f9f9ff",
                        "secondary-container": "#fd6b36",
                        "on-surface-variant": "#584237",
                        "outline-variant": "#e0c0b1",
                        "on-surface": "#141b2b",
                        "inverse-on-surface": "#edf0ff",
                        "on-secondary-fixed": "#390c00",
                        "error-container": "#ffdad6",
                        "inverse-surface": "#293040",
                        "secondary-fixed-dim": "#ffb59d",
                        "on-primary-fixed-variant": "#783200",
                        "tertiary-fixed-dim": "#f9bd22",
                        "primary-container": "#f97316",
                        "on-tertiary-container": "#422f00",
                        "on-primary-fixed": "#341100",
                        "inverse-primary": "#ffb690",
                        "on-tertiary": "#ffffff",
                        "surface-container-highest": "#dce2f7",
                        "surface-bright": "#f9f9ff"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    "spacing": {
                        "margin": "16px",
                        "xs": "8px",
                        "lg": "24px",
                        "gutter": "12px",
                        "xl": "32px",
                        "sm": "12px",
                        "base": "4px",
                        "md": "16px"
                    },
                    "fontFamily": {
                        "label-md": ["Inter"],
                        "h2": ["Inter"],
                        "body-lg": ["Inter"],
                        "h3": ["Inter"],
                        "h1": ["Inter"],
                        "body-md": ["Inter"]
                    },
                    "fontSize": {
                        "label-md": ["12px", {"lineHeight": "16px", "letterSpacing": "0.02em", "fontWeight": "500"}],
                        "h2": ["24px", {"lineHeight": "30px", "letterSpacing": "-0.01em", "fontWeight": "700"}],
                        "body-lg": ["16px", {"lineHeight": "24px", "fontWeight": "400"}],
                        "h3": ["20px", {"lineHeight": "26px", "letterSpacing": "0em", "fontWeight": "700"}],
                        "h1": ["28px", {"lineHeight": "34px", "letterSpacing": "-0.02em", "fontWeight": "700"}],
                        "body-md": ["14px", {"lineHeight": "20px", "fontWeight": "400"}]
                    }
                },
            },
        }
    </script>
<style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
            display: inline-block;
            vertical-align: middle;
        }
        body {
            background-color: #f9f9ff;
        }
    </style>
</head>
<body class="font-body-md text-on-surface antialiased">
<!-- SideNavBar -->
<aside class="flex flex-col py-6 h-screen w-64 fixed left-0 bg-slate-900 dark:bg-black shadow-xl border-r border-slate-800 z-50">
<div class="px-6 mb-8">
<h1 class="text-2xl font-black text-orange-500">TradeFind</h1>
<p class="text-slate-400 font-label-md text-label-md mt-1">Enterprise Admin</p>
</div>
<nav class="flex-1 space-y-1">
<a class="flex items-center gap-3 px-4 py-3 text-slate-400 hover:text-white mx-2 transition-colors duration-150 ease-in-out" href="#">
<span class="material-symbols-outlined" data-icon="dashboard">dashboard</span>
<span class="font-sans text-sm font-semibold">Dashboard</span>
</a>
<a class="flex items-center gap-3 px-4 py-3 bg-orange-600 text-white rounded-lg mx-2" href="#">
<span class="material-symbols-outlined" data-icon="engineering">engineering</span>
<span class="font-sans text-sm font-semibold">Tradespeople</span>
</a>
<a class="flex items-center gap-3 px-4 py-3 text-slate-400 hover:text-white mx-2 transition-colors duration-150 ease-in-out" href="#">
<span class="material-symbols-outlined" data-icon="pending_actions">pending_actions</span>
<span class="font-sans text-sm font-semibold">Requests</span>
</a>
<a class="flex items-center gap-3 px-4 py-3 text-slate-400 hover:text-white mx-2 transition-colors duration-150 ease-in-out" href="#">
<span class="material-symbols-outlined" data-icon="leaderboard">leaderboard</span>
<span class="font-sans text-sm font-semibold">Analytics</span>
</a>
<a class="flex items-center gap-3 px-4 py-3 text-slate-400 hover:text-white mx-2 transition-colors duration-150 ease-in-out" href="#">
<span class="material-symbols-outlined" data-icon="settings">settings</span>
<span class="font-sans text-sm font-semibold">Settings</span>
</a>
</nav>
<div class="px-6 mt-auto pt-6 border-t border-slate-800">
<div class="flex items-center gap-3">
<img alt="Admin User Profile" class="w-10 h-10 rounded-full border-2 border-slate-700" data-alt="Professional headshot of a senior corporate male administrator in a suit, studio lighting, clean background" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDtOGDGQiQIaK7SfqG-YiYOqIZEtRaz0B95BmiUB52PWl6zvsf203bxE-mfVSXJG1qETTa5KglIEnX2sP5BGc8HF3bdCWX6ehUG4AjJ71eevMt0o9RkTPf0b3sU4sOWL_QBiLqlN3O3KsZnZ-nNGo7KHbv_9V2Hyg5wcwe4HCxxnMedaYD62hzCZMfR1HOFOQDPlZufvyppyGrYjmBe43UFqyqtjriq2vh9i4rT1nyh_gYaySGMIIBDlWFCzIWw3546w04X4TYZ2Pg"/>
<div>
<p class="text-white font-semibold text-sm">Alex Rivers</p>
<p class="text-slate-400 text-xs">Super Admin</p>
</div>
</div>
</div>
</aside>
<!-- Main Content Wrapper -->
<div class="pl-64 min-h-screen flex flex-col">
<!-- TopNavBar -->
<header class="flex justify-between items-center px-6 w-full sticky top-0 z-40 bg-white dark:bg-slate-900 h-16 border-b border-slate-200 dark:border-slate-800 shadow-sm">
<div class="flex items-center gap-4 flex-1">
<div class="relative w-full max-w-md">
<span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-lg">search</span>
<input class="w-full bg-slate-50 border-slate-200 rounded-lg pl-10 pr-4 py-2 text-sm focus:ring-primary-container focus:border-primary-container" placeholder="Search workers, ID, or trade..." type="text"/>
</div>
</div>
<div class="flex items-center gap-4 ml-4">
<button class="p-2 text-slate-500 hover:bg-slate-50 dark:hover:bg-slate-800 rounded-full transition-colors relative">
<span class="material-symbols-outlined" data-icon="notifications">notifications</span>
<span class="absolute top-1.5 right-1.5 w-2 h-2 bg-orange-600 rounded-full border-2 border-white"></span>
</button>
<button class="p-2 text-slate-500 hover:bg-slate-50 dark:hover:bg-slate-800 rounded-full transition-colors">
<span class="material-symbols-outlined" data-icon="help_outline">help_outline</span>
</button>
<button class="p-2 text-slate-500 hover:bg-slate-50 dark:hover:bg-slate-800 rounded-full transition-colors">
<span class="material-symbols-outlined" data-icon="account_circle">account_circle</span>
</button>
</div>
</header>
<!-- Page Content -->
<main class="flex-1 p-8">
<div class="mb-8 flex justify-between items-end">
<div>
<h2 class="font-h2 text-h2 text-on-surface">Worker Management</h2>
<p class="text-on-surface-variant font-body-md text-body-md mt-1">Review and manage verified tradespeople on the TradeFind platform.</p>
</div>
<div class="flex gap-3">
<button class="flex items-center gap-2 px-4 py-2 border border-outline-variant rounded-lg text-on-surface-variant font-label-md text-label-md bg-white hover:bg-slate-50 transition-colors">
<span class="material-symbols-outlined text-[20px]" data-icon="filter_list">filter_list</span>
                        Filters
                    </button>
<button class="flex items-center gap-2 px-4 py-2 border border-outline-variant rounded-lg text-on-surface-variant font-label-md text-label-md bg-white hover:bg-slate-50 transition-colors">
<span class="material-symbols-outlined text-[20px]" data-icon="download">download</span>
                        Export CSV
                    </button>
<button class="flex items-center gap-2 px-4 py-2 bg-primary-container text-white rounded-lg font-label-md text-label-md hover:opacity-90 transition-opacity">
<span class="material-symbols-outlined text-[20px]" data-icon="add">add</span>
                        Add Worker
                    </button>
</div>
</div>
<!-- Stats Overview -->
<div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
<div class="bg-white p-6 rounded-xl shadow-sm border border-slate-100">
<div class="flex justify-between items-start mb-4">
<div class="p-2 bg-orange-50 rounded-lg text-orange-600">
<span class="material-symbols-outlined" data-icon="group">group</span>
</div>
<span class="text-green-600 font-medium text-xs flex items-center">+12%</span>
</div>
<p class="text-on-surface-variant text-label-md">Total Workers</p>
<h3 class="text-2xl font-bold mt-1">1,482</h3>
</div>
<div class="bg-white p-6 rounded-xl shadow-sm border border-slate-100">
<div class="flex justify-between items-start mb-4">
<div class="p-2 bg-blue-50 rounded-lg text-blue-600">
<span class="material-symbols-outlined" data-icon="verified">verified</span>
</div>
</div>
<p class="text-on-surface-variant text-label-md">Active / Approved</p>
<h3 class="text-2xl font-bold mt-1">1,240</h3>
</div>
<div class="bg-white p-6 rounded-xl shadow-sm border border-slate-100">
<div class="flex justify-between items-start mb-4">
<div class="p-2 bg-yellow-50 rounded-lg text-yellow-600">
<span class="material-symbols-outlined" data-icon="hourglass_empty">hourglass_empty</span>
</div>
</div>
<p class="text-on-surface-variant text-label-md">Pending Review</p>
<h3 class="text-2xl font-bold mt-1">186</h3>
</div>
<div class="bg-white p-6 rounded-xl shadow-sm border border-slate-100">
<div class="flex justify-between items-start mb-4">
<div class="p-2 bg-red-50 rounded-lg text-red-600">
<span class="material-symbols-outlined" data-icon="block">block</span>
</div>
</div>
<p class="text-on-surface-variant text-label-md">Blocked Accounts</p>
<h3 class="text-2xl font-bold mt-1">56</h3>
</div>
</div>
<!-- Table Section -->
<div class="bg-white rounded-xl shadow-sm border border-slate-100 overflow-hidden">
<div class="overflow-x-auto">
<table class="w-full text-left border-collapse">
<thead class="bg-slate-50 border-b border-slate-100">
<tr>
<th class="px-6 py-4 font-semibold text-slate-600 text-xs uppercase tracking-wider">Worker</th>
<th class="px-6 py-4 font-semibold text-slate-600 text-xs uppercase tracking-wider">Trade</th>
<th class="px-6 py-4 font-semibold text-slate-600 text-xs uppercase tracking-wider">Joined Date</th>
<th class="px-6 py-4 font-semibold text-slate-600 text-xs uppercase tracking-wider">Status</th>
<th class="px-6 py-4 font-semibold text-slate-600 text-xs uppercase tracking-wider text-right">Actions</th>
</tr>
</thead>
<tbody class="divide-y divide-slate-50">
<!-- Row 1 -->
<tr class="hover:bg-slate-50 transition-colors">
<td class="px-6 py-4">
<div class="flex items-center gap-3">
<img class="w-10 h-10 rounded-full object-cover border border-slate-200" data-alt="Close-up portrait of a male electrician wearing a work uniform, looking friendly, neutral background" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBKRIoMQ0XvFH1ZAb4PnqYSTwyBIRfgQBQK-L6jgVCE8ranJP6TWeHgoyt34QYVBKStem3HmYsNMaCd8akEU01uNLDH3DMmaIMEyZkniXUuztdNKwFJYwFakLelDVjwm5BParfESk7BEZbRnRG8XSxF7ijFozT0eNroJVf_ntwGxH_p1TJh8uIgeBPk1czBuc_IY1MrqnkMoJtt19wstKKRWO2dsQ5XBvufVmtTWlzWbWWHQYyoAZIezh87kqGo1a6-O7YoFxeE3zI"/>
<div>
