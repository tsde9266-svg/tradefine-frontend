<!DOCTYPE html>

<html class="light" lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;800;900&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<script id="tailwind-config">
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            "colors": {
                "surface-bright": "#f9f9ff",
                "surface": "#f9f9ff",
                "on-secondary": "#ffffff",
                "on-tertiary-fixed-variant": "#5c4300",
                "on-secondary-container": "#5d1900",
                "on-background": "#141b2b",
                "on-primary-fixed-variant": "#783200",
                "tertiary-container": "#c49200",
                "on-error": "#ffffff",
                "background": "#f9f9ff",
                "surface-container": "#e9edff",
                "on-tertiary-fixed": "#261a00",
                "on-surface-variant": "#584237",
                "primary-fixed-dim": "#ffb690",
                "secondary": "#ac3400",
                "secondary-fixed-dim": "#ffb59d",
                "surface-container-highest": "#dce2f7",
                "on-error-container": "#93000a",
                "on-tertiary-container": "#422f00",
                "surface-tint": "#9d4300",
                "on-primary-container": "#582200",
                "outline-variant": "#e0c0b1",
                "secondary-fixed": "#ffdbd0",
                "primary-container": "#f97316",
                "surface-container-low": "#f1f3ff",
                "primary-fixed": "#ffdbca",
                "on-secondary-fixed": "#390c00",
                "tertiary-fixed": "#ffdf9f",
                "inverse-on-surface": "#edf0ff",
                "on-surface": "#141b2b",
                "outline": "#8c7164",
                "on-secondary-fixed-variant": "#832600",
                "surface-container-lowest": "#ffffff",
                "surface-variant": "#dce2f7",
                "primary": "#9d4300",
                "surface-container-high": "#e1e8fd",
                "on-tertiary": "#ffffff",
                "secondary-container": "#fd6b36",
                "tertiary": "#795900",
                "error-container": "#ffdad6",
                "on-primary-fixed": "#341100",
                "tertiary-fixed-dim": "#f9bd22",
                "error": "#ba1a1a",
                "inverse-primary": "#ffb690",
                "on-primary": "#ffffff",
                "surface-dim": "#d3daef",
                "inverse-surface": "#293040"
            },
            "borderRadius": {
                "DEFAULT": "0.25rem",
                "lg": "0.5rem",
                "xl": "0.75rem",
                "full": "9999px"
            },
            "spacing": {
                "sm": "12px",
                "gutter": "12px",
                "lg": "24px",
                "xs": "8px",
                "md": "16px",
                "base": "4px",
                "xl": "32px",
                "margin": "16px"
            },
            "fontFamily": {
                "h2": ["Inter"],
                "label-md": ["Inter"],
                "body-md": ["Inter"],
                "h1": ["Inter"],
                "h3": ["Inter"],
                "body-lg": ["Inter"]
            },
            "fontSize": {
                "h2": ["24px", {"lineHeight": "30px", "letterSpacing": "-0.01em", "fontWeight": "700"}],
                "label-md": ["12px", {"lineHeight": "16px", "letterSpacing": "0.02em", "fontWeight": "500"}],
                "body-md": ["14px", {"lineHeight": "20px", "fontWeight": "400"}],
                "h1": ["28px", {"lineHeight": "34px", "letterSpacing": "-0.02em", "fontWeight": "700"}],
                "h3": ["20px", {"lineHeight": "26px", "letterSpacing": "0em", "fontWeight": "700"}],
                "body-lg": ["16px", {"lineHeight": "24px", "fontWeight": "400"}]
            }
          },
        },
      }
    </script>
<style>
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
    </style>
<style>
    body {
      min-height: max(884px, 100dvh);
    }
  </style>
  </head>
<body class="bg-surface-bright font-body-md text-on-surface antialiased">
<!-- TopAppBar Shell -->
<header class="sticky top-0 z-50 flex justify-between items-center w-full px-4 h-16 bg-[#F9FAFB] dark:bg-slate-950 border-b border-slate-200 dark:border-slate-800 font-['Inter'] antialiased tracking-tight">
<div class="flex items-center gap-2">
<span class="material-symbols-outlined text-orange-600">location_on</span>
<div class="flex flex-col">
<span class="font-label-md text-[10px] text-slate-500 uppercase tracking-wider">Your Location</span>
<span class="font-bold text-on-surface">Birmingham, B11</span>
</div>
</div>
<div class="flex items-center gap-4">
<div class="relative p-2 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-full transition-colors active:scale-95 duration-150">
<span class="material-symbols-outlined text-slate-600">notifications</span>
<span class="absolute top-2 right-2 w-2 h-2 bg-primary-container rounded-full border-2 border-white"></span>
</div>
<div class="w-10 h-10 rounded-full overflow-hidden border-2 border-orange-100">
<img alt="User Profile" class="w-full h-full object-cover" data-alt="portrait of a professional young man in casual work attire against a neutral architectural background" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAsWBN39YCT1XlmnM5QzXM3SqAHNrtpJ8juvPQqFe3xT6stcUjIA0QSBCl9Qx-EDo-ZldA83rtctvol0XPimAx0gE6LaHuVp8AN39tHXG_G17I8DvC8DbX4y0ERrMalypiN_gW9BO-e8mkAkziFjJg5SJUlDoXoImo66NcRqKeGczjv8jJt162RPOd3noBYUl8RcqVwdLShOr26TiXwXqx7HShMbdPnh8afg5fTG923eHvfkTm__oTzWI1cLTYVHlJU7joUrTfu9pc"/>
</div>
</div>
</header>
<main class="pb-24">
<!-- Search & Discovery Section -->
<div class="px-4 py-6 bg-white border-b border-slate-100">
<h1 class="font-h1 text-h1 mb-4 text-on-surface">Find a trusted professional</h1>
<!-- Search Bar -->
<div class="relative mb-6">
<span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-slate-400">search</span>
<input class="w-full h-12 pl-12 pr-4 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-primary-container focus:border-primary-container outline-none transition-all font-body-md" placeholder="Search by trade, name..." type="text"/>
</div>
<!-- Filter Chips -->
<div class="flex gap-2 overflow-x-auto no-scrollbar -mx-4 px-4">
<button class="flex-shrink-0 px-5 py-2 bg-primary-container text-white rounded-full font-label-md shadow-sm">All</button>
<button class="flex-shrink-0 px-5 py-2 bg-white border border-slate-200 text-slate-600 rounded-full font-label-md hover:bg-slate-50">Plumber</button>
<button class="flex-shrink-0 px-5 py-2 bg-white border border-slate-200 text-slate-600 rounded-full font-label-md hover:bg-slate-50">Electrician</button>
<button class="flex-shrink-0 px-5 py-2 bg-white border border-slate-200 text-slate-600 rounded-full font-label-md hover:bg-slate-50">Builder</button>
<button class="flex-shrink-0 px-5 py-2 bg-white border border-slate-200 text-slate-600 rounded-full font-label-md hover:bg-slate-50">Carpenter</button>
<button class="flex-shrink-0 px-5 py-2 bg-white border border-slate-200 text-slate-600 rounded-full font-label-md hover:bg-slate-50">Painter</button>
</div>
</div>
<!-- Section: Available Now Near You -->
<section class="mt-8">
<div class="px-4 mb-4 flex justify-between items-center">
<h2 class="font-h2 text-h2">Available Now Near You</h2>
<button class="text-primary font-label-md">View all</button>
</div>
<div class="flex gap-4 overflow-x-auto no-scrollbar px-4 pb-4">
<!-- Worker Card 1 -->
<div class="flex-shrink-0 w-64 bg-white rounded-xl shadow-[0_2px_8px_rgba(0,0,0,0.08)] overflow-hidden">
<div class="relative h-40">
<img class="w-full h-full object-cover" data-alt="professional male plumber in blue uniform working with a wrench under a kitchen sink with realistic lighting" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAK6tQUL4-4B5wdoLlMvVQA7CPnCJb2gZQvjKwvfJzECCONH4TTkPCQoz8GRpWnUjP2XyVymGoDg2HkUfXcjGlkxv3-g7aTTO7c80pUFDecG6BZ49-0eyJA_fyRLr83aM0nzRuPYjDacXN7YKUhj5G9zt-nUVAjVoP69n1jSq2DkN-r9O_D5XJj1rdBAm3zKRqjN9X5iFEqZiHCCkt91E0fzMZsvtP4tE3LWMP12ELpbn6ibPuBkUEEZPKcQrnNObCqt9XhuIMXPm4"/>
<div class="absolute top-3 left-3 bg-white/90 backdrop-blur-sm px-2 py-1 rounded-lg flex items-center gap-1 shadow-sm">
<span class="material-symbols-outlined text-[#FBBF24] text-[16px]" style="font-variation-settings: 'FILL' 1;">star</span>
<span class="text-xs font-bold">4.8</span>
</div>
<div class="absolute bottom-3 left-3 bg-emerald-500 text-white text-[10px] font-black px-2 py-1 rounded-full uppercase tracking-tight">Available</div>
</div>
<div class="p-4">
<h3 class="font-h3 text-h3 leading-tight mb-1">Alex Thorne</h3>
<p class="text-slate-500 text-sm mb-3">Master Plumber • 0.3 mi</p>
<button class="w-full bg-primary-container text-white py-2 rounded-lg font-bold active:scale-95 transition-transform">Book Now</button>
</div>
</div>
<!-- Worker Card 2 -->
<div class="flex-shrink-0 w-64 bg-white rounded-xl shadow-[0_2px_8px_rgba(0,0,0,0.08)] overflow-hidden">
<div class="relative h-40">
<img class="w-full h-full object-cover" data-alt="expert electrician focused on installing a modern switch panel in a brightly lit residential interior" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAvcVDcSpIbGuQZD7FryPfMhvfvuj48zZ9QIrcMSu5SnKHfQBkkHO7ZUwFwe-4Eb3UBNHm6l_sym55TVCTt8FWS4dT4lHIx_O5KCOpJ8IzcXc0zSAMNivt6cuaxCVy7RFmbbO43Q1p9wKqUoCsuznLXhBpMk9sViUobj88QTRqD7v5Ict8pYzgVRhyrMpFugw8C48JYPOIFjZDcjmq9nwi8yS_jjv3Z5ghvuVKKzu1s2VnilcQVr9Hxnpcuj2oyZFiJ6J1EersfcwQ"/>
<div class="absolute top-3 left-3 bg-white/90 backdrop-blur-sm px-2 py-1 rounded-lg flex items-center gap-1 shadow-sm">
<span class="material-symbols-outlined text-[#FBBF24] text-[16px]" style="font-variation-settings: 'FILL' 1;">star</span>
<span class="text-xs font-bold">4.9</span>
</div>
<div class="absolute bottom-3 left-3 bg-emerald-500 text-white text-[10px] font-black px-2 py-1 rounded-full uppercase tracking-tight">Available</div>
</div>
<div class="p-4">
<h3 class="font-h3 text-h3 leading-tight mb-1">James Cooper</h3>
<p class="text-slate-500 text-sm mb-3">Electrician • 0.8 mi</p>
<button class="w-full bg-primary-container text-white py-2 rounded-lg font-bold active:scale-95 transition-transform">Book Now</button>
</div>
</div>
<!-- Worker Card 3 -->
<div class="flex-shrink-0 w-64 bg-white rounded-xl shadow-[0_2px_8px_rgba(0,0,0,0.08)] overflow-hidden">
<div class="relative h-40">
<img class="w-full h-full object-cover" data-alt="female carpenter measuring wooden boards in a bright modern workshop with sunlight streaming in" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDy_8kvTzDr5B4jOU-HpPslMh0ksEfys_o5uHkaIUh-w7W36d7OCZ5wCR2O0YpA0JFsJ6soN1DtddqJjd0oct8SzlznfqEdhCccLNK65m6Drg46OJr0kHcfGqr6pcoyQlUwBOK8PkoezGEC20Qdr7HpP3cb_cv_gmnfH5XO52VuUyolPQuhIMXU8nATuV5mdK8t70MyblFsOevd9Ly7nomcOunQ2DLvHTjCAx9UkiVlhc4wz1RCbGO1iV-Si4psdNIYbtNUeEMVY0A"/>
<div class="absolute top-3 left-3 bg-white/90 backdrop-blur-sm px-2 py-1 rounded-lg flex items-center gap-1 shadow-sm">
<span class="material-symbols-outlined text-[#FBBF24] text-[16px]" style="font-variation-settings: 'FILL' 1;">star</span>
<span class="text-xs font-bold">4.7</span>
</div>
<div class="absolute bottom-3 left-3 bg-emerald-500 text-white text-[10px] font-black px-2 py-1 rounded-full uppercase tracking-tight">Available</div>
</div>
<div class="p-4">
<h3 class="font-h3 text-h3 leading-tight mb-1">Sarah Miller</h3>
<p class="text-slate-500 text-sm mb-3">Carpenter • 1.2 mi</p>
<button class="w-full bg-primary-container text-white py-2 rounded-lg font-bold active:scale-95 transition-transform">Book Now</button>
</div>
</div>
</div>
</section>
<!-- Section: Highly Rated -->
<section class="mt-8 px-4">
<h2 class="font-h2 text-h2 mb-4">Highly Rated</h2>
<div class="flex flex-col gap-4">
<!-- Vertical Worker Card 1 -->
<div class="flex gap-4 p-4 bg-white rounded-xl shadow-[0_2px_8px_rgba(0,0,0,0.08)] items-center">
<div class="w-20 h-20 rounded-lg overflow-hidden flex-shrink-0">
<img class="w-full h-full object-cover" data-alt="portrait of an experienced builder in a yellow hard hat smiling with a construction site in the blurred background" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCusYYpxWsElW5M0brmTBvhcogIYMZSGELZD5jMWDSr3UtWI4_acDN4b3mS2aCpdCdRrPxOvTvic-eYg8HS3OBH2ejP71SQgVmM8J0gwLbyoi71_2pfrEjupRvSxdCyCfa2kHkqXLbWcO160LhWeZfGq4o7t3VJEcdIJpYzRROlCarYpX1CVBb3pN7ccgTRwXFZtTgGvA7Or8ZxdcQ0DNH026blbWZRhDbC5K5-2MJXKS7CgCMF3qH7w3fNikaPJ-yWury27qn4iTg"/>
</div>
<div class="flex-grow">
<div class="flex justify-between items-start">
<div>
<h3 class="font-bold text-lg leading-tight">Marcus Wright</h3>
<p class="text-slate-500 text-sm">General Builder</p>
</div>
<div class="flex items-center gap-1">
<span class="material-symbols-outlined text-[#FBBF24] text-sm" style="font-variation-settings: 'FILL' 1;">star</span>
<span class="text-sm font-bold">5.0</span>
</div>
</div>
<div class="mt-2 flex items-center justify-between">
<span class="text-xs text-slate-400">124 projects completed</span>
<span class="text-xs font-semibold text-primary">From £45/hr</span>
</div>
</div>
</div>
<!-- Vertical Worker Card 2 -->
<div class="flex gap-4 p-4 bg-white rounded-xl shadow-[0_2px_8px_rgba(0,0,0,0.08)] items-center">
<div class="w-20 h-20 rounded-lg overflow-hidden flex-shrink-0">
<img class="w-full h-full object-cover" data-alt="professional woman painter in white overalls holding a paint roller in a clean modern room" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBEzE5tye5-W1cZipp_p3u3_2ZLfGkFD5XVylCTnEdtXPpCziWHE2ph8E6qvIMwYck-vSTN7q-ZtKe9qUE1l9xbViFXDMw2gibGL9C29zt6g3saTRf3gWaJMVrdxToNh7Y8vFp3YFKjpOyI8l6LN4AEpKtuLtayKJdcaoTUpoXBStxGlm21xgLQ2EUD4kWU-1wbuFDGD9GuHp3vVMITuC8ggXjv_vsrAIlvhswxqypyzoNxhKbAfUwpeB9SkH6XDAPJIVtx0ojTKY4"/>
</div>
<div class="flex-grow">
<div class="flex justify-between items-start">
<div>
<h3 class="font-bold text-lg leading-tight">Elena Rossi</h3>
<p class="text-slate-500 text-sm">Interior Painter</p>
</div>
<div class="flex items-center gap-1">
<span class="material-symbols-outlined text-[#FBBF24] text-sm" style="font-variation-settings: 'FILL' 1;">star</span>
<span class="text-sm font-bold">4.9</span>
</div>
</div>
<div class="mt-2 flex items-center justify-between">
<span class="text-xs text-slate-400">88 projects completed</span>
<span class="text-xs font-semibold text-primary">From £35/hr</span>
</div>
</div>
</div>
<!-- Vertical Worker Card 3 -->
<div class="flex gap-4 p-4 bg-white rounded-xl shadow-[0_2px_8px_rgba(0,0,0,0.08)] items-center">
<div class="w-20 h-20 rounded-lg overflow-hidden flex-shrink-0">
<img class="w-full h-full object-cover" data-alt="cheerful professional male contractor standing confidently in front of his branded service van" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBzK_v50xulXsVLERaqBiw4k0D0Ldbsc0xVTYTybYzP8DZ7nIxK6rsd5Jg37NcQESqaJE-BS0Eudg9FviTI0CzF2LoFI1pz4Z70rr-pwxuMILQC4_G3pTHpyTGBfJo5n4aUKiPBP3RjWjTrKEzcpfO5LUfdWiecoBnVorelVCT2k5OsF7umDsdCdfLohmkgFoa4jJf-w5f_qpnVK-gBd-Z6Hu5tAXH47bJBg5KVYMbk2aCMo6BXkeDFD_36yj3CNqhyjUGFkjOal08"/>
</div>
<div class="flex-grow">
<div class="flex justify-between items-start">
<div>
<h3 class="font-bold text-lg leading-tight">David Chen</h3>
<p class="text-slate-500 text-sm">Electrician</p>
</div>
<div class="flex items-center gap-1">
<span class="material-symbols-outlined text-[#FBBF24] text-sm" style="font-variation-settings: 'FILL' 1;">star</span>
<span class="text-sm font-bold">4.8</span>
</div>
</div>
<div class="mt-2 flex items-center justify-between">
<span class="text-xs text-slate-400">210 projects completed</span>
<span class="text-xs font-semibold text-primary">From £50/hr</span>
</div>
</div>
</div>
</div>
</section>
</main>
<!-- BottomNavBar Shell -->
<nav class="fixed bottom-0 left-0 w-full z-50 flex justify-around items-center h-16 bg-white dark:bg-slate-900 px-2 pb-safe border-t border-slate-100 dark:border-slate-800 shadow-[0_-2px_8px_rgba(0,0,0,0.08)]">
<a class="flex flex-col items-center justify-center text-orange-600 dark:text-orange-500 bg-orange-50/50 dark:bg-orange-900/20 rounded-xl px-3 py-1 tap-highlight-transparent transition-transform active:scale-90" href="#">
<span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">home</span>
<span class="font-['Inter'] text-[12px] font-medium">Home</span>
</a>
<a class="flex flex-col items-center justify-center text-slate-400 dark:text-slate-500 hover:text-orange-500 dark:hover:text-orange-400 tap-highlight-transparent transition-transform active:scale-90" href="#">
<span class="material-symbols-outlined">map</span>
<span class="font-['Inter'] text-[12px] font-medium">Map</span>
</a>
<a class="flex flex-col items-center justify-center text-slate-400 dark:text-slate-500 hover:text-orange-500 dark:hover:text-orange-400 tap-highlight-transparent transition-transform active:scale-90" href="#">
<span class="material-symbols-outlined">bookmark</span>
<span class="font-['Inter'] text-[12px] font-medium">Bookmarks</span>
</a>
<a class="flex flex-col items-center justify-center text-slate-400 dark:text-slate-500 hover:text-orange-500 dark:hover:text-orange-400 tap-highlight-transparent transition-transform active:scale-90" href="#">
<span class="material-symbols-outlined">person</span>
<span class="font-['Inter'] text-[12px] font-medium">Profile</span>
</a>
</nav>
</body></html>