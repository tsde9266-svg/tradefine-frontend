<!DOCTYPE html>

<html class="light" lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;800;900&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<script id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          "colors": {
            "surface-bright": "#f9f9ff",
            "surface": "#f9f9ff",
            "on-secondary": "#ffffff",
            "on-tertiary-fixed-variant": "#5c4300",
            "on-secondary-container": "#5d1900",
            "on-background": "#141b2b",
            "on-primary-fixed-variant": "#783200",
            "tertiary-container": "#c49200",
            "on-error": "#ffffff",
            "background": "#f9f9ff",
            "surface-container": "#e9edff",
            "on-tertiary-fixed": "#261a00",
            "on-surface-variant": "#584237",
            "primary-fixed-dim": "#ffb690",
            "secondary": "#ac3400",
            "secondary-fixed-dim": "#ffb59d",
            "surface-container-highest": "#dce2f7",
            "on-error-container": "#93000a",
            "on-tertiary-container": "#422f00",
            "surface-tint": "#9d4300",
            "on-primary-container": "#582200",
            "outline-variant": "#e0c0b1",
            "secondary-fixed": "#ffdbd0",
            "primary-container": "#f97316",
            "surface-container-low": "#f1f3ff",
            "primary-fixed": "#ffdbca",
            "on-secondary-fixed": "#390c00",
            "tertiary-fixed": "#ffdf9f",
            "inverse-on-surface": "#edf0ff",
            "on-surface": "#141b2b",
            "outline": "#8c7164",
            "on-secondary-fixed-variant": "#832600",
            "surface-container-lowest": "#ffffff",
            "surface-variant": "#dce2f7",
            "primary": "#9d4300",
            "surface-container-high": "#e1e8fd",
            "on-tertiary": "#ffffff",
            "secondary-container": "#fd6b36",
            "tertiary": "#795900",
            "error-container": "#ffdad6",
            "on-primary-fixed": "#341100",
            "tertiary-fixed-dim": "#f9bd22",
            "error": "#ba1a1a",
            "inverse-primary": "#ffb690",
            "on-primary": "#ffffff",
            "surface-dim": "#d3daef",
            "inverse-surface": "#293040"
          },
          "borderRadius": {
            "DEFAULT": "0.25rem",
            "lg": "0.5rem",
            "xl": "0.75rem",
            "full": "9999px"
          },
          "spacing": {
            "sm": "12px",
            "gutter": "12px",
            "lg": "24px",
            "xs": "8px",
            "md": "16px",
            "base": "4px",
            "xl": "32px",
            "margin": "16px"
          },
          "fontFamily": {
            "h2": ["Inter"],
            "label-md": ["Inter"],
            "body-md": ["Inter"],
            "h1": ["Inter"],
            "h3": ["Inter"],
            "body-lg": ["Inter"]
          },
          "fontSize": {
            "h2": ["24px", {"lineHeight": "30px", "letterSpacing": "-0.01em", "fontWeight": "700"}],
            "label-md": ["12px", {"lineHeight": "16px", "letterSpacing": "0.02em", "fontWeight": "500"}],
            "body-md": ["14px", {"lineHeight": "20px", "fontWeight": "400"}],
            "h1": ["28px", {"lineHeight": "34px", "letterSpacing": "-0.02em", "fontWeight": "700"}],
            "h3": ["20px", {"lineHeight": "26px", "letterSpacing": "0em", "fontWeight": "700"}],
            "body-lg": ["16px", {"lineHeight": "24px", "fontWeight": "400"}]
          }
        },
      },
    }
  </script>
<style>
    .material-symbols-outlined {
      font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    }
    .pb-safe {
      padding-bottom: env(safe-area-inset-bottom);
    }
    .bg-glass {
      background: rgba(255, 255, 255, 0.7);
      backdrop-filter: blur(10px);
    }
  </style>
<style>
    body {
      min-height: max(884px, 100dvh);
    }
  </style>
  </head>
<body class="bg-surface font-body-md text-on-surface">
<!-- Top Navigation (Shell Invisible for Detailed Task Profile per Logic) -->
<header class="sticky top-0 z-50 flex justify-between items-center w-full px-4 h-16 bg-[#F9FAFB] border-b border-slate-200 font-['Inter'] antialiased tracking-tight">
<div class="flex items-center gap-2">
<button class="p-2 hover:bg-slate-100 rounded-full transition-colors active:scale-95 duration-150">
<span class="material-symbols-outlined text-slate-700">arrow_back</span>
</button>
<span class="text-2xl font-black text-orange-600">TradeFind</span>
</div>
<div class="flex gap-2">
<button class="p-2 hover:bg-slate-100 rounded-full transition-colors active:scale-95 duration-150">
<span class="material-symbols-outlined text-slate-700" data-icon="share">share</span>
</button>
<button class="p-2 hover:bg-slate-100 rounded-full transition-colors active:scale-95 duration-150">
<span class="material-symbols-outlined text-slate-700" data-icon="more_vert">more_vert</span>
</button>
</div>
</header>
<main class="max-w-3xl mx-auto pb-32">
<!-- Hero Section -->
<section class="relative h-48 md:h-64 w-full">
<div class="absolute inset-0 bg-slate-200">
<img class="w-full h-full object-cover" data-alt="Modern high-end residential plumbing installation with copper pipes and professional tools in a clean organized workshop setting" src="https://lh3.googleusercontent.com/aida-public/AB6AXuApNpn7oEReH01XdWUUvnBnBbVFcGBL6cVMLWYWlBzkpwBAL7Ugq0e7xCDJbBRD9B2-tTTi-dv_yRBtj4Cc1kB_QNOtNiZk915lbCUMHxNwd7CyD7PcYBD_1Y1EA8-YRU5Oh_u2AAV3DHt_6ETQIKyMIhM19yX-KLigD3PHh6gM7t4opTW-bDaYFEP-4-97FXX4bIqQyvqWEEBFJQXwKRQOjB_T6gFl13_229VCmYdqBJgLOjBNOQgETOb2qec_qA6yXaV_a2cHt7o"/>
</div>
<div class="absolute -bottom-12 left-margin">
<div class="relative">
<img class="w-24 h-24 md:w-32 md:h-32 rounded-full border-4 border-white shadow-lg object-cover" data-alt="Professional male plumber in his 40s smiling confidently, wearing a professional navy blue work polo with a clear background" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCufCVz7bgpB7gBtPRYqUlY8ZG83FSKIS2KaeFAlm6MkxeyipLoSMMmrC1gu3XiB5dES5zQvvEw8iUfViE13zts-ttccTtQ3HvXYCKlmw4MqQmkVQw8TOHGEQCdQ0Yc916GiG6_9uc9oFgyd8GEe4L9qDjtCsj2aY0Q7jYAdhS9zjanAN1I7zosx4jxWNFhV2bGEdLBPzVKFjxL6s3ZQ9FgNyeNnKYqipbYyJW8cl9VDHHNWxrxnRXRySb2EVUfMP_P4nPEA31-7Zs"/>
<div class="absolute bottom-1 right-1 w-6 h-6 bg-green-500 border-4 border-white rounded-full"></div>
</div>
</div>
</section>
<!-- Header Content -->
<div class="mt-16 px-margin">
<div class="flex justify-between items-start">
<div>
<h1 class="font-h1 text-h1 text-on-surface">James O'Brien</h1>
<p class="font-body-lg text-body-lg text-slate-500">Plumber &amp; Gas Engineer</p>
</div>
<div class="bg-green-50 text-green-700 px-3 py-1 rounded-full text-label-md font-label-md flex items-center gap-1">
<span class="w-2 h-2 bg-green-500 rounded-full"></span>
          Available Now
        </div>
</div>
<div class="flex items-center gap-4 mt-4">
<div class="flex items-center gap-1">
<span class="material-symbols-outlined text-[#FBBF24]" style="font-variation-settings: 'FILL' 1;">star</span>
<span class="font-bold">4.9</span>
<span class="text-slate-400 font-label-md">(47 reviews)</span>
</div>
<div class="w-1 h-1 bg-slate-300 rounded-full"></div>
<div class="flex items-center gap-1 text-slate-600">
<span class="material-symbols-outlined text-sm">location_on</span>
<span class="text-body-md">0.4 mi away</span>
</div>
</div>
</div>
<!-- Quick Actions Bento -->
<div class="mt-8 px-margin grid grid-cols-2 gap-gutter">
<div class="col-span-2 bg-surface-container-low p-4 rounded-xl flex items-center justify-between shadow-sm border border-slate-100">
<div class="flex items-center gap-3">
<div class="bg-primary-container/10 p-2 rounded-lg">
<span class="material-symbols-outlined text-primary-container">near_me</span>
</div>
<div>
<p class="text-label-md font-bold text-on-surface">Live Location</p>
<p class="text-[12px] text-slate-500">En route to job near B1</p>
</div>
</div>
<button class="bg-white text-on-surface border border-slate-200 px-4 py-2 rounded-lg text-label-md font-bold hover:bg-slate-50 transition-colors shadow-sm">
          Track James on map
        </button>
</div>
<div class="bg-white p-4 rounded-xl shadow-sm border border-slate-100 flex flex-col gap-2">
<span class="material-symbols-outlined text-orange-500">verified</span>
<p class="text-label-md font-bold">Gas Safe Registered</p>
<p class="text-[12px] text-slate-500">ID: 554302</p>
</div>
<div class="bg-white p-4 rounded-xl shadow-sm border border-slate-100 flex flex-col gap-2">
<span class="material-symbols-outlined text-orange-500">history</span>
<p class="text-label-md font-bold">12 yrs exp</p>
<p class="text-[12px] text-slate-500">Master Craftsman</p>
</div>
</div>
<!-- Tabs -->
<div class="mt-8 border-b border-slate-200">
<div class="flex px-margin gap-8">
<button class="pb-4 border-b-2 border-orange-600 text-orange-600 font-bold text-body-md">About</button>
<button class="pb-4 text-slate-500 font-medium text-body-md">Reviews</button>
<button class="pb-4 text-slate-500 font-medium text-body-md">Photos</button>
</div>
</div>
<!-- Tab Content: About -->
<div class="px-margin py-8 space-y-8">
<div>
<h3 class="font-h3 text-h3 mb-3">Bio</h3>
<p class="text-body-md text-slate-600 leading-relaxed">
          I provide professional plumbing and gas services across Birmingham. Specializing in high-efficiency boiler installations and emergency leak repairs. Fully insured and Gas Safe Registered. I pride myself on punctuality and clear communication.
        </p>
</div>
<div>
<h3 class="font-h3 text-h3 mb-3">Service Area</h3>
<div class="relative h-40 w-full rounded-xl overflow-hidden mb-2">
<img class="w-full h-full object-cover" data-alt="Stylized map showing the West Midlands area with Birmingham city center highlighted in a clean minimalist design" data-location="Birmingham" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDb_62sm2-EF3FMc_De_5uQhR806BOS0cWkiH_vjdrl2RQQlvicZHXxfhu2ziUKz2a7uMXsPBy5FXu3Z5h1FRH1opzUyxpDE6jAsa28SNjNzidGt9nlZnGjc1m7oBYFN8-wf34GpxTcsFliSyhDN0NIGPoKwDQ7v33G-6GoPB_YASYhO3DhUBZ-m-UF1JWYtagY8MHyVqmcfbyx3SKF-CIX9YSE17hG5hMrqJu72sca18TDx5x0Q6YGwsD43MxkNrWJbqvFUeALBcA"/>
<div class="absolute inset-0 bg-orange-600/10 border-2 border-orange-600/30 rounded-xl"></div>
</div>
<p class="text-body-md text-slate-600">Covers Birmingham and surrounding areas (up to 15mi radius).</p>
</div>
<div>
<h3 class="font-h3 text-h3 mb-4">Core Services</h3>
<div class="flex flex-wrap gap-2">
<div class="bg-white border border-slate-200 rounded-xl p-4 flex-1 min-w-[140px]">
<span class="material-symbols-outlined text-orange-500 mb-2">thermostat</span>
<p class="font-bold text-body-md">Boiler repair</p>
<p class="text-label-md text-slate-500 mt-1">From £80</p>
</div>
<div class="bg-white border border-slate-200 rounded-xl p-4 flex-1 min-w-[140px]">
<span class="material-symbols-outlined text-orange-500 mb-2">water_drop</span>
<p class="font-bold text-body-md">Leak fix</p>
<p class="text-label-md text-slate-500 mt-1">From £45</p>
</div>
<div class="bg-white border border-slate-200 rounded-xl p-4 flex-1 min-w-[140px]">
<span class="material-symbols-outlined text-orange-500 mb-2">plumbing</span>
<p class="font-bold text-body-md">Pipework</p>
<p class="text-label-md text-slate-500 mt-1">Quote based</p>
</div>
</div>
</div>
</div>
</main>
<!-- Persistent Action Bar -->
<div class="fixed bottom-0 left-0 w-full bg-white/80 backdrop-blur-md border-t border-slate-100 px-margin py-4 z-50 flex items-center gap-4 pb-safe">
<button class="p-4 rounded-xl border border-slate-200 text-slate-600 active:scale-90 transition-transform">
<span class="material-symbols-outlined" data-icon="bookmark">bookmark</span>
</button>
<button class="flex-1 bg-orange-600 text-white font-bold h-14 rounded-xl flex items-center justify-center gap-2 active:scale-95 transition-transform shadow-lg shadow-orange-600/20">
<span class="material-symbols-outlined">call</span>
      Call Now
    </button>
</div>
</body></html>