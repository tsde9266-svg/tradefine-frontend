                                        </div>
<div class="flex items-center gap-3 text-body-md font-body-md text-on-surface">
<span class="material-symbols-outlined text-primary text-sm" data-icon="location_on">location_on</span>
                                            Brighton, United Kingdom
                                        </div>
</div>
</div>
<div>
