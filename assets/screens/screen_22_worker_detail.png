                        Active
                    </span>
<span class="px-3 py-1 bg-surface-container-high text-on-surface rounded-full text-label-md font-label-md">
                        ID: TF-98234-RT
                    </span>
</div>
</div>
<!-- Bento Grid Layout -->
<div class="grid grid-cols-12 gap-6">
