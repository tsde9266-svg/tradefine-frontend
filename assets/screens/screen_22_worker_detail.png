<img class="w-full h-full object-cover" data-alt="clean light style map showing the service radius of a worker in Brighton, UK area with orange highlight zone" data-location="Brighton" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBlHWV_79bbFxt-TSARP9cB8ndZExVbd0ShVfbSjwT26TV-az0wLYwg8RkNfkinLwMeY_LG2y2vjqaHZg8GdOdRFWRTD0EF7QLpTFeUG2zWRgB_0mO50pmbCWywbL-bNRbYi_vXA0MVdua1gzFubPk4PEX5yW_AAHjOpTXUo7ftnD-lA7N76lZYMzdmbiipz4oj1P7aD-lbPVzzBbcW6PutDXqyIhoSZh8psSyU-ccAI3lqe-zZ11W-m9EL0auLOZUT0mdiISa0PcQ"/>
</div>
