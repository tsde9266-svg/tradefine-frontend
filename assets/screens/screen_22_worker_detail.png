<span class="material-symbols-outlined text-sm" data-icon="star" data-weight="fill">star</span>
<span class="material-symbols-outlined text-sm" data-icon="star" data-weight="fill">star</span>
<span class="material-symbols-outlined text-sm" data-icon="star" data-weight="fill">star</span>
<span class="material-symbols-outlined text-sm" data-icon="star" data-weight="fill">star</span>
