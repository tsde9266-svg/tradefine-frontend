<!-- Main Content Area -->
<main class="pl-64 flex flex-col min-h-screen">
<!-- TopNavBar -->
<header class="flex justify-between items-center px-6 w-full sticky top-0 z-40 bg-white h-16 border-b border-slate-200 shadow-sm font-sans antialiased text-sm font-medium">
<div class="flex items-center gap-4 flex-1">
<div class="relative w-96">
