<!DOCTYPE html>

<html class="light" lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0, viewport-fit=cover" name="viewport"/>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;800;900&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "surface-bright": "#f9f9ff",
                        "surface": "#f9f9ff",
                        "on-secondary": "#ffffff",
                        "on-tertiary-fixed-variant": "#5c4300",
                        "on-secondary-container": "#5d1900",
                        "on-background": "#141b2b",
                        "on-primary-fixed-variant": "#783200",
                        "tertiary-container": "#c49200",
                        "on-error": "#ffffff",
                        "background": "#f9f9ff",
                        "surface-container": "#e9edff",
                        "on-tertiary-fixed": "#261a00",
                        "on-surface-variant": "#584237",
                        "primary-fixed-dim": "#ffb690",
                        "secondary": "#ac3400",
                        "secondary-fixed-dim": "#ffb59d",
                        "surface-container-highest": "#dce2f7",
                        "on-error-container": "#93000a",
                        "on-tertiary-container": "#422f00",
                        "surface-tint": "#9d4300",
                        "on-primary-container": "#582200",
                        "outline-variant": "#e0c0b1",
                        "secondary-fixed": "#ffdbd0",
                        "primary-container": "#f97316",
                        "surface-container-low": "#f1f3ff",
                        "primary-fixed": "#ffdbca",
                        "on-secondary-fixed": "#390c00",
                        "tertiary-fixed": "#ffdf9f",
                        "inverse-on-surface": "#edf0ff",
                        "on-surface": "#141b2b",
                        "outline": "#8c7164",
                        "on-secondary-fixed-variant": "#832600",
                        "surface-container-lowest": "#ffffff",
                        "surface-variant": "#dce2f7",
                        "primary": "#9d4300",
                        "surface-container-high": "#e1e8fd",
                        "on-tertiary": "#ffffff",
                        "secondary-container": "#fd6b36",
                        "tertiary": "#795900",
                        "error-container": "#ffdad6",
                        "on-primary-fixed": "#341100",
                        "tertiary-fixed-dim": "#f9bd22",
                        "error": "#ba1a1a",
                        "inverse-primary": "#ffb690",
                        "on-primary": "#ffffff",
                        "surface-dim": "#d3daef",
                        "inverse-surface": "#293040"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    "spacing": {
                        "sm": "12px",
                        "gutter": "12px",
                        "lg": "24px",
                        "xs": "8px",
                        "md": "16px",
                        "base": "4px",
                        "xl": "32px",
                        "margin": "16px"
                    },
                    "fontFamily": {
                        "h2": ["Inter"],
                        "label-md": ["Inter"],
                        "body-md": ["Inter"],
                        "h1": ["Inter"],
                        "h3": ["Inter"],
                        "body-lg": ["Inter"]
                    },
                    "fontSize": {
                        "h2": ["24px", {"lineHeight": "30px", "letterSpacing": "-0.01em", "fontWeight": "700"}],
                        "label-md": ["12px", {"lineHeight": "16px", "letterSpacing": "0.02em", "fontWeight": "500"}],
                        "body-md": ["14px", {"lineHeight": "20px", "fontWeight": "400"}],
                        "h1": ["28px", {"lineHeight": "34px", "letterSpacing": "-0.02em", "fontWeight": "700"}],
                        "h3": ["20px", {"lineHeight": "26px", "letterSpacing": "0em", "fontWeight": "700"}],
                        "body-lg": ["16px", {"lineHeight": "24px", "fontWeight": "400"}]
                    }
                },
            },
        }
    </script>
<style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        .pb-safe {
            padding-bottom: env(safe-area-inset-bottom);
        }
        .tap-highlight-transparent {
            -webkit-tap-highlight-color: transparent;
        }
    </style>
<style>
    body {
      min-height: max(884px, 100dvh);
    }
  </style>
  </head>
<body class="bg-surface text-on-surface font-body-md">
<!-- TopAppBar -->
<header class="sticky top-0 z-50 flex justify-between items-center w-full px-4 h-16 bg-[#F9FAFB] border-b border-slate-200 antialiased font-['Inter'] tracking-tight">
<div class="flex items-center gap-3">
<button class="material-symbols-outlined text-slate-500 hover:bg-slate-100 transition-colors p-2 rounded-full">menu</button>
<span class="text-2xl font-black text-orange-600">TradeFind</span>
</div>
<div class="flex items-center gap-2">
<div class="w-10 h-10 rounded-full overflow-hidden border-2 border-white shadow-sm">
<img alt="User Profile" class="w-full h-full object-cover" data-alt="Professional headshot of a friendly tradesperson wearing a clean polo shirt, soft studio lighting with warm tones" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAQUhZ7Mese-YyU8DMA05j5-x1efMFpQ5zmjIhelzAZVWxiBG4i9AWrz8oDsi6qKjQ70aCrsPlzuhGmbM6FaU_MgGO1ynf7BietTILF1MfptSxkcellLFJtEnK0xBq4CskfY0mqc2sszWJ9itk2e0kStsQbuvjTiySP5DEHNba9YoRwylYwq_6CAeEtKTYTfikJY-MEWltDKAmHzhuv3jnZs1yaR_MzUdpAG08Lbcnyvl59MQJ2HHvUv8WpqUSFuYbRbnPLq08XXzg"/>
</div>
</div>
</header>
<main class="px-4 pt-6 pb-24 max-w-2xl mx-auto space-y-6">
<!-- Welcome Header -->
<div class="flex flex-col gap-1">
<h1 class="font-h1 text-h1 text-on-background">Good morning, James 👋</h1>
<p class="font-body-md text-on-surface-variant">Here is what's happening with your business today.</p>
</div>
<!-- Availability Toggle Card (OFF State) -->
<section class="bg-slate-100 p-6 rounded-xl border border-slate-200 flex flex-col md:flex-row md:items-center justify-between gap-4 shadow-[0_2px_8px_rgba(0,0,0,0.08)]">
<div class="flex items-start gap-4">
<div class="bg-slate-200 p-3 rounded-full">
<span class="material-symbols-outlined text-slate-500 text-3xl">visibility_off</span>
</div>
<div>
<h3 class="font-h3 text-h3 text-slate-700">You're currently invisible to customers</h3>
<p class="font-body-md text-slate-500">Go available to start receiving new service inquiries.</p>
</div>
</div>
<button class="bg-primary-container text-white px-6 py-3 rounded-lg font-bold font-h3 text-lg hover:opacity-90 active:scale-95 duration-150 shadow-lg">
                Go Available
            </button>
</section>
<!-- Stats Bento Grid -->
<section class="grid grid-cols-2 md:grid-cols-3 gap-3">
<div class="bg-white p-4 rounded-xl shadow-[0_2px_8px_rgba(0,0,0,0.08)] border border-surface-container flex flex-col gap-1">
<span class="font-label-md text-on-surface-variant flex items-center gap-1 uppercase tracking-wider">
<span class="material-symbols-outlined text-[16px]">visibility</span> Profile Views
                </span>
<span class="font-h2 text-h2 text-on-background">124</span>
<span class="text-xs font-bold text-green-600 flex items-center">+12% vs yest.</span>
</div>
<div class="bg-white p-4 rounded-xl shadow-[0_2px_8px_rgba(0,0,0,0.08)] border border-surface-container flex flex-col gap-1">
<span class="font-label-md text-on-surface-variant flex items-center gap-1 uppercase tracking-wider">
<span class="material-symbols-outlined text-[16px]">call</span> Calls Received
                </span>
<span class="font-h2 text-h2 text-on-background">8</span>
<span class="text-xs font-bold text-on-surface-variant flex items-center">Steady</span>
</div>
<div class="bg-white p-4 rounded-xl shadow-[0_2px_8px_rgba(0,0,0,0.08)] border border-surface-container flex flex-col gap-1 col-span-2 md:col-span-1">
<span class="font-label-md text-on-surface-variant flex items-center gap-1 uppercase tracking-wider">
<span class="material-symbols-outlined text-[16px]">star</span> New Reviews
                </span>
<div class="flex items-center gap-2">
<span class="font-h2 text-h2 text-on-background">3</span>
<div class="flex text-[#FBBF24]">
<span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">star</span>
<span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">star</span>
</div>
</div>
<span class="text-xs font-bold text-green-600">All 5-star</span>
</div>
</section>
<!-- Recent Activity List -->
<section class="space-y-4">
<div class="flex justify-between items-center px-1">
<h3 class="font-h3 text-h3 text-on-background">Recent activity</h3>
<button class="text-primary font-bold text-sm">View all</button>
</div>
<div class="bg-white rounded-xl shadow-[0_2px_8px_rgba(0,0,0,0.08)] border border-surface-container divide-y divide-slate-100">
<div class="p-4 flex items-center gap-4 hover:bg-slate-50 transition-colors cursor-pointer">
<div class="w-12 h-12 rounded-full overflow-hidden bg-slate-200 shrink-0">
<img class="w-full h-full object-cover" data-alt="Portrait of a female client, bright outdoor daylight, high quality corporate photography style" src="https://lh3.googleusercontent.com/aida-public/AB6AXuALuDsO_vcpG2axDTVBlfS59oe-StAW8N2Jg0kRAedRgtLinNH6xkCcROtU3hb03PiNCTxi7oXdvz1yqGXfQGckTo7TKHDmAtaZ08meQtAPg6g8sXDQKFDEg6fcnSr0GyBEy0EkvFNUD7FBQXi4aS3FQixehzKnwzS0JwTL4Y39h2_iKvquuVjXJByju44-wfOElhkpeYmVeacMZqh14T0SOYSe0IhXzmI6pNolX7q1SdgyAdXzs1ykfnDxu2NC-f0crOzMgMNjN8A"/>
</div>
<div class="flex-1">
<p class="font-bold text-on-background">Sarah Miller <span class="font-normal text-on-surface-variant">saved your profile</span></p>
<p class="text-xs text-on-surface-variant">2 hours ago</p>
</div>
<span class="material-symbols-outlined text-slate-400">bookmark</span>
</div>
<div class="p-4 flex items-center gap-4 hover:bg-slate-50 transition-colors cursor-pointer">
<div class="w-12 h-12 rounded-full overflow-hidden bg-slate-200 shrink-0">
<img class="w-full h-full object-cover" data-alt="Portrait of a male client in a modern home office setting, natural window light, sharp focus" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBmKnjbHgzO6FwJDooHHpn9gc0hX48cvB6zlADoqXdAPo7BzaB3wznujKRCsfzsaVjYnw0GCoe9UmNeloFhzcmCJjCiZsCQWdSOt2S8fbvsMvUb31Rwu8DrvyYDX5nAcKLqGnpTAOxp18CXbcR49nvRKEHU5JhH4Wg96CC5tn-mKFDY-R4qMf_Bbz8cAAhO6QdufpUNMXaMluQvDPI5Hxi9fdTGZA_aLt7P92cl67KrNx2bnmJPmOjkrGhK6jt6IjQy6RBZqrzNUpQ"/>
</div>
<div class="flex-1">
<p class="font-bold text-on-background">John David <span class="font-normal text-on-surface-variant">left a review</span></p>
<p class="text-xs text-on-surface-variant">5 hours ago • "Great work on the plumbing!"</p>
</div>
<div class="flex text-[#FBBF24]">
<span class="material-symbols-outlined text-[18px]" style="font-variation-settings: 'FILL' 1;">star</span>
</div>
</div>
<div class="p-4 flex items-center gap-4 hover:bg-slate-50 transition-colors cursor-pointer">
<div class="w-12 h-12 rounded-full bg-orange-100 text-orange-600 flex items-center justify-center shrink-0">
<span class="material-symbols-outlined">call</span>
</div>
<div class="flex-1">
<p class="font-bold text-on-background">Missed Call <span class="font-normal text-on-surface-variant">from 078 9920 331</span></p>
<p class="text-xs text-on-surface-variant">Yesterday at 6:45 PM</p>
</div>
<span class="material-symbols-outlined text-slate-400">chevron_right</span>
</div>
</div>
</section>
<!-- Quick Actions -->
<section class="space-y-4">
<h3 class="font-h3 text-h3 text-on-background px-1">Quick actions</h3>
<div class="grid grid-cols-3 gap-4">
<button class="flex flex-col items-center gap-2 group">
<div class="w-14 h-14 rounded-2xl bg-white shadow-sm border border-slate-200 flex items-center justify-center text-on-surface-variant group-hover:text-primary group-hover:border-primary transition-all duration-200 group-active:scale-95">
<span class="material-symbols-outlined text-2xl">edit_note</span>
</div>
<span class="font-label-md text-on-surface-variant">Edit Profile</span>
</button>
<button class="flex flex-col items-center gap-2 group">
<div class="w-14 h-14 rounded-2xl bg-white shadow-sm border border-slate-200 flex items-center justify-center text-on-surface-variant group-hover:text-primary group-hover:border-primary transition-all duration-200 group-active:scale-95">
<span class="material-symbols-outlined text-2xl">reviews</span>
</div>
<span class="font-label-md text-on-surface-variant">View Reviews</span>
</button>
<button class="flex flex-col items-center gap-2 group">
<div class="w-14 h-14 rounded-2xl bg-white shadow-sm border border-slate-200 flex items-center justify-center text-on-surface-variant group-hover:text-primary group-hover:border-primary transition-all duration-200 group-active:scale-95">
<span class="material-symbols-outlined text-2xl">ios_share</span>
</div>
<span class="font-label-md text-on-surface-variant">Share Profile</span>
</button>
</div>
</section>
</main>
<!-- BottomNavBar -->
<nav class="fixed bottom-0 left-0 w-full z-50 flex justify-around items-center h-16 bg-white dark:bg-slate-900 px-2 pb-safe border-t border-slate-100 shadow-[0_-2px_8px_rgba(0,0,0,0.08)]">
<a class="flex flex-col items-center justify-center text-orange-600 bg-orange-50/50 rounded-xl px-3 py-1 tap-highlight-transparent transition-transform active:scale-90" href="#">
<span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">home</span>
<span class="font-['Inter'] text-[12px] font-medium">Home</span>
</a>
<a class="flex flex-col items-center justify-center text-slate-400 hover:text-orange-500 tap-highlight-transparent transition-transform active:scale-90" href="#">
<span class="material-symbols-outlined">map</span>
<span class="font-['Inter'] text-[12px] font-medium">Map</span>
</a>
<a class="flex flex-col items-center justify-center text-slate-400 hover:text-orange-500 tap-highlight-transparent transition-transform active:scale-90" href="#">
<span class="material-symbols-outlined">bookmark</span>
<span class="font-['Inter'] text-[12px] font-medium">Bookmarks</span>
</a>
<a class="flex flex-col items-center justify-center text-slate-400 hover:text-orange-500 tap-highlight-transparent transition-transform active:scale-90" href="#">
<span class="material-symbols-outlined">person</span>
<span class="font-['Inter'] text-[12px] font-medium">Profile</span>
</a>
</nav>
</body></html>