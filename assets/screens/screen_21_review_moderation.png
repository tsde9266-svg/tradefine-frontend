<!DOCTYPE html>

<html class="light" lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&amp;family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script id="tailwind-config">
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            "colors": {
                    "tertiary-fixed": "#ffdf9f",
                    "surface-tint": "#9d4300",
                    "surface-container-low": "#f1f3ff",
                    "tertiary-container": "#c49200",
                    "surface-container-high": "#e1e8fd",
                    "on-secondary-fixed-variant": "#832600",
                    "on-primary": "#ffffff",
                    "secondary-fixed": "#ffdbd0",
                    "on-secondary": "#ffffff",
                    "on-primary-container": "#582200",
                    "secondary": "#ac3400",
                    "on-secondary-container": "#5d1900",
                    "on-background": "#141b2b",
                    "surface-dim": "#d3daef",
                    "outline": "#8c7164",
                    "on-error": "#ffffff",
                    "surface-variant": "#dce2f7",
                    "error": "#ba1a1a",
                    "surface-container-lowest": "#ffffff",
                    "primary-fixed": "#ffdbca",
                    "primary": "#9d4300",
                    "on-tertiary-fixed-variant": "#5c4300",
                    "tertiary": "#795900",
                    "surface-container": "#e9edff",
                    "primary-fixed-dim": "#ffb690",
                    "on-tertiary-fixed": "#261a00",
                    "on-error-container": "#93000a",
                    "background": "#f9f9ff",
                    "surface": "#f9f9ff",
                    "secondary-container": "#fd6b36",
                    "on-surface-variant": "#584237",
                    "outline-variant": "#e0c0b1",
                    "on-surface": "#141b2b",
                    "inverse-on-surface": "#edf0ff",
                    "on-secondary-fixed": "#390c00",
                    "error-container": "#ffdad6",
                    "inverse-surface": "#293040",
                    "secondary-fixed-dim": "#ffb59d",
                    "on-primary-fixed-variant": "#783200",
                    "tertiary-fixed-dim": "#f9bd22",
                    "primary-container": "#f97316",
                    "on-tertiary-container": "#422f00",
                    "on-primary-fixed": "#341100",
                    "inverse-primary": "#ffb690",
                    "on-tertiary": "#ffffff",
                    "surface-container-highest": "#dce2f7",
                    "surface-bright": "#f9f9ff"
            },
            "borderRadius": {
                    "DEFAULT": "0.25rem",
                    "lg": "0.5rem",
                    "xl": "0.75rem",
                    "full": "9999px"
            },
            "spacing": {
                    "margin": "16px",
                    "xs": "8px",
                    "lg": "24px",
                    "gutter": "12px",
                    "xl": "32px",
                    "sm": "12px",
                    "base": "4px",
                    "md": "16px"
            },
            "fontFamily": {
                    "label-md": ["Inter"],
                    "h2": ["Inter"],
                    "body-lg": ["Inter"],
                    "h3": ["Inter"],
                    "h1": ["Inter"],
                    "body-md": ["Inter"]
            },
            "fontSize": {
                    "label-md": ["12px", {"lineHeight": "16px", "letterSpacing": "0.02em", "fontWeight": "500"}],
                    "h2": ["24px", {"lineHeight": "30px", "letterSpacing": "-0.01em", "fontWeight": "700"}],
                    "body-lg": ["16px", {"lineHeight": "24px", "fontWeight": "400"}],
                    "h3": ["20px", {"lineHeight": "26px", "letterSpacing": "0em", "fontWeight": "700"}],
                    "h1": ["28px", {"lineHeight": "34px", "letterSpacing": "-0.02em", "fontWeight": "700"}],
                    "body-md": ["14px", {"lineHeight": "20px", "fontWeight": "400"}]
            }
          },
        },
      }
    </script>
<style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        .fill-icon {
            font-variation-settings: 'FILL' 1;
        }
    </style>
</head>
<body class="bg-background font-body-md text-on-background min-h-screen">
<!-- SideNavBar Shell -->
<aside class="flex flex-col py-6 h-screen w-64 fixed left-0 bg-slate-900 border-r border-slate-800 shadow-xl z-50">
<div class="px-6 mb-8">
<span class="text-2xl font-black text-orange-500 font-h1">TradeFind</span>
<p class="text-slate-400 font-label-md mt-1">Enterprise Admin</p>
</div>
<nav class="flex-1 space-y-1">
<a class="flex items-center gap-3 px-4 py-3 text-slate-400 hover:text-white mx-2 transition-colors font-sans text-sm font-semibold" href="#">
<span class="material-symbols-outlined" data-icon="dashboard">dashboard</span>
<span>Dashboard</span>
</a>
<a class="flex items-center gap-3 px-4 py-3 text-slate-400 hover:text-white mx-2 transition-colors font-sans text-sm font-semibold" href="#">
<span class="material-symbols-outlined" data-icon="engineering">engineering</span>
<span>Tradespeople</span>
</a>
<a class="flex items-center gap-3 px-4 py-3 bg-orange-600 text-white rounded-lg mx-2 font-sans text-sm font-semibold" href="#">
<span class="material-symbols-outlined fill-icon" data-icon="pending_actions" style="font-variation-settings: 'FILL' 1;">pending_actions</span>
<span>Requests</span>
</a>
<a class="flex items-center gap-3 px-4 py-3 text-slate-400 hover:text-white mx-2 transition-colors font-sans text-sm font-semibold" href="#">
<span class="material-symbols-outlined" data-icon="leaderboard">leaderboard</span>
<span>Analytics</span>
</a>
<a class="flex items-center gap-3 px-4 py-3 text-slate-400 hover:text-white mx-2 transition-colors font-sans text-sm font-semibold" href="#">
<span class="material-symbols-outlined" data-icon="settings">settings</span>
<span>Settings</span>
</a>
</nav>
<div class="px-4 py-4 border-t border-slate-800">
<div class="flex items-center gap-3 px-2">
<img alt="Admin User Profile" class="w-10 h-10 rounded-full object-cover" data-alt="Professional headshot of a mature businessman in a sharp navy suit, clean studio background, corporate photography style" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAm54ykUAWf6U6v1TkG-BLTC8Uq0dgdfyJG5vTUUUEEqMe1BHjpUYP-MyRP0EJ9bABm5BTMTt54PGnIFUPY3iw3R1yUPy5eVdBzOwzg7P-KIjzigXl4iWlKxRtYabBgV6ac9Jd6QbC1Wypm4VXMxP-TMioD62ZTAjelKiYANWENQyHZ8LUhXixagpdRn5gH9dnTUnLtjHD-eKOt8rCJouvCa1BtexmsYgc8u7_T5ElglYeLJUrl9YYwGECrpfBpZa4CNdKMs2B_gyo"/>
<div class="overflow-hidden">
<p class="text-white text-sm font-bold truncate">Alexander Vance</p>
<p class="text-slate-500 text-xs truncate">Head of Moderation</p>
</div>
</div>
</div>
</aside>
<!-- Main Content Wrapper -->
<div class="ml-64 flex flex-col min-h-screen">
<!-- TopNavBar Shell -->
<header class="flex justify-between items-center px-6 w-full sticky top-0 z-40 bg-white border-b border-slate-200 h-16 shadow-sm">
<div class="flex items-center gap-4 flex-1">
<div class="relative w-96">
<span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-lg" data-icon="search">search</span>
<input class="w-full pl-10 pr-4 py-2 bg-slate-50 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-orange-600" placeholder="Search flagged content..." type="text"/>
</div>
</div>
<div class="flex items-center gap-4">
<button class="p-2 text-slate-500 hover:bg-slate-50 transition-colors rounded-full relative">
<span class="material-symbols-outlined" data-icon="notifications">notifications</span>
<span class="absolute top-2 right-2 w-2 h-2 bg-orange-600 rounded-full border-2 border-white"></span>
</button>
<button class="p-2 text-slate-500 hover:bg-slate-50 transition-colors rounded-full">
<span class="material-symbols-outlined" data-icon="help_outline">help_outline</span>
</button>
<button class="p-2 text-slate-500 hover:bg-slate-50 transition-colors rounded-full">
<span class="material-symbols-outlined" data-icon="account_circle">account_circle</span>
</button>
</div>
</header>
<!-- Page Canvas -->
<main class="p-8 max-w-7xl">
<div class="mb-8">
<h1 class="font-h1 text-h1 text-on-background mb-2">Review Moderation</h1>
<p class="font-body-md text-on-surface-variant">Review and action flagged user submissions to maintain platform integrity.</p>
</div>
<!-- Stats Bar -->
<div class="grid grid-cols-4 gap-6 mb-8">
<div class="bg-white p-6 rounded-xl shadow-sm border border-slate-100">
<p class="font-label-md text-slate-500 uppercase tracking-wider mb-1">Pending Review</p>
<p class="font-h2 text-h2 text-orange-600">24</p>
</div>
<div class="bg-white p-6 rounded-xl shadow-sm border border-slate-100">
<p class="font-label-md text-slate-500 uppercase tracking-wider mb-1">Flagged Today</p>
<p class="font-h2 text-h2 text-on-background">12</p>
</div>
<div class="bg-white p-6 rounded-xl shadow-sm border border-slate-100">
<p class="font-label-md text-slate-500 uppercase tracking-wider mb-1">Actioned (24h)</p>
<p class="font-h2 text-h2 text-on-background">156</p>
</div>
<div class="bg-white p-6 rounded-xl shadow-sm border border-slate-100">
<p class="font-label-md text-slate-500 uppercase tracking-wider mb-1">Avg Response</p>
<p class="font-h2 text-h2 text-on-background">1.4h</p>
</div>
</div>
<!-- Moderation Feed -->
<div class="space-y-4">
<!-- Moderation Card 1 -->
<div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden hover:border-orange-200 transition-colors">
<div class="p-6">
<div class="flex items-start justify-between mb-4">
<div class="flex gap-4">
<img class="w-12 h-12 rounded-full object-cover" data-alt="Close-up portrait of a man with a friendly expression in a casual blue shirt, soft natural lighting" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDA_yY1nUE9h_yHg-z8r33myPpZlJKuTtEHxKNfeaGfuhcqoIw69E8MVVj54kwxOfzeEhe1lwOeIp5au66Cw_DwK0CI-ks90RPwO2R3j_7opOZ-iQOKlsDbombschyOTeaL893fq270_HROSj0m_AvNotoYAr9IYzG2WntpnKfi4iRo6HPpsZRfy92XBW64BPshj-W8T2N32_RW2soc01g7mdoWGbEHx_740c7giTY6rO6z25E4WAZpF9JFdR-dvLB9VTgHnLw4S5U"/>
<div>
<h3 class="font-h3 text-body-lg text-on-background">Reviewer: James Miller</h3>
<p class="text-sm text-on-surface-variant">Reviewing: <span class="font-bold text-on-surface">Precision Plumbing Ltd.</span></p>
<div class="flex items-center gap-1 mt-1">
<span class="material-symbols-outlined text-sm text-[#FBBF24] fill-icon" style="font-variation-settings: 'FILL' 1;">star</span>
<span class="material-symbols-outlined text-sm text-[#FBBF24] fill-icon" style="font-variation-settings: 'FILL' 1;">star</span>
<span class="material-symbols-outlined text-sm text-slate-200" data-icon="star">star</span>
<span class="material-symbols-outlined text-sm text-slate-200" data-icon="star">star</span>
<span class="material-symbols-outlined text-sm text-slate-200" data-icon="star">star</span>
<span class="ml-2 text-xs font-label-md text-slate-400">Oct 24, 2023</span>
</div>
</div>
</div>
<div class="flex flex-col items-end">
<span class="bg-error-container text-on-error-container px-3 py-1 rounded-full text-xs font-bold flex items-center gap-1 mb-2">
<span class="material-symbols-outlined text-sm" data-icon="report">report</span>
                                    Inappropriate Language
                                </span>
<span class="text-xs text-slate-400">Flagged by: Automated System</span>
</div>
</div>
<div class="bg-slate-50 p-4 rounded-lg border-l-4 border-orange-500 mb-6">
<p class="text-on-background italic font-body-md">
                                "The worker was absolutely terrible and a total [redacted] for showing up late. I would never hire these people again. Terrible service and honestly they are just scammers..."
                            </p>
</div>
<div class="flex items-center justify-between">
<div class="flex gap-3">
<button class="px-4 py-2 bg-primary-container text-white rounded-lg font-label-md hover:opacity-90 transition-all flex items-center gap-2">
<span class="material-symbols-outlined text-sm" data-icon="check_circle">check_circle</span>
                                    Approve Review
                                </button>
<button class="px-4 py-2 bg-white border border-error text-error rounded-lg font-label-md hover:bg-error-container transition-all flex items-center gap-2">
<span class="material-symbols-outlined text-sm" data-icon="delete_forever">delete_forever</span>
                                    Remove Review
                                </button>
</div>
<button class="px-4 py-2 text-on-surface-variant hover:bg-slate-100 rounded-lg font-label-md transition-all flex items-center gap-2">
<span class="material-symbols-outlined text-sm" data-icon="warning">warning</span>
                                Warn User
                            </button>
</div>
</div>
</div>
<!-- Moderation Card 2 -->
<div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden hover:border-orange-200 transition-colors">
<div class="p-6">
<div class="flex items-start justify-between mb-4">
<div class="flex gap-4">
<img class="w-12 h-12 rounded-full object-cover" data-alt="Close-up portrait of a young woman with a warm smile, corporate profile style with neutral background" src="https://lh3.googleusercontent.com/aida-public/AB6AXuC4RLheLyw18lYvE2_4fcUBUgrAFMuSJZ3YlQARLG6IwI_DiGXfqqTwwVeSHo7L2P5Au8OOGK5NEssYtxARKUqYPSvAQcAZB0bjEpMdIf4VS5qWh97z8mao2lGL25ZeE1RbPd3OqZ2gz59DuSKUrzKc9WaEbi0xB8xXbaA5oHqTMyM87CWFp7MN83Xxb0RQajQ0YsUsaFUGWO_8_krY7pjz0PFk0rwwb3-ghihM_EMra1thko3l1bcTs0el6ToLflAwE_dCLO3bAUw"/>
<div>
<h3 class="font-h3 text-body-lg text-on-background">Reviewer: Sarah Jenkins</h3>
<p class="text-sm text-on-surface-variant">Reviewing: <span class="font-bold text-on-surface">Elite Electricians</span></p>
<div class="flex items-center gap-1 mt-1">
<span class="material-symbols-outlined text-sm text-[#FBBF24] fill-icon" style="font-variation-settings: 'FILL' 1;">star</span>
<span class="material-symbols-outlined text-sm text-[#FBBF24] fill-icon" style="font-variation-settings: 'FILL' 1;">star</span>
<span class="material-symbols-outlined text-sm text-[#FBBF24] fill-icon" style="font-variation-settings: 'FILL' 1;">star</span>
<span class="material-symbols-outlined text-sm text-[#FBBF24] fill-icon" style="font-variation-settings: 'FILL' 1;">star</span>
<span class="material-symbols-outlined text-sm text-[#FBBF24] fill-icon" style="font-variation-settings: 'FILL' 1;">star</span>
<span class="ml-2 text-xs font-label-md text-slate-400">Oct 23, 2023</span>
</div>
</div>
</div>
<div class="flex flex-col items-end">
<span class="bg-amber-100 text-amber-800 px-3 py-1 rounded-full text-xs font-bold flex items-center gap-1 mb-2">
<span class="material-symbols-outlined text-sm" data-icon="link">link</span>
                                    Potential Spam (Link)
                                </span>
<span class="text-xs text-slate-400">Flagged by: User (Manual)</span>
</div>
</div>
<div class="bg-slate-50 p-4 rounded-lg border-l-4 border-amber-500 mb-6">
<p class="text-on-background font-body-md">
                                "Great job by the team. If you want a discount on your next service use this link: http://trade-referral-scam.net/free-credits. Highly recommend them for the price!"
                            </p>
</div>
<div class="flex items-center justify-between">
<div class="flex gap-3">
<button class="px-4 py-2 bg-primary-container text-white rounded-lg font-label-md hover:opacity-90 transition-all flex items-center gap-2">
<span class="material-symbols-outlined text-sm" data-icon="check_circle">check_circle</span>
                                    Approve Review
                                </button>
<button class="px-4 py-2 bg-white border border-error text-error rounded-lg font-label-md hover:bg-error-container transition-all flex items-center gap-2">
<span class="material-symbols-outlined text-sm" data-icon="delete_forever">delete_forever</span>
                                    Remove Review
                                </button>
</div>
<button class="px-4 py-2 text-on-surface-variant hover:bg-slate-100 rounded-lg font-label-md transition-all flex items-center gap-2">
<span class="material-symbols-outlined text-sm" data-icon="warning">warning</span>
                                Warn User
                            </button>
</div>
</div>
</div>
<!-- Moderation Card 3 -->
<div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden hover:border-orange-200 transition-colors">
<div class="p-6">
<div class="flex items-start justify-between mb-4">
<div class="flex gap-4">
<img class="w-12 h-12 rounded-full object-cover" data-alt="Close-up headshot of a young adult with glasses and a thoughtful expression, bright indoor lighting" src="https://lh3.googleusercontent.com/aida-public/AB6AXuB8CCEpQWTC90NO7R2ZAbhHCEIDyv_RfXIgucMIN39E7SrKWgDILVXjOZ0QybP_aboQHzfyZB0jTx2d4Iyt1c3sCTdCsSQG-LyCFiKy-2JBVz74ApJVEZJFlyl7zVKfe7Zac-8EWTuWeXa640PiHHotysMIteK6HHvFUukGefe_cM4jtpH98MvRHOKti6M2FuAt37Md0Z4R8geYkRcqK9KDlGX5izwZDc3jrSn_VVWmorOf1JfhTvYqi6CE0o06DzLMO_TI6Xwsdp4"/>
<div>
<h3 class="font-h3 text-body-lg text-on-background">Reviewer: Michael Chen</h3>
<p class="text-sm text-on-surface-variant">Reviewing: <span class="font-bold text-on-surface">Swift Roofing</span></p>
<div class="flex items-center gap-1 mt-1">
<span class="material-symbols-outlined text-sm text-[#FBBF24] fill-icon" style="font-variation-settings: 'FILL' 1;">star</span>
<span class="material-symbols-outlined text-sm text-slate-200" data-icon="star">star</span>
<span class="material-symbols-outlined text-sm text-slate-200" data-icon="star">star</span>
<span class="material-symbols-outlined text-sm text-slate-200" data-icon="star">star</span>
<span class="material-symbols-outlined text-sm text-slate-200" data-icon="star">star</span>
<span class="ml-2 text-xs font-label-md text-slate-400">Oct 22, 2023</span>
</div>
</div>
</div>
<div class="flex flex-col items-end">
<span class="bg-error-container text-on-error-container px-3 py-1 rounded-full text-xs font-bold flex items-center gap-1 mb-2">
<span class="material-symbols-outlined text-sm" data-icon="policy">policy</span>
                                    Harassment
                                </span>
<span class="text-xs text-slate-400">Flagged by: Worker (Appeal)</span>
</div>
</div>
<div class="bg-slate-50 p-4 rounded-lg border-l-4 border-error mb-6">
<p class="text-on-background font-body-md">
                                "The roofer Mike is a joke. I found his personal Facebook and he's just as lazy at home as he is at work. Mike, if you see this, I'm coming to your office to get my money back in person..."
                            </p>
</div>
<div class="flex items-center justify-between">
<div class="flex gap-3">
<button class="px-4 py-2 bg-primary-container text-white rounded-lg font-label-md hover:opacity-90 transition-all flex items-center gap-2">
<span class="material-symbols-outlined text-sm" data-icon="check_circle">check_circle</span>
                                    Approve Review
                                </button>
<button class="px-4 py-2 bg-white border border-error text-error rounded-lg font-label-md hover:bg-error-container transition-all flex items-center gap-2">
<span class="material-symbols-outlined text-sm" data-icon="delete_forever">delete_forever</span>
                                    Remove Review
                                </button>
</div>
<button class="px-4 py-2 text-on-surface-variant hover:bg-slate-100 rounded-lg font-label-md transition-all flex items-center gap-2">
<span class="material-symbols-outlined text-sm" data-icon="warning">warning</span>
                                Warn User
                            </button>
</div>
</div>
</div>
</div>
<!-- Pagination/Footer -->
<div class="mt-8 flex items-center justify-between py-4 border-t border-slate-200">
<p class="text-sm text-slate-500">Showing 1 to 3 of 24 flagged reviews</p>
<div class="flex gap-2">
<button class="px-4 py-2 border border-slate-200 rounded-lg text-sm hover:bg-slate-50 disabled:opacity-50">Previous</button>
<button class="px-4 py-2 border border-slate-200 rounded-lg text-sm bg-orange-600 text-white">1</button>
<button class="px-4 py-2 border border-slate-200 rounded-lg text-sm hover:bg-slate-50">2</button>
<button class="px-4 py-2 border border-slate-200 rounded-lg text-sm hover:bg-slate-50">3</button>
<button class="px-4 py-2 border border-slate-200 rounded-lg text-sm hover:bg-slate-50">Next</button>
</div>
</div>
</main>
</div>
</body></html>