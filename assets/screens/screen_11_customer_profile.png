<!DOCTYPE html>

<html class="light" lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>Customer Profile - TradeFind</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;800;900&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "surface-bright": "#f9f9ff",
                        "surface": "#f9f9ff",
                        "on-secondary": "#ffffff",
                        "on-tertiary-fixed-variant": "#5c4300",
                        "on-secondary-container": "#5d1900",
                        "on-background": "#141b2b",
                        "on-primary-fixed-variant": "#783200",
                        "tertiary-container": "#c49200",
                        "on-error": "#ffffff",
                        "background": "#f9f9ff",
                        "surface-container": "#e9edff",
                        "on-tertiary-fixed": "#261a00",
                        "on-surface-variant": "#584237",
                        "primary-fixed-dim": "#ffb690",
                        "secondary": "#ac3400",
                        "secondary-fixed-dim": "#ffb59d",
                        "surface-container-highest": "#dce2f7",
                        "on-error-container": "#93000a",
                        "on-tertiary-container": "#422f00",
                        "surface-tint": "#9d4300",
                        "on-primary-container": "#582200",
                        "outline-variant": "#e0c0b1",
                        "secondary-fixed": "#ffdbd0",
                        "primary-container": "#f97316",
                        "surface-container-low": "#f1f3ff",
                        "primary-fixed": "#ffdbca",
                        "on-secondary-fixed": "#390c00",
                        "tertiary-fixed": "#ffdf9f",
                        "inverse-on-surface": "#edf0ff",
                        "on-surface": "#141b2b",
                        "outline": "#8c7164",
                        "on-secondary-fixed-variant": "#832600",
                        "surface-container-lowest": "#ffffff",
                        "surface-variant": "#dce2f7",
                        "primary": "#9d4300",
                        "surface-container-high": "#e1e8fd",
                        "on-tertiary": "#ffffff",
                        "secondary-container": "#fd6b36",
                        "tertiary": "#795900",
                        "error-container": "#ffdad6",
                        "on-primary-fixed": "#341100",
                        "tertiary-fixed-dim": "#f9bd22",
                        "error": "#ba1a1a",
                        "inverse-primary": "#ffb690",
                        "on-primary": "#ffffff",
                        "surface-dim": "#d3daef",
                        "inverse-surface": "#293040"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    "spacing": {
                        "sm": "12px",
                        "gutter": "12px",
                        "lg": "24px",
                        "xs": "8px",
                        "md": "16px",
                        "base": "4px",
                        "xl": "32px",
                        "margin": "16px"
                    },
                    "fontFamily": {
                        "h2": ["Inter"],
                        "label-md": ["Inter"],
                        "body-md": ["Inter"],
                        "h1": ["Inter"],
                        "h3": ["Inter"],
                        "body-lg": ["Inter"]
                    },
                    "fontSize": {
                        "h2": ["24px", {"lineHeight": "30px", "letterSpacing": "-0.01em", "fontWeight": "700"}],
                        "label-md": ["12px", {"lineHeight": "16px", "letterSpacing": "0.02em", "fontWeight": "500"}],
                        "body-md": ["14px", {"lineHeight": "20px", "fontWeight": "400"}],
                        "h1": ["28px", {"lineHeight": "34px", "letterSpacing": "-0.02em", "fontWeight": "700"}],
                        "h3": ["20px", {"lineHeight": "26px", "letterSpacing": "0em", "fontWeight": "700"}],
                        "body-lg": ["16px", {"lineHeight": "24px", "fontWeight": "400"}]
                    }
                },
            },
        }
    </script>
<style>
        body { font-family: 'Inter', sans-serif; }
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        .pb-safe { padding-bottom: env(safe-area-inset-bottom); }
    </style>
<style>
    body {
      min-height: max(884px, 100dvh);
    }
  </style>
  </head>
<body class="bg-surface-bright text-on-surface min-h-screen pb-24">
<!-- TopAppBar -->
<header class="sticky top-0 z-50 flex justify-between items-center w-full px-4 h-16 bg-[#F9FAFB] dark:bg-slate-950 border-b border-slate-200 dark:border-slate-800 font-['Inter'] antialiased tracking-tight">
<div class="flex items-center gap-4">
<span class="material-symbols-outlined text-on-surface cursor-pointer p-2 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors rounded-full" data-icon="menu">menu</span>
<h1 class="text-2xl font-black text-orange-600 dark:text-orange-500">TradeFind</h1>
</div>
<div class="flex items-center">
<img alt="Sarah Mitchell" class="w-10 h-10 rounded-full border-2 border-primary-container" data-alt="close-up portrait of a professional woman with a friendly smile, soft natural lighting, high resolution photography" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBtwA6chmuSk9Dxn16yVAP0HaXf5vE_uZFZTfr2L9reFXphV2IbLKqtkS0XnlfOSb5dU70c5U39e8hb6S8Fp0mdVRusSJKJFa2Yu6g1TKf0sjdE0KFHWHWe9pZC_vyymd_2aPgbhu4ffZhzONTLnBdXNPeoseitZDV9mmjzi0q4XK_YRUmFc4TXjCCjE96Sr0cvGQi-B2WDnwpl4j3VxuUE7zdA2KhzSotZyhU3cAX5_L4nuFHcIfUZIPuQYymtxf_gHGzpRriwj5E"/>
</div>
</header>
<main class="max-w-md mx-auto px-margin py-lg space-y-lg">
<!-- Profile Header Section -->
<section class="flex flex-col items-center text-center space-y-md">
<div class="relative">
<img alt="Sarah Mitchell" class="w-32 h-32 rounded-full border-4 border-surface-container-lowest shadow-lg" data-alt="Portrait of Sarah Mitchell, a professional client, against a clean modern background with soft daylight" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAa-3zCjWN6WOa6O467LtvcfqY4btKqvYPbVJXbXgToJYaxhaq6x0lRKwk_im-xgFSHbPqwMFBPi_WW0RkFWna7MqpkSECRrl0Cg4plPkPzkkywzk_znGJMHR7Z33FbDnzDSLQOrk4bKTqA3yWUoYWHNKMTtTZ2EtYzML6_9xMBVk1xQ2Hi611vc_BQBiiTfbkoYE3L0TA_JJrDmkMtjjPaim7UMkA7MtHFsAsOMZYveVvWAO9EiNpoe7ch_7C3SlYGLFchLZq1H2U"/>
<button class="absolute bottom-1 right-1 bg-primary-container text-white p-2 rounded-full shadow-md active:scale-95 duration-150">
<span class="material-symbols-outlined text-[18px]" data-icon="edit">edit</span>
</button>
</div>
<div>
<h2 class="font-h1 text-h1 text-on-surface">Sarah Mitchell</h2>
<div class="flex flex-col text-on-surface-variant font-body-md text-body-md mt-1">
<span>sarah.mitchell@example.com</span>
<span>+1 (555) 012-3456</span>
</div>
</div>
</section>
<!-- Stats Row - Bento Style -->
<section class="grid grid-cols-3 gap-sm">
<div class="bg-surface-container-lowest p-md rounded-xl shadow-[0_2px_8px_rgba(0,0,0,0.08)] flex flex-col items-center justify-center text-center border border-surface-container">
<span class="font-h2 text-h2 text-primary">12</span>
<span class="font-label-md text-label-md text-on-surface-variant">Jobs Done</span>
</div>
<div class="bg-surface-container-lowest p-md rounded-xl shadow-[0_2px_8px_rgba(0,0,0,0.08)] flex flex-col items-center justify-center text-center border border-surface-container">
<span class="font-h2 text-h2 text-primary">8</span>
<span class="font-label-md text-label-md text-on-surface-variant">Reviews</span>
</div>
<div class="bg-surface-container-lowest p-md rounded-xl shadow-[0_2px_8px_rgba(0,0,0,0.08)] flex flex-col items-center justify-center text-center border border-surface-container">
<span class="font-h2 text-h2 text-primary">5</span>
<span class="font-label-md text-label-md text-on-surface-variant">Saved</span>
</div>
</section>
<!-- Settings & Menu Section -->
<section class="space-y-sm">
<h3 class="font-h3 text-h3 text-on-surface px-1">Account Settings</h3>
<div class="bg-surface-container-lowest rounded-xl shadow-[0_2px_8px_rgba(0,0,0,0.08)] overflow-hidden border border-surface-container">
<!-- Location Toggle -->
<div class="flex items-center justify-between p-md border-b border-surface-container-low">
<div class="flex items-center gap-md">
<div class="w-10 h-10 rounded-lg bg-orange-50 flex items-center justify-center text-orange-600">
<span class="material-symbols-outlined" data-icon="location_on">location_on</span>
</div>
<span class="font-body-lg text-body-lg text-on-surface">Location sharing</span>
</div>
<label class="relative inline-flex items-center cursor-pointer">
<input checked="" class="sr-only peer" type="checkbox" value=""/>
<div class="w-11 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary-container"></div>
</label>
</div>
<!-- Menu Items -->
<button class="w-full flex items-center justify-between p-md border-b border-surface-container-low hover:bg-slate-50 transition-colors active:scale-[0.98]">
<div class="flex items-center gap-md">
<div class="w-10 h-10 rounded-lg bg-slate-50 flex items-center justify-center text-on-surface-variant">
<span class="material-symbols-outlined" data-icon="person_edit">person_edit</span>
</div>
<span class="font-body-lg text-body-lg text-on-surface">Edit Profile</span>
</div>
<span class="material-symbols-outlined text-slate-400" data-icon="chevron_right">chevron_right</span>
</button>
<button class="w-full flex items-center justify-between p-md border-b border-surface-container-low hover:bg-slate-50 transition-colors active:scale-[0.98]">
<div class="flex items-center gap-md">
<div class="w-10 h-10 rounded-lg bg-slate-50 flex items-center justify-center text-on-surface-variant">
<span class="material-symbols-outlined" data-icon="rate_review">rate_review</span>
</div>
<span class="font-body-lg text-body-lg text-on-surface">My Reviews</span>
</div>
<span class="material-symbols-outlined text-slate-400" data-icon="chevron_right">chevron_right</span>
</button>
<button class="w-full flex items-center justify-between p-md border-b border-surface-container-low hover:bg-slate-50 transition-colors active:scale-[0.98]">
<div class="flex items-center gap-md">
<div class="w-10 h-10 rounded-lg bg-slate-50 flex items-center justify-center text-on-surface-variant">
<span class="material-symbols-outlined" data-icon="notifications">notifications</span>
</div>
<span class="font-body-lg text-body-lg text-on-surface">Notifications</span>
</div>
<span class="material-symbols-outlined text-slate-400" data-icon="chevron_right">chevron_right</span>
</button>
<button class="w-full flex items-center justify-between p-md border-b border-surface-container-low hover:bg-slate-50 transition-colors active:scale-[0.98]">
<div class="flex items-center gap-md">
<div class="w-10 h-10 rounded-lg bg-slate-50 flex items-center justify-center text-on-surface-variant">
<span class="material-symbols-outlined" data-icon="help">help</span>
</div>
<span class="font-body-lg text-body-lg text-on-surface">Help &amp; Support</span>
</div>
<span class="material-symbols-outlined text-slate-400" data-icon="chevron_right">chevron_right</span>
</button>
<button class="w-full flex items-center justify-between p-md hover:bg-red-50 transition-colors active:scale-[0.98]">
<div class="flex items-center gap-md">
<div class="w-10 h-10 rounded-lg bg-red-50 flex items-center justify-center text-error">
<span class="material-symbols-outlined" data-icon="logout">logout</span>
</div>
<span class="font-body-lg text-body-lg text-error">Log Out</span>
</div>
</button>
</div>
</section>
<!-- Version Info -->
<footer class="text-center pb-xl">
<p class="font-label-md text-label-md text-slate-400">TradeFind v2.4.1</p>
</footer>
</main>
<!-- BottomNavBar -->
<nav class="fixed bottom-0 left-0 w-full z-50 flex justify-around items-center h-16 bg-white dark:bg-slate-900 px-2 pb-safe border-t border-slate-100 dark:border-slate-800 shadow-[0_-2px_8px_rgba(0,0,0,0.08)]">
<button class="flex flex-col items-center justify-center text-slate-400 dark:text-slate-500 hover:text-orange-500 dark:hover:text-orange-400 tap-highlight-transparent transition-transform active:scale-90">
<span class="material-symbols-outlined" data-icon="home">home</span>
<span class="font-['Inter'] text-[12px] font-medium">Home</span>
</button>
<button class="flex flex-col items-center justify-center text-slate-400 dark:text-slate-500 hover:text-orange-500 dark:hover:text-orange-400 tap-highlight-transparent transition-transform active:scale-90">
<span class="material-symbols-outlined" data-icon="map">map</span>
<span class="font-['Inter'] text-[12px] font-medium">Map</span>
</button>
<button class="flex flex-col items-center justify-center text-slate-400 dark:text-slate-500 hover:text-orange-500 dark:hover:text-orange-400 tap-highlight-transparent transition-transform active:scale-90">
<span class="material-symbols-outlined" data-icon="bookmark">bookmark</span>
<span class="font-['Inter'] text-[12px] font-medium">Bookmarks</span>
</button>
<button class="flex flex-col items-center justify-center text-orange-600 dark:text-orange-500 bg-orange-50/50 dark:bg-orange-900/20 rounded-xl px-3 py-1 tap-highlight-transparent transition-transform active:scale-90">
<span class="material-symbols-outlined" data-icon="person" data-weight="fill" style="font-variation-settings: 'FILL' 1;">person</span>
<span class="font-['Inter'] text-[12px] font-medium">Profile</span>
</button>
</nav>
</body></html>